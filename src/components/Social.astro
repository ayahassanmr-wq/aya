---
/* Social icons: Instagram, Facebook, WhatsApp, LinkedIn, Email. Icon-only, each with an accessible name.
   WhatsApp opens a chat without printing the number. */
import { contact } from '../data/projects';
interface Props { size?: 'm' | 'l'; class?: string }
const { size = 'm', class: cls } = Astro.props;
const items = [
  { href: contact.instagram, label: 'Instagram', ext: true, d: '<rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r=".9" fill="currentColor" stroke="none"/>' },
  { href: contact.facebook, label: 'Facebook', ext: true, d: '<path d="M14.5 21v-7.5h2.6l.4-3h-3V8.6c0-.9.3-1.5 1.6-1.5h1.6V4.4c-.3 0-1.2-.1-2.3-.1-2.3 0-3.9 1.4-3.9 4v2.2H8.9v3h2.6V21"/>' },
  { href: contact.whatsapp, label: 'WhatsApp', ext: true, d: '<path d="M4 20l1.2-4.2A8.3 8.3 0 1 1 8.4 19z"/><path d="M9.2 8.4c.2-.4.4-.4.7-.4h.5c.2 0 .4 0 .5.4l.7 1.6c.1.2 0 .4-.1.6l-.5.6c.6 1.1 1.5 2 2.7 2.6l.6-.6c.2-.2.4-.2.6-.1l1.5.7c.3.1.4.3.3.6-.1.9-.9 1.6-1.8 1.6-2.9-.2-5.8-3-6-5.9 0-.6.2-1.3.3-1.7z" fill="currentColor" stroke="none"/>' },
  { href: contact.linkedin, label: 'LinkedIn', ext: true, d: '<rect x="3.5" y="3.5" width="17" height="17" rx="3"/><path d="M8 10.5V16M8 7.6v.1M11.5 16v-5.5M11.5 13c0-1.6 1-2.6 2.3-2.6s2.2.8 2.2 2.6V16"/>' },
  { href: `mailto:${contact.email}`, label: 'Email', ext: false, d: '<rect x="3.5" y="5.5" width="17" height="13" rx="3"/><path d="M4.5 7.5l7.5 5.5 7.5-5.5"/>' },
];
---
<ul class:list={['social', size, cls]} aria-label="Social and contact links">
  {items.map((i) => (
    <li><a href={i.href} aria-label={i.ext ? `${i.label} (opens in a new tab)` : `${i.label} Aya`} title={i.label} target={i.ext ? '_blank' : undefined} rel={i.ext ? 'noopener' : undefined} data-cursor={i.label}>
      <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" set:html={i.d} />
    </a></li>
  ))}
</ul>

<style>
  .social { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px; }
  a { position: relative; display: grid; place-items: center; width: 48px; height: 48px; border-radius: 50%; border: 1px solid currentColor; border-color: color-mix(in srgb, currentColor 28%, transparent); color: inherit; isolation: isolate; overflow: hidden; transition: color .4s var(--ease), border-color .4s, transform .5s var(--ease); }
  a::before { content: ""; position: absolute; inset: 0; z-index: -1; border-radius: inherit; background: currentColor; transform: scale(0); transition: transform .5s var(--ease); }
  .l a { width: 58px; height: 58px; }
  svg { width: 20px; height: 20px; transition: transform .5s var(--ease); }
  .l svg { width: 23px; height: 23px; }
  a:hover, a:focus-visible { border-color: transparent; transform: translateY(-3px); }
  a:hover::before, a:focus-visible::before { transform: scale(1); background: var(--ox); }
  a:hover svg, a:focus-visible svg { color: var(--ow); transform: rotate(-8deg) scale(1.08); }
</style>
