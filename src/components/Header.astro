---
/* Floating glass bar: AYA mark · indexed nav · Riyadh time · "Let's talk". Full-screen menu on mobile. */
interface Props { overHero?: boolean }
const { overHero = false } = Astro.props;
const path = Astro.url.pathname;
import Social from './Social.astro';
import { i18n } from '../i18n';
const L = i18n(Astro.url);
const links = [
  { href: L.u('/work/'), label: L.t('Work', 'الأعمال') },
  { href: L.u('/about/'), label: L.t('About', 'عنّي') },
  { href: L.u('/services/'), label: L.t('Services', 'الخدمات') },
  { href: L.u('/contact/'), label: L.t('Contact', 'تواصل') },
];
---
<header class:list={['site', { over: overHero }]} data-header>
  <div class="bar glass-dark">
    <a href={L.u('/')} class="logo" aria-label={L.t('Aya Hassan, home', 'آية حسن، الرئيسية')} data-cursor={L.t('Home', 'الرئيسية')}>
      <img src="/brand/aya.svg" alt="" width="88" height="42" />
    </a>
    <nav aria-label={L.t('Main', 'القائمة الرئيسية')} class="main-nav">
      <ul>
        {links.map((l, i) => (
          <li><a href={l.href} aria-current={path.startsWith(l.href) ? 'page' : undefined}><span class="roll"><span>{l.label}</span><span aria-hidden="true">{l.label}</span></span></a></li>
        ))}
      </ul>
    </nav>
    <div class="right">
      <a href={L.other} class="lang label" hreflang={L.ar ? 'en' : 'ar'} lang={L.ar ? 'en' : 'ar'} aria-label={L.t('اقرأ بالعربية', 'Read in English')}>{L.ar ? 'EN' : 'ع'}</a>
      <a href={L.u('/contact/')} class="talk label">{L.t('Let’s talk', 'لنتحدث')} <span class="arr" aria-hidden="true">{L.next}</span></a>
      <button class="menu label" aria-expanded="false" aria-controls="mnav" data-menu data-open={L.t('Menu', 'القائمة')} data-close={L.t('Close', 'إغلاق')}><span class="mt">{L.t('Menu', 'القائمة')}</span><span class="lines" aria-hidden="true"><i></i><i></i></span></button>
    </div>
  </div>
</header>
<div class="mnav" id="mnav" hidden>
  <nav aria-label={L.t('Mobile', 'القائمة')} class="wrap"><ul>{links.map((l, i) => <li><a href={l.href} aria-current={path.startsWith(l.href) ? 'page' : undefined}>{l.label}<span class="arr" aria-hidden="true">{L.next}</span></a></li>)}<li><a href={L.other} lang={L.ar ? 'en' : 'ar'}>{L.ar ? 'English' : 'العربية'}<span class="arr" aria-hidden="true">{L.next}</span></a></li></ul></nav>
  <div class="wrap foot"><Social /></div>
</div>

<script>
  const h = document.querySelector<HTMLElement>('[data-header]')!;
  const btn = document.querySelector<HTMLButtonElement>('[data-menu]')!;
  const m = document.getElementById('mnav')!;
  const set = (open: boolean) => {
    btn.setAttribute('aria-expanded', String(open)); m.hidden = !open; h.classList.toggle('open', open); h.classList.remove('tuck');
    btn.querySelector('.mt')!.textContent = (open ? btn.dataset.close : btn.dataset.open) ?? '';
    document.body.style.overflow = open ? 'hidden' : '';
    const l = (window as any).__lenis; open ? l?.stop() : l?.start();
    if (open) m.querySelector('a')?.focus();
  };
  btn.addEventListener('click', () => set(btn.getAttribute('aria-expanded') !== 'true'));
  addEventListener('keydown', (e) => { if (e.key === 'Escape' && !m.hidden) { set(false); btn.focus(); } });
  m.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => set(false)));
  matchMedia('(min-width: 901px)').addEventListener('change', (e) => e.matches && set(false));
  let last = scrollY; const noTuck = !!document.querySelector('[data-sticky-bar]');
  addEventListener('scroll', () => { const y = scrollY; h.classList.toggle('scrolled', y > 40); h.classList.toggle('tuck', !noTuck && y > 400 && y > last && !h.classList.contains('open')); last = y; }, { passive: true });
</script>

<style>
  .site { position: fixed; z-index: 20; left: 0; right: 0; top: 0; padding: calc(12px + env(safe-area-inset-top, 0px)) max(var(--gut), env(safe-area-inset-right, 0px)) 0 max(var(--gut), env(safe-area-inset-left, 0px)); pointer-events: none; transition: transform .9s var(--ease-io); }
  .site.tuck { transform: translateY(calc(-100% - 12px)); }
  .bar { pointer-events: auto; max-width: calc(var(--max) - var(--gut) * 2); margin: 0 auto; display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 24px; height: 60px; padding: 0 8px 0 22px; border-radius: var(--r-3); transition: background .5s; animation: drop .9s .2s var(--ease) both; }
  @keyframes drop { from { opacity: 0; transform: translateY(-20px); } }
  .scrolled .bar { background: rgba(32, 28, 27, .78); }
  .logo { display: block; padding: 6px 0; }
  .logo img { height: 28px; width: auto; transition: transform .5s var(--ease); }
  .logo:hover img { transform: scale(1.06) rotate(-2deg); }
  ul { list-style: none; margin: 0; padding: 0; }
  .main-nav ul { display: flex; justify-content: center; gap: clamp(18px, 3vw, 48px); }
  .main-nav a { display: flex; align-items: center; gap: 6px; color: rgba(243, 237, 227, .82); font: 400 12.5px var(--sans); letter-spacing: .18em; text-transform: uppercase; padding-block: 12px; }
  .main-nav sup { font-size: 9.5px; letter-spacing: 0; color: var(--muted-dark); transition: color .3s; align-self: flex-start; margin-top: 2px; }
  /* text roll: the label slides up and a off-white copy rolls in from below */
  .roll { position: relative; display: inline-grid; overflow: hidden; height: 1.3em; line-height: 1.3em; }
  .roll > span { grid-area: 1 / 1; transition: transform .55s var(--ease); }
  .roll > span:last-child { transform: translateY(100%); color: var(--sand); }
  .main-nav a:hover .roll > span:first-child, .main-nav a:focus-visible .roll > span:first-child { transform: translateY(-100%); }
  .main-nav a:hover .roll > span:last-child, .main-nav a:focus-visible .roll > span:last-child { transform: none; }
  .main-nav a:hover sup, .main-nav a[aria-current] sup { color: var(--sand); }
  .main-nav a[aria-current] .roll > span:first-child { color: var(--sand); }
  .right { display: flex; align-items: center; gap: 6px; }
  .clock { display: inline-flex; align-items: center; gap: 8px; color: var(--muted-dark); padding-inline: 12px; font-variant-numeric: tabular-nums; }
  .clock time { color: var(--ow); }
  .live { width: 6px; height: 6px; border-radius: 50%; background: #9BC59A; animation: pulse 2.4s infinite; }
  @keyframes pulse { 0% { box-shadow: 0 0 0 0 rgba(155, 197, 154, .6); } 70%, 100% { box-shadow: 0 0 0 7px rgba(155, 197, 154, 0); } }
  .talk { position: relative; overflow: hidden; isolation: isolate; display: inline-flex; align-items: center; gap: 10px; height: 44px; padding: 0 20px; border-radius: var(--r-btn); background: var(--ow); color: var(--ink); transition: color .45s var(--ease); }
  .talk::before { content: ""; position: absolute; inset: 0; z-index: -1; background: var(--ox); transform: translateY(101%); transition: transform .5s var(--ease-io); }
  .talk:hover { color: var(--ow); } .talk:hover::before { transform: none; }
  .menu { display: none; align-items: center; gap: 12px; height: 44px; padding: 0 14px; border-radius: var(--r-btn); background: none; border: 0; color: var(--ow); cursor: pointer; }
  .menu .lines { position: relative; width: 22px; height: 10px; }
  .menu .lines i { position: absolute; left: 0; right: 0; height: 1.5px; background: currentColor; transition: transform .45s var(--ease), top .45s var(--ease); }
  .menu .lines i:first-child { top: 0; } .menu .lines i:last-child { top: 8px; }
  .menu[aria-expanded="true"] .lines i:first-child { top: 4px; transform: rotate(45deg); }
  .menu[aria-expanded="true"] .lines i:last-child { top: 4px; transform: rotate(-45deg); }
  .mnav { position: fixed; inset: 0; z-index: 19; background: rgba(32, 28, 27, .97); -webkit-backdrop-filter: blur(24px); backdrop-filter: blur(24px); color: var(--ow); padding-top: calc(100px + env(safe-area-inset-top, 0px)); padding-bottom: calc(32px + env(safe-area-inset-bottom, 0px)); overflow-y: auto; overscroll-behavior: contain; display: flex; flex-direction: column; justify-content: space-between; }
  .mnav nav ul { display: block; }
  .mnav li { border-bottom: 1px solid var(--rule-light); opacity: 0; transform: translateY(16px); animation: in .7s var(--ease) forwards; }
  .mnav li:nth-child(2) { animation-delay: .06s; } .mnav li:nth-child(3) { animation-delay: .12s; } .mnav li:nth-child(4) { animation-delay: .18s; }
  @keyframes in { to { opacity: 1; transform: none; } }
  .mnav ul a { display: flex; align-items: baseline; gap: 18px; padding-block: 18px; font: 800 clamp(38px, 11vw, 60px)/1 var(--display); }
  .mnav ul a .arr { margin-left: auto; font: 300 22px var(--sans); color: var(--muted-dark); }
  .mnav ul a[aria-current] { color: var(--sand); font-style: italic; }
  .mnav .label { color: var(--muted-dark); }
  .mnav .foot { display: grid; gap: 6px; opacity: 0; animation: in .7s .3s var(--ease) forwards; }
  .mnav .foot a, .mnav .foot time { color: var(--ow); font-size: 15px; }
  @media (min-width: 901px) { .mnav { display: none !important; } }
  @media (max-width: 1100px) { .clock { display: none; } }
  @media (max-width: 900px) { .main-nav, .talk { display: none; } .menu { display: inline-flex; } .bar { height: 56px; padding-left: 18px; } .right { grid-column: 3; } }
</style>
