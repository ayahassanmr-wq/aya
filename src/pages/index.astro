---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects, featured, countries, imagesFor, cover } from '../data/projects';
import { getImage } from 'astro:assets';
import gold from '../assets/gold.jpg';
const slideSlugs = ['commercial-mall', 'stc-hq', 'neom-oxagon', 'fifth-square'];
const slides = await Promise.all(slideSlugs.map(async (slug) => {
  const p = projects.find((x) => x.slug === slug)!;
  const img = imagesFor(slug)[0];
  const later = await Promise.all([480, 720, 960, 1400, 2000].map(async (w) => { const r = await getImage({ src: img, width: w, format: 'webp', quality: 66 }); return `${r.src} ${w}w`; }));
  return { p, img, srcset: later.join(', '), thumb: (await getImage({ src: img, width: 240, format: 'webp' })).src };
}));
const place = (p: typeof projects[number]) => `${p.location}${p.country !== p.location && p.country !== '—' ? `, ${p.country}` : ''}`;
const [f1, f2, f3, f4, f5, f6] = featured;
const names = ['NEOM', 'SABIC', 'stc', 'Jotun', 'H.B. Fuller', 'Chery', 'Noatum', 'Tech Park', 'Fifth Square', 'Linah Farms'];
const years = new Date().getFullYear() - 2020;
const services = [
  { t: 'Concept design', slug: 'neom-oxagon' },
  { t: 'Visualization & animation', slug: 'fifth-square' },
  { t: 'BIM & design packages', slug: 'noatum-terminal' },
  { t: 'Materials & FF&E', slug: 'stc-hq' },
];
const previews = await Promise.all(services.map(async (s) => (await getImage({ src: cover(s.slug), width: 700, format: 'webp' })).src));
---
<Base overHero intro preloadImage={{ srcset: slides[0].srcset, sizes: '100vw' }}>
  <section class="hero" data-hero aria-label="Introduction" data-slides={JSON.stringify(slides.map((x) => ({ href: `/work/${x.p.slug}/`, title: x.p.title, place: place(x.p), thumb: x.thumb })))}>
    <div class="slides">
      {slides.map((x, i) => (
        <div class:list={['slide', { on: i === 0 }]} aria-hidden={i === 0 ? undefined : 'true'}>
          <div class="para"><div class="pl" data-parallax="0.14" data-scale="1">
            {i === 0
              ? <img alt={`${x.p.title}, ${place(x.p)}`} class="kb" srcset={x.srcset} sizes="100vw" src={x.srcset.split(' ')[0]} width={x.img.width} height={x.img.height} fetchpriority="high" decoding="async" />
              : <img alt="" class="kb" data-srcset={x.srcset} sizes="100vw" width={x.img.width} height={x.img.height} decoding="async" />}
          </div></div>
        </div>
      ))}
    </div>
    <div class="veil"></div>
    <div class="wrap inner">
      <div class="top label">
        <span class="kicker"><span class="dotl"></span>Aya Hassan</span>
        <span class="kicker r">Architect &amp; Interior Designer<br />Concept Design · Riyadh</span>
      </div>
      <h1 class="hl">
        <span class="ln"><span>From concept</span></span>
        <span class="ln"><span>to <em class="foil" style={`--gold:url(${gold.src})`}>conviction.</em></span></span>
      </h1>
      <div class="bottom">
        <div class="ctas">
          <a href="/work/" class="btn solid">View the work <span class="arr">→</span></a>
          <a href="/about/" class="btn ghost glass-dark">About Aya</a>
        </div>
        <div class="ctrl" role="group" aria-label="Featured projects">
          <span class="label idx"><b data-cur>01</b> / {String(slides.length).padStart(2, '0')}</span>
          <div class="bars">{slides.map((x, i) => <button type="button" class:list={['bb', { on: i === 0 }]} data-go={i} aria-label={`Show ${x.p.title}`}><i></i></button>)}</div>
        </div>
        <a class="chip glass-dark" href={`/work/${slides[0].p.slug}/`} data-chip data-cursor="View">
          <img src={slides[0].thumb} alt="" width="120" height="90" data-chip-img />
          <span class="ct"><span class="label">Now showing</span><strong data-chip-title>{slides[0].p.title}</strong><span class="label pl2" data-chip-place>{place(slides[0].p)}</span></span>
          <span class="arr" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <script>
    const hero = document.querySelector<HTMLElement>('[data-hero]');
    if (hero) {
      const data = JSON.parse(hero.dataset.slides!);
      const sl = [...hero.querySelectorAll<HTMLElement>('.slide')];
      const bb = [...hero.querySelectorAll<HTMLElement>('.bb')];
      const chip = hero.querySelector<HTMLAnchorElement>('[data-chip]')!;
      const cur = hero.querySelector<HTMLElement>('[data-cur]')!;
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const loadRest = () => hero.querySelectorAll<HTMLImageElement>('img[data-srcset]').forEach((im) => { im.srcset = im.dataset.srcset!; im.removeAttribute('data-srcset'); });
      if (document.readyState === 'complete') setTimeout(loadRest, 1200); else addEventListener('load', () => setTimeout(loadRest, 1200), { once: true });
      let i = 0, timer = 0;
      const go = (k: number) => {
        loadRest();
        i = (k + sl.length) % sl.length;
        sl.forEach((s, j) => { s.classList.toggle('on', j === i); s.toggleAttribute('aria-hidden', j !== i); });
        bb.forEach((b, j) => { b.classList.remove('on'); void b.offsetWidth; b.classList.toggle('on', j === i); b.classList.toggle('done', j < i); });
        chip.classList.add('swap');
        setTimeout(() => {
          chip.href = data[i].href; chip.querySelector<HTMLImageElement>('[data-chip-img]')!.src = data[i].thumb;
          chip.querySelector('[data-chip-title]')!.textContent = data[i].title; chip.querySelector('[data-chip-place]')!.textContent = data[i].place;
          cur.textContent = String(i + 1).padStart(2, '0'); chip.classList.remove('swap');
        }, 350);
        schedule();
      };
      const schedule = () => { clearTimeout(timer); if (!reduce) timer = window.setTimeout(() => go(i + 1), 6500); };
      bb.forEach((b, j) => b.addEventListener('click', () => go(j)));
      hero.addEventListener('mouseenter', () => hero.classList.add('paused'));
      hero.addEventListener('mouseleave', () => hero.classList.remove('paused'));
      document.addEventListener('visibilitychange', () => (document.hidden ? clearTimeout(timer) : schedule()));
      setTimeout(schedule, document.documentElement.classList.contains('has-intro') ? 2600 : 0);
    }
  </script>

  <section class="intro wrap">
    <p class="label muted reveal">00 — Introduction</p>
    <p class="statement reveal">I turn early design ideas into concepts clients approve, from public buildings at <em>NEOM</em> to the headquarters of <em>SABIC</em> and <em>stc</em>. Idea, model, image and drawing set, carried by one hand.</p>
  </section>

  <section class="dark numbers">
    <div class="wrap grid4 stagger">
      <div class="reveal"><span class="n" data-count={projects.length}>{projects.length}</span><span class="label muted">Projects</span></div>
      <div class="reveal"><span class="n" data-count={countries.length}>{countries.length}</span><span class="label muted">Countries</span></div>
      <div class="reveal"><span class="n" data-count={years}>{years}</span><span class="label muted">Years in practice</span></div>
      <div class="reveal"><span class="n">2</span><span class="label muted">Studios · ZFP &amp; Cosmos</span></div>
    </div>
  </section>

  <section class="wrap feat">
    <div class="sheet-head"><h2 class="label">01 — Selected work</h2><a href="/work/" class="label link">All {projects.length} projects →</a></div>
    <div class="row r1"><ProjectCard p={f1} size="l" eager /><ProjectCard p={f2} /></div>
    <div class="row r2"><ProjectCard p={f3} /><ProjectCard p={f4} size="l" /></div>
    <div class="row r3"><ProjectCard p={f5} /><ProjectCard p={f6} /><a href="/work/" class="more reveal" data-cursor="Index"><span class="label">Index of work</span><span class="display-m">See all {projects.length} projects</span><span class="label go">Open the index <span class="arr">→</span></span></a></div>
  </section>

  <section class="dark marquee" aria-label="Clients and projects">
    <div class="track">{[...names, ...names].map((n) => <span>{n}<i aria-hidden="true">✦</i></span>)}</div>
  </section>

  <section class="dark duo">
    <div class="wrap">
      <div class="sheet-head"><h2 class="label">02 — Practice</h2><a href="/about/" class="label link">About Aya →</a></div>
      <div class="cols">
        <h2 class="display-l lines"><span class="ln"><span>Precision, vision,</span></span><span class="ln"><span><em>scale</em> and craft.</span></span></h2>
        <div class="pill stagger">
          {[['Precision', 'Concepts built to be built, from Revit models to IFC drawing sets.'], ['Vision', 'Reading the brief and giving it one clear idea.'], ['Scale', 'National projects and corporate headquarters across the Gulf.'], ['Craft', 'Material, light and the detail that holds them together.']].map(([t, d], i) => (
            <div class="reveal"><span class="label muted">0{i + 1}</span><h3>{t}</h3><p>{d}</p></div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="wrap svc">
    <div class="sheet-head"><h2 class="label">03 — Services</h2><a href="/services/" class="label link">How I work →</a></div>
    <ol>
      {services.map((s, i) => (
        <li class="reveal"><a href="/services/" data-preview={previews[i]}><span class="label muted">0{i + 1}</span><span class="display-m">{s.t}</span><span class="arr">→</span></a></li>
      ))}
    </ol>
  </section>
</Base>

<style>
  .hero { position: relative; height: 100svh; min-height: 640px; max-height: 1120px; color: var(--ow); overflow: hidden; background: var(--night); }
  .slides { position: absolute; inset: 0; }
  .slide { position: absolute; inset: 0; opacity: 0; transition: opacity 1.6s var(--ease); }
  .slide.on { opacity: 1; z-index: 1; }
  .slide .para { position: absolute; inset: 0; }
  .pl { position: absolute; inset: -8% 0; }
  .pl :global(.kb) { width: 100%; height: 100%; object-fit: cover; transform: scale(1.12); transition: transform 9s linear; }
  .slide.on .pl :global(.kb) { transform: scale(1.02); }
  .veil { position: absolute; inset: 0; z-index: 2; background: rgba(32, 28, 27, .38); }
  .veil::after { content: ""; position: absolute; inset: 0; background: linear-gradient(to top, rgba(32, 28, 27, .82) 0%, rgba(32, 28, 27, .25) 45%, rgba(32, 28, 27, 0) 70%, rgba(32, 28, 27, .35) 100%); }
  .inner { position: relative; z-index: 5; height: 100%; display: grid; grid-template-rows: auto 1fr auto auto; gap: clamp(20px, 3vw, 36px); padding-top: calc(104px + env(safe-area-inset-top, 0px)); padding-bottom: clamp(20px, 3.2vw, 40px); }
  .top { display: flex; justify-content: space-between; gap: 24px; color: rgba(243, 237, 227, .86); }
  .kicker { display: flex; align-items: center; gap: 12px; }
  .kicker.r { text-align: right; display: block; }
  .dotl { width: 28px; height: 1px; background: currentColor; }
  h1 { grid-row: 3; font: 400 clamp(56px, 10.5vw, 176px)/.9 var(--display); letter-spacing: -.02em; max-width: 12ch; }
  .hl .ln { display: block; overflow: hidden; padding-bottom: .06em; margin-bottom: -.06em; }
  .hl .ln > span { display: inline-block; animation: lineup 1s var(--ease) both; }
  .hl .ln:nth-child(2) > span { animation-delay: .08s; }
  @keyframes lineup { from { transform: translateY(100%); } }
  .foil { font-style: italic; background: var(--gold) center / cover; -webkit-background-clip: text; background-clip: text; color: transparent; padding-right: .08em; }
  @supports not ((-webkit-background-clip: text) or (background-clip: text)) { .foil { color: var(--ow); background: none; } }
  .bottom { grid-row: 4; display: grid; grid-template-columns: auto 1fr auto; gap: 20px 32px; align-items: end; padding-top: 20px; border-top: 1px solid var(--rule-light); animation: up .9s .2s var(--ease) both; }
  @keyframes up { from { opacity: 0; transform: translateY(14px); } }
  .ctas { display: flex; gap: 10px; flex-wrap: wrap; }
  .btn.solid { background: var(--ow); color: var(--ink); border-color: var(--ow); }
  .btn.solid::before { background: var(--ox) !important; }
  .btn.solid:hover { color: var(--ow) !important; border-color: var(--ox) !important; }
  .btn.ghost { border-color: rgba(255,255,255,.25); }
  .ctrl { display: flex; align-items: center; gap: 18px; justify-self: center; }
  .idx { color: rgba(243, 237, 227, .8); font-variant-numeric: tabular-nums; }
  .idx b { font-weight: 400; color: var(--ow); }
  .bars { display: flex; gap: 6px; }
  .bb { position: relative; width: 44px; height: 24px; background: none; border: 0; padding: 0; cursor: pointer; }
  .bb::before { content: ""; position: absolute; left: 0; right: 0; top: 50%; height: 1px; background: rgba(243, 237, 227, .3); }
  .bb i { position: absolute; left: 0; right: 0; top: 50%; height: 1px; background: var(--ow); transform: scaleX(0); transform-origin: left; }
  .bb.done i { transform: scaleX(1); }
  .bb.on i { animation: fillbar 6.5s linear forwards; }
  .paused .bb.on i { animation-play-state: paused; }
  @keyframes fillbar { to { transform: scaleX(1); } }
  .chip { display: grid; grid-template-columns: 72px 1fr auto; align-items: center; gap: 14px; padding: 8px 18px 8px 8px; min-width: 300px; transition: background .4s, transform .5s var(--ease); }
  .chip:hover { background: rgba(94, 26, 36, .6); }
  .chip img { width: 72px; height: 54px; object-fit: cover; transition: opacity .35s; }
  .ct { display: grid; gap: 2px; min-width: 0; transition: opacity .35s, transform .35s; }
  .ct .label { font-size: 11px; color: rgba(243, 237, 227, .72); letter-spacing: .18em; }
  .ct strong { font: 400 20px/1.15 var(--display); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .chip.swap .ct, .chip.swap img { opacity: 0; transform: translateY(6px); }
  @media (max-width: 1000px) { .bottom { grid-template-columns: 1fr auto; } .ctrl { grid-column: 1 / -1; grid-row: 2; justify-self: start; } .chip { grid-row: 1; grid-column: 2; } }
  @media (max-width: 700px) {
    .hero { min-height: 600px; }
    .top .kicker.r { display: none; }
    h1 { font-size: clamp(54px, 16.5vw, 96px); }
    .bottom { grid-template-columns: 1fr; gap: 16px; border-top: 0; padding-top: 0; }
    .ctas { display: grid; grid-template-columns: 1fr auto; }
    .ctas .btn { justify-content: center; padding-inline: 18px; }
    .chip { grid-column: 1; grid-row: auto; min-width: 0; grid-template-columns: 56px 1fr auto; }
    .chip img { width: 56px; height: 42px; }
    .ctrl { grid-row: auto; justify-content: space-between; width: 100%; }
    .bb { width: 32px; height: 32px; }
  }
  .intro { padding-block: clamp(80px, 12vw, 180px); display: grid; grid-template-columns: 1fr 3fr; gap: 32px; }
  .statement { font: 400 clamp(28px, 3.6vw, 56px)/1.16 var(--display); text-wrap: pretty; }
  .statement em { color: var(--ox); }
  @media (max-width: 800px) { .intro { grid-template-columns: 1fr; } }

  .numbers { padding-block: clamp(48px, 6vw, 84px); }
  .grid4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 32px; }
  .grid4 > div { display: grid; gap: 8px; padding-top: 18px; border-top: 1px solid var(--rule-light); }
  .n { font: 400 clamp(56px, 7vw, 110px)/.9 var(--display); font-variant-numeric: tabular-nums; }
  @media (max-width: 760px) { .grid4 { grid-template-columns: 1fr 1fr; } }

  .feat { padding-block: clamp(64px, 9vw, 140px); }
  .row { display: grid; gap: clamp(28px, 3vw, 48px); margin-top: clamp(28px, 4vw, 56px); align-items: start; }
  .r1 { grid-template-columns: 2fr 1fr; } .r2 { grid-template-columns: 1fr 2fr; } .r3 { grid-template-columns: 1fr 1fr 1fr; }
  .r1 > :last-child, .r2 > :first-child { margin-top: clamp(0px, 10vw, 160px); }
  .more { position: relative; overflow: hidden; display: flex; flex-direction: column; justify-content: space-between; gap: 24px; aspect-ratio: 4 / 3; padding: 28px; background: var(--night); color: var(--ow); isolation: isolate; }
  .more::before { content: ""; position: absolute; inset: 0; background: var(--ox); z-index: -1; clip-path: circle(0% at 100% 100%); transition: clip-path .8s var(--ease-io); }
  .more:hover::before { clip-path: circle(150% at 100% 100%); }
  .more .label:first-child { color: var(--muted-dark); }
  @media (max-width: 900px) { .r1, .r2, .r3 { grid-template-columns: 1fr; } .r1 > :last-child, .r2 > :first-child { margin-top: 0; } .more { aspect-ratio: auto; min-height: 240px; } }

  .marquee { overflow: hidden; padding-block: 30px; border-bottom: 1px solid var(--rule-light); }
  .track { display: flex; width: max-content; animation: slide 50s linear infinite; }
  .marquee:hover .track { animation-play-state: paused; }
  .track span { font: 400 clamp(34px, 4.4vw, 68px)/1 var(--display); white-space: nowrap; padding-right: 36px; transition: color .3s, opacity .3s; }
  .marquee:hover .track span { opacity: .35; }
  .marquee .track span:hover { opacity: 1; color: #D8C7A6; font-style: italic; }
  .track i { font-style: normal; font-size: .38em; vertical-align: middle; padding-left: 36px; color: var(--muted-dark); }
  @keyframes slide { to { transform: translateX(-50%); } }

  .duo { padding-block: clamp(64px, 9vw, 140px); }
  .cols { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 6vw, 96px); margin-top: 40px; }
  .cols em { color: #D8C7A6; }
  .pill { display: grid; grid-template-columns: 1fr 1fr; gap: 0; border-top: 1px solid var(--rule-light); }
  .pill > div { padding: 24px 24px 28px 0; border-bottom: 1px solid var(--rule-light); display: grid; gap: 8px; transition: padding .5s var(--ease); }
  .pill > div:hover { padding-left: 12px; }
  .pill h3 { font-size: 30px; }
  .pill p { color: rgba(243,237,227,.7); font-size: 15px; }
  @media (max-width: 860px) { .cols { grid-template-columns: 1fr; } }
  @media (max-width: 480px) { .pill { grid-template-columns: 1fr; } }

  .svc { padding-block: clamp(64px, 9vw, 140px); }
  .svc ol { list-style: none; margin: 0; padding: 0; }
  .svc li { border-bottom: 1px solid var(--rule); }
  .svc a { display: grid; grid-template-columns: 60px 1fr auto; align-items: center; gap: 16px; padding-block: clamp(20px, 2.6vw, 34px); transition: color .35s, padding .5s var(--ease); }
  .svc a:hover { color: var(--ox); padding-left: 16px; }
  .svc a:hover .display-m { font-style: italic; }
  .svc .arr { font-size: 22px; }
</style>
