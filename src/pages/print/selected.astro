---
/* Selected Works, A4 landscape, < 10 MB → /Aya_Hassan_Selected_Works.pdf (10 Nov brief, Part 4).
   Featured projects: opener + thinking spread + renders + drawings. Supporting: opener only. */
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/archivo/wdth-italic.css';
import { getImage } from 'astro:assets';
import { projects, imagesFor, drawingsFor, fileFor, disciplinesFor, countries, contact, projectNo, clientLogo, type Project } from '../../data/projects';

const diag = import.meta.glob<{ default: any }>('../../assets/diagrams/*.jpg', { eager: true });
const img = (slug: string, f: string) => f.startsWith('x:') ? diag[`../../assets/diagrams/${f.slice(2)}.jpg`]?.default : fileFor(slug, f);
const jpg = async (src: any, w = 1100) => (src ? (await getImage({ src, width: Math.min(w, src.width), format: 'jpg', quality: 66 })).src : '');
const practice = (p: Project) => p.practice === 'ZFP' ? 'ZFP · Zuhair Fayez Partnership' : p.practice ?? 'Independent';
const place = (p: Project) => p.location === p.country || p.location.includes(p.country) ? p.location : `${p.location}, ${p.country}`;
const P = (s: string) => projects.find((p) => p.slug === s)!;

const think: Record<string, [string, string][]> = {
  'travco-west-island': [['Brief: premier coastal destination — max sea views, hospitality-level living, respect for landscape', '05'], ['Idea: orient for wind and water', 'd04'], ['Plan: empty plot to four units', 'd03'], ['Approved; under construction', '01']],
  'misr-italia-hilltop': [['Brief: luxury coastal living around the lagoon', '01'], ['Problem: the concept draft showed a building, not a lifestyle', '04'], ['My enhancements: materials, details, façade', '02'], ['Approved; under construction', '03']],
  'staff-housing': [['Tension: density vs quality of life vs budget', 'd03'], ['Courtyard clusters on a town-wide pedestrian network', 'd02'], ['Two repeatable prototypes for cost and speed', 'd05'], ['Nubian arches, shade, earth', 'd01']],
  'sodic-east-vale': [['Brief: private sanctuaries, daylight, ventilation, views', '03'], ['Decision I argued for: private quarters apart from reception (oxblood = private, sand = reception)', 'x:east-vale-zones'], ['High ceilings, fluid inside–outside', '02'], ['Under construction', '01']],
  'sabic-hq': [['Brief: turn an outdated HQ into a dynamic, collaborative, brand-led one', '04'], ['Constraint: existing slab protrusion', '01'], ['Decision: make it the feature — the atrium planters', '02'], ['Under construction', '03']],
  'stc-hq': [['Brief: futuristic, recognisable, minimal', '01'], ['Site: the tower’s huge curves (oxblood = curve zones)', 'x:stc-curves'], ['Decision: curves become destinations', '02'], ['My concept became the team’s base', '05']],
};
type Item = { kind: 'div'; n: string; name: string; sub?: boolean } | { kind: 'proj'; slug: string; featured: boolean } | { kind: 'card' };
const plan: Item[] = [
  { kind: 'div', n: '01', name: 'Architecture' },
  { kind: 'proj', slug: 'travco-west-island', featured: true }, { kind: 'proj', slug: 'misr-italia-hilltop', featured: true },
  { kind: 'proj', slug: 'staff-housing', featured: true }, { kind: 'proj', slug: 'sallan-creek', featured: true }, { kind: 'proj', slug: 'sodic-east-vale', featured: true },
  ...['sodic-ogami', 'orascom-o-west', 'chery-showroom', 'fifth-square', 'mazeej', 'neom-oxagon'].map((slug) => ({ kind: 'proj', slug, featured: false }) as Item),
  { kind: 'div', n: '02', name: 'Interiors' },
  { kind: 'proj', slug: 'sabic-hq', featured: true }, { kind: 'proj', slug: 'stc-hq', featured: true },
  ...['suits-workspaces', 'modern-residence-new-cairo', 'hb-fuller', 'sphinx', 'jotun-office', 'tech-park', 'conference-room', 'bmw-showroom'].map((slug) => ({ kind: 'proj', slug, featured: false }) as Item),
  { kind: 'div', n: '03', name: 'Delivery: BIM packages' },
  { kind: 'card' },
];

// Studies vs plans (drawing numbers). Studies get their own large pages; plans share one scale per project.
const studyNos: Record<string, number[]> = { 'travco-west-island': [4], 'staff-housing': [1, 2, 3], 'sallan-creek': [1, 2], 'sodic-east-vale': [1], 'sodic-ogami': [1], 'fifth-square': [1], 'neom-oxagon': [1], 'chery-showroom': [1] };
const trimmed = import.meta.glob<{ default: any }>('../../assets/print/*/d*.jpg', { eager: true });
const scales = import.meta.glob<string>('../../assets/print/*/d*.scale', { eager: true, query: '?raw', import: 'default' });
const sheetsFor = (slug: string) => Object.keys(trimmed).filter((k) => k.includes(`/print/${slug}/`)).sort().map((k) => {
  const no = Number(k.match(/d(\d+)\.jpg$/)![1]); const m = trimmed[k].default; const sc = Number(scales[k.replace('.jpg', '.scale')] ?? 1);
  return { no, m, w: m.width / sc, h: m.height / sc };
});
const AW = 269, AH = 150, GAP = 7, CAP = 7;
type S = { no: number; m: any; w: number; h: number };
const fit = (row: S[][]) => {
  const hs = row.map((r) => Math.max(...r.map((x) => x.h)));
  const byW = Math.min(...row.map((r) => (AW - GAP * (r.length - 1)) / r.reduce((a, x) => a + x.w, 0)));
  const byH = (AH - CAP * row.length - GAP * (row.length - 1)) / hs.reduce((a, b) => a + b, 0);
  return Math.min(byW, byH);
};
const arrange = (xs: S[]) => {
  let best = { rows: [xs], s: fit([xs]) };
  for (let k = 1; k < xs.length; k++) { const r = [xs.slice(0, k), xs.slice(k)]; const v = fit(r); if (v > best.s) best = { rows: r, s: v }; }
  return best;
};
const pack = (xs: S[], common: boolean) => {
  const pages: S[][] = []; let cur: S[] = [];
  for (const x of xs) {
    const next = [...cur, x];
    const alone = Math.min(...next.map((y) => arrange([y]).s));
    if (cur.length && (next.length > 4 || arrange(next).s < 0.5 * alone)) { pages.push(cur); cur = [x]; } else cur = next;
  }
  if (cur.length) pages.push(cur);
  const laid = pages.map((pg) => arrange(pg));
  const s0 = common ? Math.min(...laid.map((l) => l.s)) : 0;
  return laid.map((l) => ({ rows: l.rows, s: common ? s0 : l.s }));
};
const sheetPages = (xs: S[], common: boolean) => Promise.all(pack(xs, common).map(async (pg) => ({ s: pg.s, rows: await Promise.all(pg.rows.map((r) => Promise.all(r.map(async (x) => ({ ...x, src: await jpg(x.m, 1200) }))))) })));

let seq = 0;
const codes: Record<string, string> = {};
for (const it of plan) { if (it.kind === 'div' && !it.sub) seq = 0; if (it.kind === 'proj') codes[it.slug] = String(++seq).padStart(2, '0'); }
const items = await Promise.all(plan.map(async (it) => {
  if (it.kind !== 'proj') return it;
  const p = P(it.slug), imgs = imagesFor(p.slug), dr = drawingsFor(p.slug);
  const steps = it.featured && think[p.slug] ? await Promise.all(think[p.slug].map(async ([t, f]) => { const m = img(p.slug, f); return { t, d: f.startsWith('d') || f.startsWith('x:'), w: !!m && m.width / m.height > 2, src: await jpg(m, 900) }; })) : [];
  return { ...it, p, code: codes[p.slug], logo: clientLogo(p.slug), disc: [...disciplinesFor(p)], steps,
    cover: await jpg(imgs[0], 1150),
    rest: [] as string[],
    mosaic: await Promise.all(imgs.slice(1, 4).map((x) => jpg(x, 650))),
    studyPages: await sheetPages(sheetsFor(p.slug).filter((x) => (studyNos[p.slug] ?? []).includes(x.no)), false),
    planPages: await sheetPages(sheetsFor(p.slug).filter((x) => !(studyNos[p.slug] ?? []).includes(x.no)), true) };
}));
let total = 3 + 1;
for (const it of items as any[]) total += it.kind === 'proj' ? 1 + (it.steps.length ? 1 : 0) + (it.rest.length ? 1 : 0) + it.studyPages.length + it.planPages.length : 1;
let pn = 3; const N = () => String(++pn).padStart(2, '0'); const T = String(total).padStart(2, '0');
let sheet = 0; const next = () => `A-${String(++sheet).padStart(3, '0')}`;

const coverImg = await jpg(imagesFor('travco-west-island')[0], 1800);
const aboutImg = await jpg(imagesFor('sabic-hq')[1], 1100);
const backImg = await jpg(imagesFor('misr-italia-hilltop')[0], 1800);
const clients = ['sodic', 'orascom', 'misr-italia', 'travco', 'neom', 'stc', 'sabic', 'jotun', 'bmw', 'chery', 'hb-fuller', 'al-marasem', 'guira', 'linah'];
const typed = ['NOATUM', 'Suits Workspaces'];
const year = new Date().getFullYear();
const shown = (items as any[]).filter((i) => i.kind === 'proj').length;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="robots" content="noindex" />
<title>Aya Hassan — Selected Works</title>
<style is:global>
  @page { size: 297mm 210mm; margin: 0; }
  :root { --ow: #F3EDE3; --ink: #2B2826; --night: #201C1B; --ox: #5E1A24; --sand: #D6CBBE; --mut: #8C857D; --rule: rgba(43,40,38,.18); }
  * { box-sizing: border-box; }
  html, body { margin: 0; background: #777; }
  body { font-family: "Archivo Variable", sans-serif; color: var(--ink); -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  .pg { width: 297mm; height: 210mm; position: relative; overflow: hidden; background: var(--ow); page-break-after: always; break-after: page; margin: 0 auto 8mm; }
  @media print { html, body { background: none; } .pg { margin: 0; } }
  .dark { background: var(--night); color: var(--ow); }
  img { display: block; }
  .grade { }
  .lab { font-size: 7.5pt; font-weight: 500; letter-spacing: .22em; text-transform: uppercase; }
  .mut { color: var(--mut); } .dark .mut { color: rgba(243,237,227,.6); }
  .ox { color: var(--ox); }
  .wide { font-weight: 800; font-stretch: 125%; letter-spacing: -.02em; line-height: .9; }
  em { font-weight: 250; font-style: italic; font-stretch: 100%; }
  /* sheet frame: footer strip on every page */
  .foot { position: absolute; left: 12mm; right: 12mm; bottom: 8mm; display: flex; justify-content: space-between; align-items: center; padding-top: 3mm; border-top: 1px solid var(--rule); }
  .dark .foot, .on-img .foot { border-color: rgba(243,237,227,.3); }
  .wm { display: inline-flex; align-items: center; gap: 2.4mm; font-weight: 800; font-stretch: 125%; font-size: 8pt; letter-spacing: .06em; }
  .wm i { width: 1px; height: 3mm; background: currentColor; opacity: .45; }
  .dim { display: flex; align-items: center; gap: 4mm; color: var(--sand); }
  .dim i { flex: 1; height: 1px; background: currentColor; position: relative; }
  .dim i::before { content: ""; position: absolute; top: -2mm; width: 1px; height: 4.2mm; background: currentColor; }
  .dim i:first-child::before { left: 0; } .dim i:last-child::before { right: 0; }
  .dim span { font-size: 7.5pt; letter-spacing: .26em; text-transform: uppercase; white-space: nowrap; }

  /* cover */
  .cover img.bg, .back img.bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .veil { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(32,28,27,.25), rgba(32,28,27,.72)); }
  .cover .cbar { position: absolute; left: 12mm; right: 12mm; bottom: 9mm; display: flex; gap: 9mm; padding-top: 3mm; border-top: 1px solid rgba(243,237,227,.3); color: var(--ow); font-size: 8.5pt; font-weight: 500; }
  .cover .cbar a { border-bottom: 1px solid rgba(243,237,227,.45); }
  .cover .tb { position: absolute; left: 12mm; right: 12mm; bottom: 26mm; color: var(--ow); }
  .cover h1 { margin: 3mm 0 6mm; font-size: 76pt; white-space: nowrap; }
  .cells { display: grid; grid-template-columns: 2.2fr 1fr 1fr; gap: 8mm; align-items: end; }
  .cells .mot { font-size: 17pt; font-weight: 600; letter-spacing: -.02em; }
  .cells .mot em { color: var(--sand); }
  .cells dt { font-size: 6.5pt; letter-spacing: .22em; text-transform: uppercase; opacity: .7; margin-bottom: 1.5mm; }
  .cells dd { margin: 0; font-size: 10pt; font-weight: 500; }
  .cover .top { position: absolute; left: 12mm; right: 12mm; top: 10mm; display: flex; justify-content: space-between; color: var(--ow); }

  /* about */
  .about { display: grid; grid-template-columns: 96mm 1fr; }
  .about .ph { height: 210mm; overflow: hidden; } .about .ph img { width: 100%; height: 100%; object-fit: cover; }
  .about .tx { padding: 14mm 14mm 22mm 14mm; display: grid; grid-template-rows: auto auto 1fr auto; gap: 6mm; }
  .stmt { font-size: 21pt; font-weight: 800; line-height: 1.12; letter-spacing: -.02em; margin: 0; }
  .bio { font-size: 9pt; line-height: 1.55; columns: 2; column-gap: 8mm; margin: 0; }
  .tl { display: grid; gap: 0; align-content: start; }
  .tl div { display: grid; grid-template-columns: 26mm 1fr; gap: 4mm; padding: 2.4mm 0; border-top: 1px solid var(--rule); font-size: 8pt; line-height: 1.4; }
  .tl b { font-weight: 600; } .tl .y { color: var(--ox); font-weight: 600; }
  .nums { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6mm; }
  .nums div { border-top: 1px solid var(--ox); padding-top: 2.5mm; }
  .nums b { display: block; font-size: 30pt; font-weight: 800; font-stretch: 125%; line-height: 1; color: var(--ox); }

  /* clients */
  .clients { padding: 14mm 12mm 22mm; }
  .head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 8mm; }
  .head h2 { margin: 0; font-size: 34pt; }
  .lg { display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid var(--rule); border-left: 1px solid var(--rule); }
  .lg div { height: 33mm; display: grid; place-items: center; border-right: 1px solid var(--rule); border-bottom: 1px solid var(--rule); padding: 6mm 10mm; }
  .lg img { max-width: 100%; max-height: 19mm; object-fit: contain; }
  .lg span { font-size: 15pt; font-weight: 800; font-stretch: 112%; }

  /* index */
  .index { padding: 14mm 12mm 22mm; }
  .ix { display: grid; grid-template-columns: 1fr 1fr; gap: 0 12mm; }
  .ix h3 { margin: 0 0 3mm; font-size: 8pt; letter-spacing: .22em; text-transform: uppercase; color: var(--ox); font-weight: 600; }
  .ix ol { list-style: none; margin: 0; padding: 0; }
  .ix li { display: grid; grid-template-columns: 11mm 1fr auto 10mm; gap: 3mm; align-items: baseline; padding: 1.55mm 0; border-top: 1px solid var(--rule); font-size: 8.4pt; }
  .ix li.sh { display: block; padding: 3mm 0 1mm; border-top: 0; font-weight: 800; font-stretch: 125%; font-size: 7.6pt; letter-spacing: .14em; text-transform: uppercase; color: var(--ox); }
  .ix li .c { color: var(--mut); font-size: 7pt; } .ix li .m { color: var(--mut); font-size: 7pt; } .ix li .n { text-align: right; font-weight: 600; }

  /* section divider */
  .divider { display: grid; align-content: end; padding: 12mm 12mm 26mm; }
  .divider .big { font-size: 120pt; color: var(--sand); line-height: .8; }
  .divider h2 { margin: 4mm 0 0; font-size: 58pt; }

  /* project opener */
  .op { display: grid; grid-template-columns: 1fr 92mm; }
  .op .im { height: 210mm; overflow: hidden; } .op .im img { width: 100%; height: 100%; object-fit: cover; }
  .op .side { padding: 12mm 11mm 22mm; display: flex; flex-direction: column; gap: 5mm; }
  .pno { display: flex; flex-direction: column; gap: 1mm; }
  .pno .big { font-weight: 800; font-stretch: 125%; font-size: 52pt; line-height: .8; letter-spacing: -.03em; color: var(--ox); }
  .pno small { font-size: 10pt; font-weight: 500; color: var(--mut); margin-left: 1.5mm; vertical-align: top; letter-spacing: .08em; }
  .blk .cl { display: flex; align-items: center; gap: 3mm; } .blk .cl img { height: 9mm; width: auto; max-width: 30mm; object-fit: contain; }
  .code { font-size: 9pt; font-weight: 600; letter-spacing: .12em; color: var(--ox); }
  .op h2 { margin: 0; font-size: 22pt; line-height: .98; font-stretch: 112%; }
  .op .role { margin: 0; font-size: 10pt; line-height: 1.4; font-weight: 700; }
  .rtag { margin-left: 2.5mm; padding: .5mm 1.6mm; border: .5pt solid var(--ox); font-size: 6.4pt; letter-spacing: .1em; }
  .op .sum { font-size: 9.2pt; line-height: 1.5; margin: 0; }
  .blk { margin: auto 0 0; display: grid; grid-template-columns: 1fr 1fr; border-top: 1px solid var(--rule); }
  .blk div { padding: 2.6mm 0; border-bottom: 1px solid var(--rule); }
  .blk div:nth-child(odd) { padding-right: 3mm; }
  .blk .w { grid-column: 1 / -1; }
  .blk dt { font-size: 6.3pt; letter-spacing: .2em; text-transform: uppercase; color: var(--mut); margin-bottom: 1mm; }
  .blk dd { margin: 0; font-size: 8.4pt; line-height: 1.35; }
  .disc { display: flex; flex-wrap: wrap; gap: 1.6mm 4mm; }
  .disc span { display: inline-flex; align-items: center; gap: 1.5mm; font-size: 6.8pt; letter-spacing: .14em; text-transform: uppercase; color: var(--ox); }
  .disc span::before { content: ""; width: 2mm; height: 2mm; background: var(--ox); }
  a { color: inherit; text-decoration: none; }
  .blk .lk { display: flex; flex-wrap: wrap; gap: 1mm 4mm; } .blk .lk a { color: var(--ox); border-bottom: 1px solid rgba(94,26,36,.35); }
  .back dd a { border-bottom: 1px solid rgba(243,237,227,.5); }
  .tag { align-self: flex-start; font-size: 6.5pt; letter-spacing: .2em; text-transform: uppercase; border: 1px solid var(--ox); color: var(--ox); padding: 1mm 2mm; }

  /* renders page */
  .gal { padding: 10mm 12mm 22mm; display: grid; gap: 4mm; height: 210mm; }
  .gal img { width: 100%; height: 100%; object-fit: cover; min-height: 0; }
  .gal.n1 { grid-template: 1fr / 1fr; }
  .gal.n2 { grid-template: 1fr / 1fr 1fr; }
  .gal.n3 { grid-template: 1fr 1fr / 1.5fr 1fr; } .gal.n3 img:first-child { grid-row: 1 / 3; }
  .gal.n4 { grid-template: 1fr 1fr / 1.4fr 1fr 1fr; } .gal.n4 img:first-child { grid-row: 1 / 3; } .gal.n4 img:nth-child(4) { grid-column: 2 / 4; }
  .gal > * { min-height: 0; overflow: hidden; }

  /* drawings page */
  .drw { padding: 10mm 12mm 22mm; display: grid; gap: 5mm; height: 210mm; }
  .drw.n1 { grid-template: 1fr / 1fr; } .drw.n2 { grid-template: 1fr / 1fr 1fr; } .drw.n3 { grid-template: 1fr / 1fr 1fr 1fr; } .drw.n4 { grid-template: 1fr 1fr / 1fr 1fr; }
  .drw figure { margin: 0; background: var(--ow); padding: 4mm 4mm 0; display: flex; flex-direction: column; min-height: 0; outline: 1px solid rgba(214,203,190,.25); }
  .drw figure img { flex: 1; min-height: 0; width: 100%; object-fit: contain; }
  .drw figcaption { display: flex; justify-content: space-between; padding: 2mm 0 2.4mm; margin-top: 2mm; border-top: 1px solid var(--ox); font-size: 6.4pt; letter-spacing: .2em; text-transform: uppercase; color: var(--ox); }

  /* back */
  .back .ct { position: absolute; left: 12mm; right: 12mm; bottom: 24mm; color: var(--ow); }
  .back h2 { margin: 0 0 8mm; font-size: 46pt; line-height: .95; }
  .back h2 em { color: var(--sand); }
  .back dl { display: grid; grid-template-columns: repeat(4, auto); justify-content: start; gap: 12mm; margin: 0; }
  .back dt { font-size: 6.5pt; letter-spacing: .22em; text-transform: uppercase; opacity: .7; margin-bottom: 1.5mm; }
  .back dd { margin: 0; font-size: 10.5pt; font-weight: 500; }

  /* Selected Works additions */
  .think { padding: 13mm 14mm 22mm; display: grid; grid-template-rows: auto 1fr; gap: 8mm; }
  .think .hd { display: flex; align-items: baseline; gap: 5mm; border-bottom: .5pt solid var(--ox); padding-bottom: 3mm; }
  .think .hd b { font-size: 20pt; font-weight: 800; font-stretch: 125%; color: var(--ox); letter-spacing: -.02em; }
  .think .hd h2 { margin: 0; font-size: 15pt; font-stretch: 112%; }
  .think .hd .lab { margin-left: auto; }
  .steps { display: grid; grid-template-columns: repeat(4, 1fr); gap: 6mm; align-items: start; }
  .steps > div { display: grid; gap: 3mm; }
  .steps .n { font-size: 30pt; font-weight: 800; font-stretch: 125%; color: var(--ox); line-height: 1; border-bottom: .5pt solid var(--ink); padding-bottom: 2mm; }
  .steps p { margin: 0; font-size: 11.5pt; line-height: 1.35; min-height: 25mm; font-weight: 500; }
  .steps figure, .steps .ph { margin: 0; height: 110mm; background: #E9E1D4; display: flex; align-items: center; justify-content: center; overflow: hidden; }
  .steps .ph img { width: 100%; height: 100%; object-fit: cover; }
  .steps figure img { max-width: 100%; max-height: 100%; object-fit: contain; }
  .card { padding: 22mm 24mm; display: grid; grid-template-columns: 1fr 1.2fr; gap: 16mm; align-content: center; }
  .card h2 { margin: 3mm 0 0; font-size: 30pt; line-height: 1; font-stretch: 125%; }
  .card p { font-size: 12pt; line-height: 1.55; margin: 0; }
  .card .tg { display: inline-block; margin-top: 6mm; padding: 1mm 2.5mm; border: .5pt solid var(--ox); color: var(--ox); font-size: 8pt; letter-spacing: .12em; font-weight: 600; }
  .sheets { padding: 12mm 14mm 0; }
  .sh-hd { display: flex; align-items: baseline; gap: 5mm; border-bottom: .5pt solid var(--ox); padding-bottom: 3mm; margin-bottom: 6mm; }
  .sh-hd b { font-size: 16pt; font-weight: 800; font-stretch: 125%; color: var(--ox); }
  .sh-hd h2 { margin: 0; font-size: 13pt; font-stretch: 112%; }
  .sh-hd .lab { margin-left: auto; }
  .sh-body { height: 158mm; display: flex; flex-direction: column; justify-content: center; gap: 7mm; }
  .sh-row { display: flex; justify-content: center; align-items: flex-end; gap: 7mm; }
  .sh-row figure { margin: 0; }
  .sh-row img { display: block; object-fit: contain; }
  .sh-row figcaption { display: flex; justify-content: space-between; gap: 4mm; margin-top: 2mm; padding-top: 1.5mm; border-top: .5pt solid var(--ox); font-size: 6.6pt; letter-spacing: .12em; text-transform: uppercase; color: var(--ink); }
  .sh-row figcaption span:last-child { color: var(--ox); font-weight: 700; }
  .op .mos { display: grid; grid-template-columns: 2fr 1fr; gap: 1.5mm; background: var(--bone); }
  .op .mos img { width: 100%; height: 100%; object-fit: cover; min-height: 0; }
  .op .mos .big { grid-row: 1 / -1; }
  .op .mos.m1 { grid-template-rows: 1fr; } .op .mos.m2 { grid-template-rows: 1fr 1fr; } .op .mos.m3 { grid-template-rows: 1fr 1fr 1fr; }
</style>
</head>
<body>
<section class="pg cover dark on-img">
  <img class="bg grade" src={coverImg} alt="" />
  <div class="veil"></div>
  <div class="top"><a class="wm" href="https://ayahassan.com">AYA<i></i>HASSAN</a><span class="lab">Selected works · {year}</span></div>
  <div class="tb">
    <div class="dim"><i></i><span>Architect · Interior designer</span><i></i></div>
    <h1 class="wide">AYA HASSAN</h1>
    <dl class="cells">
      <div class="mot">Bold on paper. <em>Solid on ground.</em></div>
      <div><dt>Based</dt><dd>Cairo, EG</dd></div>
      <div><dt>Practice</dt><dd>2019 —</dd></div>
    </dl>
  </div>
  <nav class="cbar">
    <a href={`mailto:${contact.email}`}>{contact.email}</a>
    <a href="https://ayahassan.com">ayahassan.com</a>
    <a href={contact.linkedin}>{contact.linkedinLabel}</a>
    <a href={contact.instagram}>@ayahassanmr</a>
  </nav>
</section>

<section class="pg about">
  <div class="ph"><img class="grade" src={aboutImg} alt="" /></div>
  <div class="tx">
    <div class="lab ox">About</div>
    <div><p class="stmt">An idea only counts once it stands on real ground.</p></div>
    <div style="display:grid;gap:6mm;align-content:start">
      <p class="bio">I design architecture and interiors that begin as an original idea and end as a built place. Concepts that surprise, details that work on site: homes on Egypt’s coast, luxury residences inland, and corporate headquarters from Cairo to Riyadh. I have led teams of up to five, and carry projects myself when needed, from idea to Revit drawing set. Each project here names my role.</p>
    </div>
    <div class="nums">
      <div><b>{shown}</b><span class="lab mut">Projects in this selection</span></div>
      <div><b>{countries.length}</b><span class="lab mut">Countries</span></div>
      <div><b>{year - 2019}</b><span class="lab mut">Years in practice</span></div>
    </div>
  </div>
  <div class="foot"><a class="wm" href="https://ayahassan.com">AYA<i></i>HASSAN</a><span class="lab mut">02 / {T}</span></div>
</section>

<section class="pg clients">
  <div class="head"><h2 class="wide">Clients</h2><span class="lab ox">Trusted by · 2019 —</span></div>
  <div class="lg">
    {clients.map((c) => <div><img src={`/clients/${c}.png`} alt={c} /></div>)}
    {typed.map((c) => <div><span>{c}</span></div>)}
  </div>
  <div class="foot"><a class="wm" href="https://ayahassan.com">AYA<i></i>HASSAN</a><span class="lab mut">03 / {T}</span></div>
</section>

{(items as any[]).map((it) => {
  if (it.kind === 'div') return (
    <section class:list={['pg dark divider', it.sub && 'sub']}>
      <span class="big wide">{it.n}</span>
      <h2 class="wide">{it.name}</h2>
      <div class="foot"><a class="wm" href="https://ayahassan.com">AYA<i></i>HASSAN</a><span class="lab mut">{N()} / {T}</span></div>
    </section>
  );
  if (it.kind === 'card') return (
    <section class="pg card">
      <div>
        <div class="lab ox">Delivery · BIM package</div>
        <h2 class="wide">NEOM, Misk Schools</h2>
        <span class="tg">LEAD</span>
      </div>
      <div>
        <p>Led a team of five delivering the complete architectural BIM package (LOD 300) for two schools; consultant coordination with structure, MEP, the client and NEOM standards; code-compliance review. Delivered to deadline.</p>
        <p class="mut" style="margin-top:6mm;font-size:9pt">Drawings are confidential and not shown.</p>
      </div>
      <div class="foot"><a class="wm" href="https://ayahassan.com">AYA<i></i>HASSAN</a><span class="lab mut">{N()} / {T}</span></div>
    </section>
  );
  const p = it.p;
  return (
    <>
      <section class="pg op" id={`p${p.slug}`}>
        {it.mosaic.length ? <div class:list={['im mos', `m${it.mosaic.length}`]}><img class="grade big" src={it.cover} alt="" />{it.mosaic.map((m: string) => <img class="grade" src={m} alt="" />)}</div> : <div class="im"><img class="grade" src={it.cover} alt="" /></div>}
        <div class="side">
          <span class="pno"><span class="lab ox" style="font-weight:700">{p.sector}{p.roleTag && <span class="rtag">{p.roleTag}</span>}</span><span class="big">{it.code}</span></span>
          <h2 class="wide"><a href={`https://ayahassan.com/work/${p.slug}/`}>{p.title}</a></h2>
          {p.role && <p class="role">{p.role}</p>}
          {p.summary && <p class="sum">{p.summary}</p>}
          <dl class="blk">
            <div class="w"><dt>Client</dt><dd class="cl">{it.logo && <img src={it.logo} alt="" />}<span>{p.client}</span></dd></div>
            <div><dt>Year</dt><dd>{p.year}</dd></div>
            <div><dt>{p.status ? 'Status' : 'Sector'}</dt><dd>{p.status ?? p.sector}</dd></div>
            <div class="w"><dt>Location</dt><dd>{place(p)}</dd></div>
            <div class="w"><dt>Practice</dt><dd>{practice(p)}</dd></div>
            <div class="w"><dt>Scope</dt><dd><span class="disc">{it.disc.map((d: string) => <span>{d}</span>)}</span>{p.scopeNote && <span class="mut" style="display:block;margin-top:1.5mm;font-size:7.4pt">{p.scopeNote}</span>}</dd></div>
          </dl>
        </div>
        <div class="foot" style="left:auto;width:70mm;right:11mm"><a class="wm" href="https://ayahassan.com">AYA<i></i>HASSAN</a><span class="lab mut">{N()} / {T}</span></div>
      </section>
      {it.steps.length > 0 && (
        <section class="pg think">
          <div class="hd"><b>{it.code}</b><h2 class="wide">{p.title}</h2><span class="lab ox">How it was decided</span></div>
          <div class="steps" style={`grid-template-columns: ${it.steps.map((s: any) => (s.w ? '2fr' : '1fr')).join(' ')}`}>{it.steps.map((s: any, k: number) => <div><span class="n">{String(k + 1).padStart(2, '0')}</span><p>{s.t}</p>{s.d ? <figure><img src={s.src} alt="" /></figure> : <div class="ph"><img class="grade" src={s.src} alt="" /></div>}</div>)}</div>
          <div class="foot"><span class="lab"><span class="ox" style="font-size:11pt;font-weight:800;font-stretch:125%;letter-spacing:0">{it.code}</span> · {p.title} · Thinking</span><span class="lab mut">{N()} / {T}</span></div>
        </section>
      )}
      {[['Studies', it.studyPages], ['Plans & drawings', it.planPages]].flatMap(([lbl, pgs]: any) => pgs.map((pg: any) => (
        <section class="pg sheets">
          <div class="sh-hd"><b>{it.code}</b><h2 class="wide">{p.title}</h2><span class="lab ox">{lbl}</span></div>
          <div class="sh-body">{pg.rows.map((r: any[]) => (
            <div class="sh-row">{r.map((x: any) => (
              <figure style={`width:${(x.w * pg.s).toFixed(1)}mm`}>
                <img src={x.src} alt="" style={`width:${(x.w * pg.s).toFixed(1)}mm;height:${(x.h * pg.s).toFixed(1)}mm`} />
                <figcaption><span>{p.captions?.[x.no - 1] ?? `Drawing ${String(x.no).padStart(2, '0')}`}</span><span>{next()}</span></figcaption>
              </figure>
            ))}</div>
          ))}</div>
          <div class="foot"><span class="lab"><span class="ox" style="font-size:11pt;font-weight:800;font-stretch:125%;letter-spacing:0">{it.code}</span> · {p.title} · {lbl}</span><span class="lab mut">{N()} / {T}</span></div>
        </section>
      )))}
      {it.rest.length > 0 && (
        <section class="pg">
          <div class:list={['gal', `n${it.rest.length}`]}>{it.rest.map((r: string) => <img class="grade" src={r} alt="" />)}</div>
          <div class="foot"><span class="lab"><span class="ox" style="font-size:11pt;font-weight:800;font-stretch:125%;letter-spacing:0">{it.code}</span> · {p.title}</span><span class="lab mut">{N()} / {T}</span></div>
        </section>
      )}
    </>
  );
})}

<section class="pg back dark on-img">
  <img class="bg grade" src={backImg} alt="" />
  <div class="veil"></div>
  <div class="ct">
    <h2 class="wide">Every good project starts with a conversation.<br /><em>Send me yours.</em></h2>
    <dl>
      <div><dt>Email</dt><dd><a href={`mailto:${contact.email}`}>{contact.email}</a></dd></div>
      <div><dt>Web</dt><dd><a href="https://ayahassan.com">ayahassan.com</a></dd></div>
      <div><dt>LinkedIn</dt><dd><a href={contact.linkedin}>{contact.linkedinLabel}</a></dd></div>
      <div><dt>Instagram</dt><dd><a href={contact.instagram}>@ayahassanmr</a></dd></div>
    </dl>
  </div>
  <div class="foot"><a class="wm" href="https://ayahassan.com">AYA<i></i>HASSAN</a><span class="lab mut">{T} / {T}</span></div>
</section>
</body>
</html>
