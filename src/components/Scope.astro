---
/* Scope widget: the five disciplines Aya delivers, shown as a drafting-style strip.
   compact = five initials on project cards; full = labelled strip on project pages. */
import { disciplinesFor, DISCIPLINES, type Project } from '../data/projects';
interface Props { p: Project; variant?: 'compact' | 'full'; dark?: boolean }
const { p, variant = 'compact', dark = false } = Astro.props;
const on = disciplinesFor(p);
const said = DISCIPLINES.filter((d) => on.has(d)).join(', ');
---
<div class:list={['scope', variant, { dark }]} role="img" aria-label={`Scope: ${said}`}>
  {DISCIPLINES.map((d, i) => (
    <span class:list={['c', { on: on.has(d) }]} aria-hidden="true">
      {variant === 'full' && <span class="n">{String(i + 1).padStart(2, '0')}</span>}
      <span class="mark"></span>
      <span class="t">{variant === 'full' ? d : d[0]}</span>
    </span>
  ))}
</div>

<style>
  .scope { display: flex; align-items: center; font-family: var(--sans); text-transform: uppercase; letter-spacing: .12em; }
  .c { display: inline-flex; align-items: center; gap: 6px; color: var(--muted); opacity: .38; transition: opacity .4s var(--ease), color .4s; }
  .c.on { opacity: 1; color: var(--ox); }
  .mark { width: 7px; height: 7px; border: 1px solid currentColor; border-radius: 1px; flex: none; }
  .c.on .mark { background: currentColor; }

  /* compact: five initials, each a tiny filled or hollow square */
  .compact { gap: 10px; font-size: 10.5px; }
  .compact .t { line-height: 1; }

  /* full: a single ruled strip, one cell per discipline */
  .full { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); border: 1px solid var(--rule); border-radius: var(--r-1); overflow: hidden; }
  .full .c { flex-direction: column; align-items: flex-start; gap: 10px; padding: 14px 16px; font-size: 11.5px; border-right: 1px solid var(--rule); min-width: 0; }
  .full .c:last-child { border-right: 0; }
  .full .c.on { background: rgba(94, 26, 36, .06); }
  .full .n { font-size: 10px; letter-spacing: .08em; opacity: .7; }
  .full .mark { width: 9px; height: 9px; }
  .full .t { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 100%; }
  @media (max-width: 560px) { .full .c { padding: 12px 10px; font-size: 10px; letter-spacing: .06em; } .full .n { display: none; } }

  .dark .c { color: var(--muted-dark); }
  .dark .c.on { color: var(--ow); }
  :global(.dark) .compact .c.on { color: var(--ow); }
  :global(.dark) .compact .c { color: var(--muted-dark); }
</style>
