---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Reel from '../components/Reel.astro';
import { imagesFor, cover } from '../data/projects';
import { i18n } from '../i18n';
const L = i18n(Astro.url);
const { t, u } = L;
const servicesEn = [
  { t: 'Concept design', d: 'Architectural and interior concepts, from the first studies to a direction the client signs off. Massing, spatial strategy, colour and material language, set out in a clear presentation.', img: imagesFor('neom-oxagon')[3] ?? imagesFor('neom-oxagon')[0], items: ['Concept studies & diagrams', 'Spatial planning', 'Mood, colour & material direction', 'Concept presentations'] },
  { t: 'Visualization & animation', d: 'Renders, walkthroughs and promotional films built to win approval, for clients, juries and marketing teams.', img: imagesFor('fifth-square')[0], items: ['Photoreal stills', 'Walkthrough animation', 'Promotional content', 'Post-production'] },
  { t: 'BIM & design packages', d: 'Revit models and coordinated drawing sets, from schematic design to issued-for-construction packages.', img: imagesFor('noatum-terminal')[3] ?? imagesFor('noatum-terminal')[0], items: ['Revit modelling', 'Schematic & IFC drawing sets', 'Interdisciplinary coordination', 'Design review to code'] },
  { t: 'Materials & FF&E', d: 'Material boards, finishes and furniture selection, sourced from suppliers worldwide and checked on site.', img: imagesFor('stc-hq')[3], items: ['Material boards & samples', 'Furniture, fixtures & equipment', 'Vendor collaboration', 'Site visits'] },
];
const servicesAr = [
  { t: 'التصميم المبدئي', d: 'أفكار معمارية وداخلية، من الدراسات الأولى حتى اتجاه يعتمده العميل. الكتلة، والاستراتيجية الفراغية، ولغة الألوان والمواد، في عرض واضح.', items: ['دراسات ومخططات الفكرة', 'التخطيط الفراغي', 'اتجاه الأجواء والألوان والمواد', 'عروض الفكرة'] },
  { t: 'الإظهار والتحريك', d: 'صور وجولات وأفلام ترويجية مصممة لكسب الموافقة، للعملاء ولجان التحكيم وفرق التسويق.', items: ['صور واقعية', 'أفلام الجولات', 'محتوى ترويجي', 'المعالجة النهائية'] },
  { t: 'BIM وحزم التصميم', d: 'نماذج Revit ومجموعات رسومات منسقة، من التصميم التخطيطي حتى الحزم المعتمدة للتنفيذ.', items: ['النمذجة بـ Revit', 'رسومات تخطيطية ورسومات التنفيذ (IFC)', 'التنسيق بين التخصصات', 'مراجعة التصميم وفق الكود'] },
  { t: 'المواد والأثاث والتجهيزات', d: 'لوحات المواد والتشطيبات واختيار الأثاث، من موردين حول العالم ومراجعتها في الموقع.', items: ['لوحات وعينات المواد', 'الأثاث والتجهيزات والمعدات', 'التعاون مع الموردين', 'الزيارات الميدانية'] },
];
const ways = L.ar ? [
  { t: 'وظيفة بدوام كامل', d: 'مهندسة تصميم أو مصممة أولى ضمن استوديو أو فريق مطوّر عقاري. في القاهرة، أو عن بُعد، أو بالانتقال إلى الخليج.', cta: 'اطّلع على السيرة الذاتية', href: u('/cv/') },
  { t: 'مشروع كامل', d: 'تصميم مبدئي لمبنى أو مساحة داخلية، من الفكرة حتى حزمة الرسومات.', cta: 'ابدأ مشروعك', href: u('/contact/?type=project') },
  { t: 'دعم للاستوديوهات', d: 'صور واقعية، أنيميشن أو حزم Revit بمواعيد تسليم سريعة.', note: ['موعدك ضيّق؟', 'أرسل الموجز، وسأؤكد لك المدة خلال 24 ساعة.'], cta: 'أرسل الموجز', href: u('/contact/?type=studio') },
] : [
  { t: 'Full-time role', d: 'Design architect or senior designer in a studio or developer team. Cairo, remote, or relocation to the Gulf.', cta: 'See CV', href: u('/cv/') },
  { t: 'Full project', d: 'Concept design for a building or interior, from brief to drawing set.', cta: 'Start a project', href: u('/contact/?type=project') },
  { t: 'Studio support', d: 'Renders, animation or Revit packages for studios on deadline.', note: ['Tight deadline?', 'Send the brief — I’ll confirm timing within 24 hours.'], cta: 'Send a brief', href: u('/contact/?type=studio') },
];
const services = L.ar ? servicesEn.map((s, i) => ({ ...s, ...servicesAr[i] })) : servicesEn;
const stepsEn = [
  ['Brief', 'Understand the client, the site and what the space has to do.'],
  ['Concept', 'One clear idea, tested through studies, diagrams and mood.'],
  ['Visualise', 'Model and render the concept until it can be believed.'],
  ['Package', 'Turn the approved concept into drawings, specs and selections.'],
];
const steps = L.ar ? [
  ['المتطلبات', 'فهم العميل والموقع وما يجب أن تؤديه المساحة.'],
  ['الفكرة', 'فكرة واحدة واضحة، تُختبر بالدراسات والمخططات والأجواء.'],
  ['الإظهار', 'نمذجة الفكرة وإظهارها حتى تصبح قابلة للتصديق.'],
  ['الحزمة', 'تحويل الفكرة المعتمدة إلى رسومات ومواصفات واختيارات.'],
] : stepsEn;
---
<Base title={t('Services', 'الخدمات')} description={t('Concept design, visualization and animation, BIM and design packages, and materials and FF&E selection.', 'التصميم المبدئي، والإظهار والتحريك، وBIM وحزم التصميم، واختيار المواد والأثاث والتجهيزات.')}>
  <PageHero images={[imagesFor('neom-oxagon')[0], imagesFor('fifth-square')[1], imagesFor('noatum-terminal')[0], imagesFor('stc-hq')[3]]} alt={t('Rendered public buildings at NEOM Oxagon', 'إظهار لمباني الخدمات العامة في أوكساجون، نيوم')}>
    <h1 class="display-xl lines"><span class="ln"><span>{t('From concept', 'من الفكرة')}</span></span><span class="ln"><span>{L.ar ? <>إلى <em>الرسومات.</em></> : <>to <em>drawing set.</em></>}</span></span></h1>
    <p class="lede">{t('Concept design, visualization, BIM packages and material selection: the whole concept stage, carried by one hand.', 'التصميم المبدئي والإظهار وحزم BIM واختيار المواد: مرحلة التصميم المبدئي كاملة، بيدٍ واحدة.')}</p>
  </PageHero>

  <section class="wrap list">
    <div class="sheet-head"><h2 class="label">{t('Ways to work with me', 'طرق التعاون')}</h2></div>
    {ways.map((w, i) => (
      <article class="svc reveal">
        <div class="c">
          <h2 class="display-m">{String(i + 1).padStart(2, '0')} · {w.t}</h2>
          <p>{w.d}</p>
          {w.note && <p class="hook"><em>{w.note[0]}</em> {w.note[1]}</p>}
        </div>
        <p><a href={w.href} class="link">{w.cta} <span class="arr">{L.next}</span></a></p>
      </article>
    ))}
  </section>

  <section class="wrap list">
    <div class="sheet-head"><h2 class="label">{t('What I deliver', 'ما أقدّمه')}</h2></div>
    {services.map((s, i) => (
      <article class="svc reveal">
        
        <div class="c">
          <h2 class="display-m">{s.t}</h2>
          <p>{s.d}</p>
          <ul>{s.items.map((x) => <li>{x}</li>)}</ul>
        </div>
        {s.img && <figure class="para"><Image data-parallax="0.08" data-scale="1.12" src={s.img} alt="" widths={[600, 1000]} sizes="(min-width: 900px) 34vw, 100vw" /></figure>}
      </article>
    ))}
  </section>

  <Reel rows={[['fifth-square', 'stc-hq', 'jotun-office', 'neom-oxagon', 'zayed-residence', 'chery-showroom', 'sphinx'].map((s) => cover(s)!)]} />

  <section class="process dark sheet" data-sp>
    <div class="wrap">
      <div class="sheet-head"><span class="label">{t('Process', 'المنهجية')}</span></div>
      <ol>{steps.map(([t, d], i) => <li class="reveal"><h3 class="display-m">{t}</h3><p>{d}</p></li>)}</ol>
    </div>
  </section>
</Base>

<style>
  .list { padding-top: clamp(64px, 9vw, 130px); padding-bottom: clamp(64px, 9vw, 130px); }
  .hook { margin-top: 18px; font-family: "Archivo Variable", sans-serif; font-weight: 600; font-size: clamp(20px, 1.9vw, 28px); line-height: 1.25; letter-spacing: -.01em; color: var(--ink); max-width: 30ch; }
  .hook em { display: block; font-weight: 800; font-stretch: 112%; font-style: italic; font-size: 1.35em; color: var(--ox); }
  .svc h2 { transition: color .3s; } .svc:hover h2 { color: var(--ox); font-style: italic; }
  .svc { display: grid; grid-template-columns: 1.1fr 1fr; gap: clamp(24px, 4vw, 64px); padding-block: clamp(32px, 4vw, 56px); border-top: 1px solid var(--rule); align-items: start; }
  .c { display: grid; gap: 18px; }
  .c p { color: var(--ink-2); max-width: 52ch; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 8px 24px; font-size: 15px; }
  li::before { content: "— "; color: var(--ox); }
  figure { margin: 0; aspect-ratio: 4 / 3; overflow: hidden; background: var(--ow-2); }
  figure :global(img) { width: 100%; height: 100%; object-fit: cover; }
  @media (max-width: 900px) { .svc { grid-template-columns: 1fr; } ul { grid-template-columns: 1fr; } }
  .process { padding-block: clamp(64px, 9vw, 130px); }
  .process .sheet-head { border-color: var(--rule-light); }
  .process ol { list-style: none; margin: 32px 0 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 32px; }
  .process li { display: grid; gap: 12px; padding-top: 20px; border-top: 1px solid var(--rule-light); }
  .process .label { opacity: .6; }
  .process p { opacity: .85; font-size: 15px; }
  @media (max-width: 900px) { .process ol { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 520px) { .process ol { grid-template-columns: 1fr; } }
</style>
