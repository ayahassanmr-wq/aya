---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getImage } from 'astro:assets';
import { projects, cover, countries } from '../../data/projects';
const filters = [
  { id: 'all', label: 'All' },
  { id: 'architecture', label: 'Architecture' },
  { id: 'interiors', label: 'Interiors' },
  { id: 'Workplace', label: 'Workplace' },
  { id: 'Residential', label: 'Residential' },
];
const prev = await Promise.all(projects.map(async (p) => (await getImage({ src: cover(p.slug), width: 700, format: 'webp' })).src));
const count = (id: string) => id === 'all' ? projects.length : projects.filter((p) => p.category === id || p.sector === id).length;
---
<Base title="Work" description={`${projects.length} architecture and interior projects by Aya Hassan across the Gulf, Egypt and beyond.`}>
  <PageHero images={['misr-italia-hilltop', 'sabic-hq', 'neom-oxagon', 'zayed-residence'].map((x) => cover(x)!)} alt="Selected projects by Aya Hassan" meta={[['Projects', String(projects.length)], ['Architecture', String(count('architecture'))], ['Interiors', String(count('interiors'))], ['Countries', String(countries.length)]]}>
    <h1 class="display-xl lines"><span class="ln"><span>The work,</span></span><span class="ln"><span><em>{projects.length} projects.</em></span></span></h1>
  </PageHero>
  <section class="wrap head">
    <div class="bar glass" data-sticky-bar>
      <div class="filters" role="group" aria-label="Filter projects">
        {filters.map((f, i) => <button type="button" data-f={f.id} aria-pressed={i === 0 ? 'true' : 'false'}>{f.label}<sup>{count(f.id)}</sup></button>)}
      </div>
      <div class="views" role="group" aria-label="View">
        <button type="button" data-v="grid" aria-pressed="true">Grid</button>
        <button type="button" data-v="list" aria-pressed="false">List</button>
      </div>
    </div>
  </section>

  <section class="wrap" aria-labelledby="plist">
    <h2 id="plist" class="sr-only">Projects</h2>
    <p class="sr-only" aria-live="polite" data-live></p>
    <div class="grid stagger" data-view="grid">
      {projects.map((p, i) => <div class="it" data-cat={p.category} data-sector={p.sector}><ProjectCard p={p} /></div>)}
    </div>
    <ol class="list" data-view="list" hidden>
      {projects.map((p, i) => (
        <li class="it" data-cat={p.category} data-sector={p.sector}>
          <a href={`/work/${p.slug}/`} data-preview={prev[i]}>
            <span class="t">{p.title}{p.concept && <span class="tag">Concept</span>}</span>
            <span class="muted">{p.location}{p.country !== p.location && p.country !== '—' ? `, ${p.country}` : ''}</span>
            <span class="label muted">{p.category}</span>
            <span class="label muted">{p.sector}</span>
          </a>
        </li>
      ))}
    </ol>
  </section>
</Base>

<script>
  const fb = document.querySelectorAll<HTMLButtonElement>('[data-f]');
  const vb = document.querySelectorAll<HTMLButtonElement>('[data-v]');
  const live = document.querySelector<HTMLElement>('[data-live]')!;
  const apply = (f: string) => { let n = 0; document.querySelectorAll<HTMLElement>('.grid .it').forEach((el) => { el.hidden = !(f === 'all' || el.dataset.cat === f || el.dataset.sector === f); if (!el.hidden) n++; });
    document.querySelectorAll<HTMLElement>('.list .it').forEach((el) => { el.hidden = !(f === 'all' || el.dataset.cat === f || el.dataset.sector === f); });
    live.textContent = `${n} projects shown`; (window as any).__lenis?.resize?.(); };
  fb.forEach((b) => b.addEventListener('click', () => { fb.forEach((x) => x.setAttribute('aria-pressed', String(x === b))); apply(b.dataset.f!); }));
  vb.forEach((b) => b.addEventListener('click', () => {
    vb.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    document.querySelectorAll<HTMLElement>('[data-view]').forEach((v) => (v.hidden = v.dataset.view !== b.dataset.v));
    document.querySelectorAll('.reveal').forEach((el) => el.classList.remove('pre'));
  }));
</script>

<style>
  .head { padding-top: clamp(28px, 3vw, 44px); }
  .bar { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 16px; padding-block: 10px; border: 1px solid var(--rule); border-radius: var(--r-l); position: sticky; top: 80px; z-index: 5; background: rgba(243, 237, 227, .86); padding-inline: 22px; }
  @media (max-width: 760px) { .bar { top: 68px; } }
  .filters, .views { display: flex; flex-wrap: wrap; gap: 4px 22px; }
  button { background: none; border: 0; padding: 10px 0; min-height: 44px; cursor: pointer; font: 400 12px var(--sans); letter-spacing: .18em; text-transform: uppercase; color: var(--ink-2); transition: color .25s; }
  button[aria-pressed="true"], button:hover { color: var(--ox); }
  sup { font-size: 9px; margin-left: 4px; letter-spacing: 0; }
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(40px, 4vw, 64px) clamp(24px, 2.4vw, 40px); padding-block: clamp(40px, 5vw, 72px) clamp(80px, 10vw, 140px); }
  @media (max-width: 1000px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .grid { grid-template-columns: 1fr; } }
  .list { list-style: none; margin: 0; padding: 32px 0 120px; }
  .list li { border-bottom: 1px solid var(--rule); }
  .list a { display: grid; grid-template-columns: 2fr 1.4fr 1fr 1fr; gap: 16px; align-items: baseline; padding-block: 20px; transition: color .25s, padding .35s; }
  .list a:hover { color: var(--ox); padding-left: 16px; }
  .list a:hover .t { font-style: italic; }
  .code { color: var(--ox); }
  .list a { transition: color .3s, padding .5s var(--ease); }
  .list .t { font: 400 clamp(22px, 2.2vw, 32px)/1.15 var(--display); display: flex; gap: 12px; align-items: center; flex-wrap: wrap; }
  .list .tag { font-size: 9px; }
  @media (max-width: 760px) { .list a { grid-template-columns: 1fr; gap: 4px; } }
</style>
