---
/* Logo intro (~4 s, once per session).
   AYA fills the screen: its outline is traced in off-white, two contour echoes ripple out from it,
   the off-white fill rises up through the letters, then the mark shrinks and flies into the header logo
   while the screen parts top and bottom onto the hero. Skippable; never with reduced motion or without JS. */
---
<script is:inline>
  try {
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches && !sessionStorage.getItem('aya-intro')) {
      document.documentElement.classList.add('has-intro');
      sessionStorage.setItem('aya-intro', '1');
    }
  } catch (e) {}
</script>
<div class="intro" aria-hidden="true" data-intro>
  <span class="half up"></span><span class="half dn"></span>
  <div class="stage" data-stage>
    <div class="drift">
      <svg class="mk echo e2" viewBox="0 0 941 453"><use href="/brand/aya-sprite.svg#aya" /></svg>
      <svg class="mk echo e1" viewBox="0 0 941 453"><use href="/brand/aya-sprite.svg#aya" /></svg>
      <svg class="mk line" viewBox="0 0 941 453"><use href="/brand/aya-sprite.svg#aya" /></svg>
      <svg class="mk fill" viewBox="0 0 941 453"><use href="/brand/aya-sprite.svg#aya" /></svg>
    </div>
  </div>
  <button type="button" class="label skip-intro" data-skip tabindex="-1">Skip</button>
</div>

<script>
  const root = document.documentElement;
  const el = document.querySelector<HTMLElement>('[data-intro]');
  if (el && root.classList.contains('has-intro')) {
    let done = false;
    const stage = el.querySelector<HTMLElement>('[data-stage]')!;
    const end = () => {
      if (done) return; done = true;
      const target = document.querySelector<HTMLElement>('a.logo img');
      const a = stage.getBoundingClientRect();
      if (target) {
        const b = target.getBoundingClientRect();
        if (b.width > 0) stage.style.setProperty('--fly', `translate(${b.left + b.width / 2 - (a.left + a.width / 2)}px, ${b.top + b.height / 2 - (a.top + a.height / 2)}px) scale(${b.width / a.width})`);
      }
      root.classList.add('intro-out');
      setTimeout(() => { root.classList.remove('has-intro', 'intro-out'); el.remove(); }, 1150);
    };
    setTimeout(end, 2950);
    el.querySelector('[data-skip]')!.addEventListener('click', end);
    addEventListener('keydown', end, { once: true });
    addEventListener('pointerdown', end, { once: true });
  } else el?.remove();
</script>

<style>
  .intro { display: none; }
  :global(.has-intro) .intro { display: grid; place-items: center; position: fixed; inset: 0; z-index: 500; color: var(--ow); overflow: hidden; }
  :global(.has-intro a.logo img) { opacity: 0; }
  .half { position: absolute; left: 0; right: 0; height: 50.5%; background: var(--night); transition: transform 1.05s var(--ease-io); }
  .up { top: 0; } .dn { bottom: 0; }
  :global(.intro-out) .up { transform: translateY(-100%); }
  :global(.intro-out) .dn { transform: translateY(100%); }

  /* the mark fills the screen (as wide as the viewport allows without overflowing its height) */
  .stage { position: relative; z-index: 2; width: min(92vw, calc(78svh * 941 / 453)); aspect-ratio: 941 / 453; transform-origin: center; }
  :global(.intro-out) .stage { transform: var(--fly, scale(.1)); transition: transform 1.05s cubic-bezier(.7, 0, .2, 1); }
  .drift { position: absolute; inset: 0; animation: drift 2.95s cubic-bezier(.2, .7, .2, 1) both; }
  @keyframes drift { from { transform: scale(1.12) translateY(3%); } to { transform: none; } }

  .mk { position: absolute; inset: 0; width: 100%; height: 100%; display: block; overflow: visible; }
  /* 1. the outline is traced */
  .line { fill: transparent; stroke: var(--sand); stroke-width: 1.3px; vector-effect: non-scaling-stroke; stroke-dasharray: 1; stroke-dashoffset: 1; animation: draw 1.6s .1s cubic-bezier(.65, .05, .3, 1) forwards, lineout .5s 2.3s forwards; }
  @keyframes draw { to { stroke-dashoffset: 0; } }
  @keyframes lineout { to { stroke: rgba(243, 237, 227, 0); } }
  /* 3. once filled, two contour echoes ripple outward, like offset lines on a plan */
  .echo { fill: transparent; stroke: rgba(243, 237, 227, .4); stroke-width: 1px; vector-effect: non-scaling-stroke; opacity: 0; transform-origin: 50% 50%; }
  .e1 { animation: echo 1.2s 2.05s cubic-bezier(.2, .7, .2, 1) forwards; }
  .e2 { animation: echo 1.3s 2.2s cubic-bezier(.2, .7, .2, 1) forwards; --to: 1.18; }
  @keyframes echo { 0% { opacity: 0; transform: scale(1); } 15% { opacity: 1; } 100% { opacity: 0; transform: scale(var(--to, 1.08)); } }
  /* 2. the fill rises up through the letters */
  .fill { fill: #F3EDE3; clip-path: inset(100% 0 0 0); animation: rise .85s 1.45s cubic-bezier(.7, 0, .2, 1) forwards; }
  @keyframes rise { to { clip-path: inset(0 0 0 0); } }
  :global(.intro-out) .echo { animation: none; opacity: 0; }

  .skip-intro { position: absolute; z-index: 3; right: max(var(--gut), env(safe-area-inset-right, 0px)); bottom: calc(18px + env(safe-area-inset-bottom, 0px)); background: none; border: 0; color: var(--muted-dark); padding: 12px; cursor: pointer; transition: opacity .3s; }
  :global(.intro-out) .skip-intro { opacity: 0; }
</style>
