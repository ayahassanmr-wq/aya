---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Reel from '../components/Reel.astro';
import { projects, featured, countries, imagesFor, cover, projectNo } from '../data/projects';
import { getImage } from 'astro:assets';
import { i18n, localize, place as placeOf } from '../i18n';
import { placeAr } from '../data/projects-ar';
const L = i18n(Astro.url);
const { t, u } = L;
const loc = (p: typeof projects[number]) => localize(p, L.ar);
const slideSlugs = ['misr-italia-hilltop', 'stc-hq', 'neom-oxagon', 'sodic-ogami'];
const slides = await Promise.all(slideSlugs.map(async (slug) => {
  const p = projects.find((x) => x.slug === slug)!;
  const img = imagesFor(slug)[0];
  const later = await Promise.all([480, 720, 960, 1400, 2000].map(async (w) => { const r = await getImage({ src: img, width: w, format: 'webp', quality: 66 }); return `${r.src} ${w}w`; }));
  return { p, img, srcset: later.join(', '), thumb: (await getImage({ src: img, width: 240, format: 'webp' })).src };
}));
const place = (p: typeof projects[number]) => placeOf(loc(p));
const years = new Date().getFullYear() - 2019; // freelance practice since 2019
const reelRows = [['neom-oxagon', 'jotun-office', 'misr-italia-hilltop', 'sodic-east-vale', 'chery-showroom', 'travco-west-island', 'noatum-terminal'], ['stc-hq', 'sodic-ogami', 'bmw-showroom', 'mazeej', 'tech-park', 'sallan-creek', 'staff-housing']];
const thumb = async (slug: string) => (await getImage({ src: cover(slug)!, width: 480, height: 360, fit: 'cover', format: 'webp', quality: 62 })).src;
const stats = [
  { n: projects.length, l: t('Selected projects', 'مشروعًا مختارًا'), d: t('A selection of architecture and interiors, from first concept to drawing set.', 'مختارات من العمارة والتصميم الداخلي، من الفكرة الأولى حتى مجموعة الرسومات.'), img: await thumb('neom-oxagon') },
  { n: countries.length, l: t('Countries', 'دول'), d: countries.map((c) => (L.ar ? placeAr[c] ?? c : c).replace(/ /g, '\u00a0')).join(' · '), img: await thumb('travco-west-island') },
  { n: years, l: t('Years in practice', 'سنوات من الممارسة'), d: t('Concept design since 2019.', 'في التصميم المبدئي منذ 2019.'), img: await thumb('sallan-creek') },
  { n: 3, l: t('Studios', 'استوديوهات'), d: t('ZFP (Zuhair Fayez Partnership), Cosmos Studio and Innovation Design Studio.', 'زهير فايز ومشاركوه (ZFP)، وكوزموس ستوديو، وإنوفيشن ديزاين ستوديو.'), img: await thumb('stc-hq') },
];
const feats = await Promise.all(featured.slice(0, 6).map(async (p) => {
  const img = cover(p.slug)!;
  const set = await Promise.all([800, 1300, 1900].map(async (w) => `${(await getImage({ src: img, width: w, format: 'webp', quality: 66 })).src} ${w}w`));
  return { p, srcset: set.join(', '), src: set[1].split(' ')[0], w: img.width, h: img.height };
}));
const services = [
  { t: t('Full-time role', 'وظيفة بدوام كامل'), slug: 'stc-hq', href: u('/contact/?type=job') },
  { t: t('Full project', 'مشروع كامل'), slug: 'misr-italia-hilltop', href: u('/contact/?type=project') },
  { t: t('Studio support', 'دعم للاستوديوهات'), slug: 'sallan-creek', href: u('/contact/?type=studio') },
];
const previews = await Promise.all(services.map(async (s) => (await getImage({ src: cover(s.slug), width: 900, format: 'webp', quality: 70 })).src));
const stripSlugs: [string, string][] = L.ar ? [['مبانٍ عامة', 'neom-oxagon'], ['مقرات', 'sabic-hq'], ['أبراج إدارية', 'stc-hq'], ['مكاتب', 'jotun-office'], ['تصميم داخلي', 'modern-residence-new-cairo'], ['معارض', 'chery-showroom'], ['لوجستيات', 'noatum-terminal'], ['مجمعات تقنية', 'tech-park'], ['ساحلي', 'travco-west-island'], ['مخططات عامة', 'staff-housing']] : [['Public', 'neom-oxagon'], ['Headquarters', 'sabic-hq'], ['Office towers', 'stc-hq'], ['Offices', 'jotun-office'], ['Interiors', 'modern-residence-new-cairo'], ['Showrooms', 'chery-showroom'], ['Logistics', 'noatum-terminal'], ['Tech campus', 'tech-park'], ['Coastal', 'travco-west-island'], ['Masterplans', 'staff-housing']];
// client wall — real logo files dropped in public/clients/<id>.svg replace the typographic mark automatically
import fs from 'node:fs';
const clientList: { id: string; c: string; n: string; slug: string; w?: number; wt?: number; tr?: string; lc?: boolean; it?: boolean }[] = [
  { id: 'sodic', c: '#0E2B4C', n: 'SODIC', slug: 'sodic-ogami', w: 125, wt: 900, tr: '.18em' },
  { id: 'orascom', c: '#00467F', n: 'Orascom', slug: 'orascom-o-west', w: 100, wt: 700 },
  { id: 'misr-italia', c: '#B5893C', n: 'Misr Italia', slug: 'misr-italia-hilltop', w: 112, wt: 300, it: true },
  { id: 'neom', c: '#1A1A1A', n: 'NEOM', slug: 'neom-oxagon', w: 125, wt: 200, tr: '.42em' },
  { id: 'stc', c: '#4F008C', n: 'stc', slug: 'stc-hq', w: 100, wt: 800, lc: true },
  { id: 'sabic', c: '#009FDF', n: 'SABIC', slug: 'sabic-hq', w: 118, wt: 800, tr: '.06em' },
  { id: 'travco', c: '#00508F', n: 'Travco', slug: 'travco-west-island', w: 108, wt: 600, it: true },
  { id: 'jotun', c: '#E2001A', n: 'JOTUN', slug: 'jotun-office', w: 125, wt: 900 },
  { id: 'bmw', c: '#1C69D4', n: 'BMW', slug: 'bmw-showroom', w: 100, wt: 700, tr: '.1em' },
  { id: 'chery', c: '#C8102E', n: 'CHERY', slug: 'chery-showroom', w: 125, wt: 500, tr: '.3em' },
  { id: 'noatum', c: '#E4002B', n: 'NOATUM', slug: 'noatum-terminal', w: 112, wt: 800 },
  { id: 'hb-fuller', c: '#D52B1E', n: 'H.B. Fuller', slug: 'hb-fuller', w: 100, wt: 600 },
  { id: 'al-marasem', c: '#7A5C3E', n: 'Al Marasem', slug: 'fifth-square', w: 112, wt: 250 },
  { id: 'guira', c: '#2F6B4F', n: 'Guira', slug: 'mazeej', w: 125, wt: 700, it: true },
  { id: 'linah', c: '#3E8E41', n: 'Linah Farms', slug: 'linah-farms', w: 100, wt: 400 },
  { id: 'suits', c: '#1E1E1E', n: 'Suits', slug: 'suits-workspaces', w: 125, wt: 800, lc: true },
];
const clients = clientList.map((c) => ({ ...c, logo: fs.existsSync(`public/clients/${c.id}.png`) ? `/clients/${c.id}.png` : null }));

const strip = await Promise.all(stripSlugs.map(async ([n, slug]) => ({ n, src: (await getImage({ src: cover(slug), width: 320, height: 220, fit: 'cover', format: 'webp', quality: 60 })).src })));
---
<Base overHero intro preloadImage={{ srcset: slides[0].srcset, sizes: '100vw' }}>
  <section class="hero" data-hero data-sp="out" aria-label={t('Introduction', 'مقدمة')} data-slides={JSON.stringify(slides.map((x) => ({ href: u(`/work/${x.p.slug}/`), title: loc(x.p).title, place: place(x.p), thumb: x.thumb })))}>
    <div class="slides">
      {slides.map((x, i) => (
        <div class:list={['slide', { on: i === 0 }]} aria-hidden={i === 0 ? undefined : 'true'}>
          <div class="para"><div class="pl" data-parallax="0.14" data-scale="1">
            {i === 0
              ? <img alt={`${loc(x.p).title}, ${place(x.p)}`} class="kb" srcset={x.srcset} sizes="100vw" src={x.srcset.split(' ')[0]} width={x.img.width} height={x.img.height} fetchpriority="high" decoding="async" />
              : <img alt="" class="kb" data-srcset={x.srcset} sizes="100vw" width={x.img.width} height={x.img.height} decoding="async" />}
          </div></div>
        </div>
      ))}
    </div>
    <div class="veil"></div>
    <div class="wrap inner">
      <div class="top"></div>
      <div class="tb" dir="ltr">
        <div class="dimn" aria-hidden="true"><i></i><span>{t('Architect · Interior designer', 'معمارية · مصممة داخلية')}</span><i></i></div>
        <h1 class="hl nm-h"><span class="ln"><span>AYA&nbsp;HASSAN</span></span></h1>
        <dl class="cells" dir={L.dir}>
          <div class="c mot"><dt class="sr-only">{t('Motto', 'الشعار')}</dt><dd>{L.ar ? <>جريئة على الورق، <em>راسخة على الأرض.</em></> : <>Bold on paper. <em>Solid on ground.</em></>}</dd></div>
          <div class="c"><dt class="label">{t('Based', 'المقر')}</dt><dd>{t('Cairo, EG', 'القاهرة، مصر')}</dd></div>
          <div class="c"><dt class="label">{t('Practice', 'منذ')}</dt><dd>2019 —</dd></div>
        </dl>
      </div>
      <div class="bottom">
        <div class="ctas">
          <a href={u('/work/')} class="btn pop magnet">{t('View the work', 'شاهد الأعمال')} <span class="arr">{L.next}</span></a>
        </div>
        <div class="ctrl" role="group" aria-label={t('Featured projects', 'مشاريع مميزة')}>
          <div class="bars">{slides.map((x, i) => <button type="button" class:list={['bb', { on: i === 0 }]} data-go={i} aria-label={`${t('Show', 'اعرض')} ${loc(x.p).title}`}><i></i></button>)}</div>
        </div>
        <a class="chip glass-dark" href={u(`/work/${slides[0].p.slug}/`)} data-chip data-cursor={t('View', 'عرض')}>
          <img src={slides[0].thumb} alt="" width="120" height="90" data-chip-img />
          <span class="ct"><strong data-chip-title>{loc(slides[0].p).title}</strong><span class="label pl2" data-chip-place>{place(slides[0].p)}</span></span>
          <span class="arr" aria-hidden="true">{L.next}</span>
        </a>
      </div>
    </div>
  </section>

  <script>
    const hero = document.querySelector<HTMLElement>('[data-hero]');
    if (hero) {
      const data = JSON.parse(hero.dataset.slides!);
      const sl = [...hero.querySelectorAll<HTMLElement>('.slide')];
      const bb = [...hero.querySelectorAll<HTMLElement>('.bb')];
      const chip = hero.querySelector<HTMLAnchorElement>('[data-chip]')!;
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const loadRest = () => hero.querySelectorAll<HTMLImageElement>('img[data-srcset]').forEach((im) => { im.srcset = im.dataset.srcset!; im.removeAttribute('data-srcset'); });
      if (document.readyState === 'complete') setTimeout(loadRest, 1200); else addEventListener('load', () => setTimeout(loadRest, 1200), { once: true });
      let i = 0, timer = 0;
      const go = (k: number) => {
        loadRest();
        i = (k + sl.length) % sl.length;
        sl.forEach((s, j) => { s.classList.toggle('on', j === i); s.toggleAttribute('aria-hidden', j !== i); });
        bb.forEach((b, j) => { b.classList.remove('on'); void b.offsetWidth; b.classList.toggle('on', j === i); b.classList.toggle('done', j < i); });
        chip.classList.add('swap');
        setTimeout(() => {
          chip.href = data[i].href; chip.querySelector<HTMLImageElement>('[data-chip-img]')!.src = data[i].thumb;
          chip.querySelector('[data-chip-title]')!.textContent = data[i].title; chip.querySelector('[data-chip-place]')!.textContent = data[i].place;
          chip.classList.remove('swap');
        }, 350);
        schedule();
      };
      const schedule = () => { clearTimeout(timer); if (!reduce) timer = window.setTimeout(() => go(i + 1), 6500); };
      bb.forEach((b, j) => b.addEventListener('click', () => go(j)));
      hero.addEventListener('mouseenter', () => hero.classList.add('paused'));
      hero.addEventListener('mouseleave', () => hero.classList.remove('paused'));
      document.addEventListener('visibilitychange', () => (document.hidden ? clearTimeout(timer) : schedule()));
      setTimeout(schedule, document.documentElement.classList.contains('has-intro') ? 4400 : 0);
    }
  
  // client wall: two rows drift in opposite directions; drag / wheel / swipe / arrows scroll them; seamless loop.
  // Position is kept as a float (scrollLeft alone rounds sub-pixel steps away on scaled Windows displays).
  document.querySelectorAll<HTMLElement>('[data-cl]').forEach((el) => {
    const dir = +(el.dataset.dir || 1), speed = 0.5;
    let pos = 0, pause = 0, down = false, sx = 0, sp = 0, moved = false, self = false;
    const third = () => (el.firstElementChild as HTMLElement).scrollWidth / 3;
    const set = (v: number) => { const t = third(); if (t > 0) { while (v >= 2 * t) v -= t; while (v < t) v += t; } pos = v; self = true; el.scrollLeft = v; };
    const hold = () => (pause = performance.now() + 2500);
    const start = () => set(third());
    requestAnimationFrame(start); addEventListener('load', start);
    const tick = () => { if (!down && performance.now() > pause) set(pos + speed * dir); requestAnimationFrame(tick); };
    requestAnimationFrame(tick);
    el.addEventListener('scroll', () => { if (self) { self = false; return; } pos = el.scrollLeft; set(pos); hold(); }, { passive: true });
    el.addEventListener('wheel', (e) => { if (Math.abs(e.deltaX) > Math.abs(e.deltaY) || e.shiftKey) hold(); }, { passive: true });
    el.addEventListener('touchstart', hold, { passive: true });
    el.addEventListener('pointerdown', (e) => { if (e.pointerType !== 'mouse') return; down = true; moved = false; sx = e.clientX; sp = pos; el.classList.add('drag'); });
    addEventListener('pointermove', (e) => { if (!down) return; const dx = e.clientX - sx; if (Math.abs(dx) > 4) moved = true; set(sp - dx); });
    addEventListener('pointerup', () => { if (!down) return; down = false; el.classList.remove('drag'); hold(); });
    el.addEventListener('click', (e) => { if (moved) { e.preventDefault(); moved = false; } }, true);
    el.addEventListener('keydown', (e) => { if (e.key === 'ArrowRight') { set(pos + 240); hold(); } if (e.key === 'ArrowLeft') { set(pos - 240); hold(); } });
  });
</script>

  <section class="clients" aria-labelledby="cl-h">
    <div class="wrap cl-head"><h2 id="cl-h" class="label">{t('Trusted by · since 2019', 'وثقوا بي · منذ 2019')}</h2><span class="label muted cl-hint">{t('Drag or scroll →', 'اسحب أو مرّر ←')}</span></div>
    {[clients.filter((_, k) => k % 2 === 0), clients.filter((_, k) => k % 2 === 1)].map((row, r) => (
      <div class="cl-scroll" data-cl data-dir={r === 0 ? '1' : '-1'} tabindex="0" aria-label={t(`Client logos, row ${r + 1}, scrollable`, `شعارات العملاء، الصف ${r + 1}، قابلة للتمرير`)}>
        <ul class="cl-track">
          {[...row, ...row, ...row].map((c, k) => (
            <li aria-hidden={k >= row.length ? 'true' : undefined}>
              <a href={u(projects.some((x) => x.slug === c.slug) ? `/work/${c.slug}/` : '/work/')} class="cl" style={`--bc:${c.c}`} tabindex={k >= row.length ? -1 : undefined} draggable="false" data-cursor={t('Project', 'المشروع')}>
                {c.logo
                  ? <img src={c.logo} alt={c.n} class="logo-img" loading="lazy" decoding="async" draggable="false" />
                  : <span class="wmk" dir="ltr" style={`font-stretch:${c.w ?? 100}%;font-weight:${c.wt ?? 700};letter-spacing:${c.tr ?? '-.01em'};${c.lc ? 'text-transform:lowercase;' : ''}${c.it ? 'font-style:italic;' : ''}`}>{c.n}</span>}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </section>

  <section class="dark intro" aria-labelledby="intro-h">
    <div class="wrap ig">
      <div class="it">
        <h2 id="intro-h" class="sr-only">{t('Introduction', 'مقدمة')}</h2>
        {L.ar
          ? <p class="statement" data-scrub>أصمّم عمارة ومساحات داخلية تبدأ بفكرة أصيلة وتنتهي مكانًا مبنيًا. أفكار تُدهش، وتفاصيل تنجح في الموقع: <em>بيوت على ساحل مصر</em>، ومساكن فاخرة في المدن، و<em>مقرات رئيسية</em> من القاهرة إلى الرياض.</p>
          : <p class="statement" data-scrub>I design architecture and interiors that begin as an original idea and end as a built place. Concepts that surprise, details that work on site: <em>homes on Egypt’s coast</em>, luxury residences inland, and <em>corporate headquarters</em> from Cairo to Riyadh.</p>}
        <a href={u('/about/')} class="label link reveal more-l">{t('About me', 'عنّي')} <span class="arr">{L.next}</span></a>
      </div>
      <div class="collage" aria-hidden="true">
        <figure class="c1 clip para"><Image src={imagesFor('stc-hq')[1]} alt="" widths={[500, 900]} sizes="(min-width: 900px) 26vw, 60vw" data-parallax="0.12" data-scale="1.12" /></figure>
        <figure class="c2 clip para"><Image src={imagesFor('sabic-hq')[2]} alt="" widths={[400, 700]} sizes="(min-width: 900px) 18vw, 40vw" data-parallax="0.24" data-scale="1.12" /></figure>
        <figure class="c3 clip para"><Image src={imagesFor('neom-oxagon')[2]} alt="" widths={[400, 700]} sizes="(min-width: 900px) 20vw, 50vw" data-parallax="0.06" data-scale="1.12" /></figure>
      </div>
    </div>
  </section>

  <section class="dark nums" aria-labelledby="nums-h">
    <div class="wrap">
      <div class="sheet-head"><h2 id="nums-h" class="label">{t('In numbers', 'بالأرقام')}</h2><span class="label muted">2019 — {new Date().getFullYear()}</span></div>
      {stats.map((x) => (
        <div class="stat" data-sp>
          <p class="sr-only">{x.n} {x.l}. {x.d}</p>
          <span class="fig" aria-hidden="true"><span class="o" data-count={x.n}>{x.n}</span><span class="f" data-count={x.n}>{x.n}</span></span>
          <div class="sm" aria-hidden="true"><span class="t">{x.l}</span><span class="d">{x.d}</span></div>
          <figure class="th para" aria-hidden="true"><img src={x.img} alt="" width="480" height="360" loading="lazy" decoding="async" /></figure>
        </div>
      ))}
    </div>
  </section>

  <div class="curtain" data-sp>
    <section class="wrap feat" aria-labelledby="feat-h">
      <div class="sheet-head"><h2 id="feat-h" class="label">{t('Selected work', 'أعمال مختارة')}</h2><a href={u('/work/')} class="label link">{L.ar ? `جميع المشاريع المختارة (${projects.length}) ←` : `All ${projects.length} selected projects →`}</a></div>
      <div class="stack" data-stack>
        {feats.map((x, i) => (
          <a class="sc" href={u(`/work/${x.p.slug}/`)} style={`--i:${i}`} data-cursor={t('View', 'عرض')}>
            <div class="sci">
              <img srcset={x.srcset} src={x.src} sizes="(min-width: 1840px) 1700px, 92vw" width={x.w} height={x.h} alt={`${loc(x.p).title}, ${place(x.p)}`} loading="lazy" decoding="async" />
              {x.p.concept && <span class="tag flag">{t('Concept exploration', 'استكشاف مبدئي')}</span>}
              <div class="scm glass-dark">
                <div><h3>{loc(x.p).title}</h3><p class="label">{place(x.p)} · {loc(x.p).sector}</p></div>
                <span class="label go">{t('View project', 'اعرض المشروع')} <span class="arr">{L.next}</span></span>
              </div>
            </div>
          </a>
        ))}
      </div>
      <a href={u('/work/')} class="more reveal" data-cursor={t('Index', 'الفهرس')}><span class="display-m">{t('See all selected work', 'شاهد كل الأعمال المختارة')}</span><span class="label go">{t('Open the index', 'افتح الفهرس')} <span class="arr">{L.next}</span></span></a>
    </section>
  </div>




  <section class="dark duo">
    <div class="wrap">
      <div class="sheet-head"><h2 class="label">{t('Practice', 'الممارسة')}</h2><a href={u('/about/')} class="label link">{t('About me →', 'عنّي ←')}</a></div>
      <h2 class="display-l lines big"><span class="ln"><span>{t('Precision, vision,', 'دقة، ورؤية،')}</span></span><span class="ln"><span>{L.ar ? <><em>ونطاق</em> وحِرفة.</> : <><em>scale</em> and craft.</>}</span></span></h2>
      <div class="cols">
        <figure class="pfig clip para" aria-hidden="true"><Image src={imagesFor('sabic-hq')[3]} alt="" widths={[600, 1000, 1400]} sizes="(min-width: 860px) 45vw, 100vw" data-parallax="0.1" data-scale="1.14" /></figure>
        <div class="pill stagger">
          {(L.ar ? [['الدقة', 'تصاميم مبدئية مصممة لتُبنى، من نماذج Revit إلى رسومات التنفيذ.'], ['الرؤية', 'قراءة المتطلبات ومنحها فكرة واحدة واضحة.'], ['النطاق', 'مشاريع وطنية ومقرات شركات في أنحاء الخليج.'], ['الحِرفة', 'المادة والضوء والتفصيلة التي تجمعهما.']] : [['Precision', 'Concepts built to be built, from Revit models to IFC drawing sets.'], ['Vision', 'Reading the brief and giving it one clear idea.'], ['Scale', 'National projects and corporate headquarters across the Gulf.'], ['Craft', 'Material, light and the detail that holds them together.']]).map(([t, d], i) => (
            <div class="reveal"><h3>{t}</h3><p>{d}</p></div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <Reel dark rows={reelRows.map((r) => r.map((s) => cover(s)!))} links={reelRows.map((r) => r.map((s) => ({ href: u(`/work/${s}/`), title: loc(projects.find((p) => p.slug === s)!).title })))} />


  <script>
    const sv = document.querySelector<HTMLElement>('[data-svc]');
    if (sv) {
      const ims = [...sv.querySelectorAll<HTMLElement>('[data-si]')];
      const show = (i: number) => { ims.forEach((im, j) => im.classList.toggle('on', j === i)); };
      sv.querySelectorAll<HTMLElement>('[data-sv]').forEach((a) => { const i = +a.dataset.sv!; a.addEventListener('mouseenter', () => show(i)); a.addEventListener('focus', () => show(i)); });
    }
  </script>
</Base>

<style>
  .hero { position: relative; height: var(--hero-h); color: var(--ow); overflow: hidden; background: var(--night); }
  .slides { position: absolute; inset: 0; }
