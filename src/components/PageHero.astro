---
/* Dark page hero for inner pages: drafting grid, an image panel that wipes in (and cross-fades when given several),
   a large title, and a meta row. As the page scrolls, the panel drifts and the content lifts away (data-sp="out"). */
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { eyebrow?: string; code?: string; images?: ImageMetadata[]; alt?: string; meta?: [string, string][]; compact?: boolean }
const { eyebrow, code, images = [], alt = '', meta = [], compact = false } = Astro.props;
const pics = await Promise.all(images.slice(0, 4).map(async (img) => {
  const set = await Promise.all([640, 1000, 1400, 1900].map(async (w) => `${(await getImage({ src: img, width: w, format: 'webp', quality: 68 })).src} ${w}w`));
  return { srcset: set.join(', '), src: set[1].split(' ')[0], w: img.width, h: img.height };
}));
---
<section class:list={['ph dark', { compact, noimg: !pics.length }]} data-sp="out" data-ph>
  <svg class="grid" aria-hidden="true" preserveAspectRatio="none" viewBox="0 0 100 100">
    {[12.5, 25, 37.5, 50, 62.5, 75, 87.5].map((x, i) => <line x1={x} y1="0" x2={x} y2="100" style={`--d:${i * 0.06}s`} />)}
    {[33.3, 66.6].map((y, i) => <line class="h" x1="0" y1={y} x2="100" y2={y} style={`--d:${0.3 + i * 0.1}s`} />)}
  </svg>
  {pics.length > 0 && (
    <div class="panel" aria-hidden={alt ? undefined : 'true'}>
      <div class="drift">
        {pics.map((p, i) => i === 0
          ? <img class="im on" srcset={p.srcset} src={p.src} sizes="(min-width: 900px) 58vw, 100vw" width={p.w} height={p.h} alt={alt} fetchpriority="high" decoding="async" />
          : <img class="im" data-srcset={p.srcset} sizes="(min-width: 900px) 58vw, 100vw" width={p.w} height={p.h} alt="" decoding="async" />)}
      </div>
    </div>
  )}
  <div class="wrap in">
    <div class="top"></div>
    <div class="ttl"><slot /></div>
    {meta.length > 0 && (
      <dl class="meta">{meta.map(([k, v]) => <div><dt class="label muted">{k}</dt><dd>{v}</dd></div>)}</dl>
    )}
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-ph]').forEach((ph) => {
    const ims = [...ph.querySelectorAll<HTMLElement>('.im')];
    if (ims.length < 2 || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    // the other slides load only after the page has finished loading, so they never compete with the first picture
    const later = () => ph.querySelectorAll<HTMLImageElement>('img[data-srcset]').forEach((im) => { im.srcset = im.dataset.srcset!; im.removeAttribute('data-srcset'); });
    if (document.readyState === 'complete') setTimeout(later, 600); else addEventListener('load', () => setTimeout(later, 600), { once: true });
    let i = 0;
    setInterval(() => { if (document.hidden) return; ims[i].classList.remove('on'); i = (i + 1) % ims.length; ims[i].classList.add('on'); }, 4200);
  });
</script>

<style>
  .ph { position: relative; overflow: hidden; height: var(--hero-h); display: grid; isolation: isolate; border-radius: 0 0 var(--r-xl) var(--r-xl); }
  .ph.noimg { border-radius: 0; }
  /* drafting grid: hairlines draw in from the top */
  .grid { position: absolute; inset: 0; width: 100%; height: 100%; z-index: -1; pointer-events: none; }
  .grid line { stroke: rgba(243, 237, 227, .07); stroke-width: 1px; vector-effect: non-scaling-stroke; stroke-dasharray: 100; stroke-dashoffset: 100; animation: gl 1.6s var(--ease-io) forwards; animation-delay: var(--d); }
  .grid line.h { stroke: rgba(243, 237, 227, .05); }
  @keyframes gl { to { stroke-dashoffset: 0; } }
  /* image panel: right side on desktop, full bleed under a veil on mobile */
  .panel { position: absolute; z-index: 0; top: calc(84px + env(safe-area-inset-top, 0px)); bottom: clamp(14px, 1.6vw, 24px); right: max(clamp(10px, 1.2vw, 20px), env(safe-area-inset-right, 0px)); width: 55%; overflow: hidden; border-radius: var(--r-xl); clip-path: inset(0 0 0 100% round var(--r-xl)); animation: wipe 1.4s .15s var(--ease-io) forwards; }
  @keyframes wipe { to { clip-path: inset(0 0 0 0 round var(--r-xl)); } }
  .drift { position: absolute; inset: -6% 0; transform: translate3d(0, calc(var(--sp, 0) * 14%), 0); }
  .im { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transform: scale(1.14); transition: opacity 1.4s var(--ease), transform 7s linear; }
  .im.on { opacity: 1; transform: scale(1.02); }
  .panel::after { content: ""; position: absolute; inset: 0; background: rgba(32, 28, 27, .28); }
  .tick { position: absolute; z-index: 2; width: 22px; height: 22px; border: 0 solid rgba(243, 237, 227, .7); }
  .t1 { border-top-left-radius: 12px; } .t2 { border-bottom-right-radius: 12px; }
  .t1 { left: 22px; top: 22px; border-left-width: 1px; border-top-width: 1px; }
  .t2 { right: 22px; bottom: 22px; border-right-width: 1px; border-bottom-width: 1px; }
  .cnt { position: absolute; z-index: 2; right: 56px; bottom: 24px; color: rgba(243, 237, 227, .8); font-variant-numeric: tabular-nums; }
  .cnt b { font-weight: 400; color: var(--ow); }
  .in { position: relative; z-index: 3; display: grid; grid-template-rows: auto 1fr auto; gap: 28px; padding-top: calc(112px + env(safe-area-inset-top, 0px)); padding-bottom: clamp(28px, 4vw, 52px); opacity: calc(1 - var(--sp, 0) * 1.2); transform: translate3d(0, calc(var(--sp, 0) * -60px), 0); }
  .top { display: flex; justify-content: space-between; gap: 20px; color: rgba(243, 237, 227, .78); max-width: 44%; animation: fadeup .9s .3s var(--ease) both; }
  .noimg .top { max-width: none; }
  .eb { display: inline-flex; align-items: center; gap: 12px; }
  .eb i { width: 28px; height: 1px; background: currentColor; }
  .code { color: var(--muted-dark); }
  .ttl { align-self: end; display: grid; gap: 26px; }
  .noimg .ttl { max-width: 100%; }
  .ttl :global(h1) { font-size: clamp(58px, 9.6vw, 176px); line-height: .9; text-shadow: 0 1px 30px rgba(32, 28, 27, .25); }
  .ttl :global(em) { color: var(--sand); }
  .ttl :global(.lede) { max-width: min(30em, 35vw); animation: fadeup 1s .45s var(--ease) both; }
  .meta { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 18px 32px; margin: 0; padding-top: 18px; border-top: 1px solid var(--rule-light); max-width: 37%; animation: fadeup 1s .55s var(--ease) both; }
  .meta div { display: grid; gap: 4px; }
  .meta dd { margin: 0; font: 400 20px/1.25 var(--display); }
  @keyframes fadeup { from { opacity: 0; transform: translateY(14px); } }
  .cue { position: absolute; right: max(var(--gut), env(safe-area-inset-right, 0px)); bottom: clamp(28px, 4vw, 52px); display: none; }
  .noimg .cue { display: inline-flex; align-items: center; gap: 12px; color: var(--muted-dark); }
  .cue i { width: 1px; height: 44px; background: rgba(243, 237, 227, .3); position: relative; overflow: hidden; }
  .cue i::after { content: ""; position: absolute; left: 0; right: 0; height: 40%; background: var(--ow); animation: cue 2s var(--ease-io) infinite; }
  @keyframes cue { from { transform: translateY(-100%); } to { transform: translateY(260%); } }
  @media (max-width: 900px) {
    .panel { width: auto; left: max(10px, env(safe-area-inset-left, 0px)); right: max(10px, env(safe-area-inset-right, 0px)); top: calc(76px + env(safe-area-inset-top, 0px)); bottom: 10px; }
    .panel::after { background: rgba(32, 28, 27, .62); }
    .top, .ttl, .meta, .ttl :global(.lede) { max-width: none; }
    .tick { display: none; }
    .cnt { right: auto; left: max(var(--gut), env(safe-area-inset-left, 0px)); top: 92px; bottom: auto; display: none; }
  }
  @media (prefers-reduced-motion: reduce) { .panel { clip-path: none; animation: none; } .grid line { stroke-dashoffset: 0; } }
</style>
