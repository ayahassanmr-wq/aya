---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Reel from '../components/Reel.astro';
import { imagesFor, cover } from '../data/projects';
import { i18n } from '../i18n';
const L = i18n(Astro.url);
const { t } = L;
const side = imagesFor('sabic-hq')[1];
const timelineEn = [
  { y: '2026 — now', r: 'Mid-senior Design Architect', o: 'Innovation Design Studio', d: 'Architectural concepts, 3D modelling and visuals for residential developments by SODIC, Orascom, Misr Italia and Travco on the North Coast and in Greater Cairo, with AI-assisted post-production.' },
  { y: '2025', r: 'Mid-senior Design Architect & Interior Designer', o: 'Cosmos Studio', d: 'Commercial and industrial architecture: Fifth Square, the Chery showroom and admin building, the NOATUM automotive terminal, Linah Farms and the Mazeej hotel and housing redesign, through to Revit (BIM) packages.' },
  { y: '2024', r: 'Design Architect & Interior Designer', o: 'ZFP · Zuhair Fayez Partnership', d: 'Headquarters interiors for SABIC and STC in Riyadh: design concepts, 3D modelling and visuals, material selection through site visits and vendor collaboration, and furniture and fixtures sourced from suppliers worldwide.' },
  { y: '2020 — 2023', r: 'Design Architect & Interior Designer', o: 'Cosmos Studio', d: 'BIM development for NEOM public service buildings; 3D modelling, animation and promotional content for NEOM Oxagon and Um Qasr Logistic City; interior concepts and schematic packages for Sphinx, HB Fuller, Jotun and Tech Park.' },
  { y: '2014 — 2019', r: 'B.Sc. Architectural Engineering', o: 'Future University in Egypt', d: 'Graduation project grade A−.' },
];
const timelineAr = [
  { y: '2026 — الآن', r: 'معمارية تصميم (مستوى متوسط-أول)', o: 'إنوفيشن ديزاين ستوديو', d: 'تصاميم معمارية مبدئية ونمذجة ثلاثية الأبعاد وإظهار لمشاريع سكنية لسوديك وأوراسكوم ومصر إيطاليا وترافكو في الساحل الشمالي والقاهرة الكبرى، مع معالجة نهائية بمساعدة الذكاء الاصطناعي.' },
  { y: '2025', r: 'معمارية تصميم ومصممة داخلية (مستوى متوسط-أول)', o: 'كوزموس ستوديو', d: 'عمارة تجارية وصناعية: فيفث سكوير، ومعرض شيري ومبناها الإداري، ومحطة نواتوم للسيارات، ولينة فارمز، وإعادة تصميم مجمع مزيج الفندقي والسكني، حتى حزم Revit (BIM).' },
  { y: '2024', r: 'معمارية تصميم ومصممة داخلية', o: 'زهير فايز ومشاركوه · ZFP', d: 'التصميم الداخلي لمقرّي سابك وstc في الرياض: الأفكار التصميمية والنمذجة والإظهار، واختيار المواد عبر الزيارات الميدانية والتعاون مع الموردين، وتوريد الأثاث والتجهيزات من موردين حول العالم.' },
  { y: '2020 — 2023', r: 'معمارية تصميم ومصممة داخلية', o: 'كوزموس ستوديو', d: 'تطوير BIM لمباني الخدمات العامة في نيوم؛ ونمذجة وتحريك ومحتوى ترويجي لأوكساجون ومدينة أم قصر اللوجستية؛ وأفكار داخلية وحزم تخطيطية لسفنكس وإتش بي فولر وجوتن وتك بارك.' },
  { y: '2014 — 2019', r: 'بكالوريوس الهندسة المعمارية', o: 'جامعة المستقبل في مصر', d: 'مشروع التخرج بتقدير A−.' },
];
const timeline = L.ar ? timelineAr : timelineEn;
const toolsEn = [
  ['Design & BIM', 'AutoCAD, Revit, Navisworks, BIM 360, Rhino, Grasshopper, SketchUp'],
  ['Visualization', '3ds Max, V-Ray, Corona, Lumion, AI-assisted concept tools'],
  ['Presentation', 'Photoshop, InDesign, Premiere, After Effects'],
  ['Languages', 'Arabic (native), English (fluent)'],
];
const tools = L.ar ? [
  ['التصميم وBIM', 'AutoCAD، Revit، Navisworks، BIM 360، Rhino، Grasshopper، SketchUp'],
  ['الإظهار', '3ds Max، V-Ray، Corona، Lumion، أدوات التصميم المبدئي بالذكاء الاصطناعي'],
  ['العرض', 'Photoshop، InDesign، Premiere، After Effects'],
  ['اللغات', 'العربية (اللغة الأم)، الإنجليزية (بطلاقة)'],
] : toolsEn;
---
<Base title={t('About', 'عنّي')} description={t('Aya Hassan, mid-senior design architect at Innovation Design Studio. Previously ZFP and Cosmos Studio, with work at NEOM, SABIC HQ and STC HQ.', 'آية حسن، معمارية تصميم في إنوفيشن ديزاين ستوديو. عملت سابقًا في ZFP وكوزموس ستوديو، ومن أعمالها نيوم ومقرّا سابك وstc.')}>
  <PageHero images={[imagesFor('stc-hq')[3], imagesFor('sabic-hq')[3], imagesFor('neom-oxagon')[1]]} alt={t('Interior of the stc headquarters', 'التصميم الداخلي لمقر stc')} meta={L.ar ? [['الدور', 'معمارية تصميم'], ['الاستوديو', 'إنوفيشن ديزاين ستوديو'], ['منذ', '2020'], ['التعليم', 'بكالوريوس العمارة']] : [['Role', 'Design Architect'], ['Studio', 'Innovation Design Studio'], ['Since', '2020'], ['Education', 'B.Sc. Architecture']]}>
    <h1 class="display-xl lines"><span class="ln"><span>{t('Aya', 'آية')}</span></span><span class="ln"><span><em>{t('Hassan.', 'حسن.')}</em></span></span></h1>
    <p class="lede">{t('Architect and interior designer in concept design. Gulf-scale work, from NEOM to the headquarters of SABIC and stc.', 'معمارية ومصممة داخلية في مرحلة التصميم المبدئي. أعمال بحجم الخليج، من نيوم إلى مقرّي سابك وstc.')}</p>
  </PageHero>

  <section class="wrap bio">
    <figure class="reveal para"><Image data-parallax="0.1" data-scale="1.15" src={side} alt={t('SABIC headquarters atrium interior', 'أتريوم المقر الرئيسي لسابك')} widths={[600, 1000]} sizes="(min-width: 900px) 40vw, 100vw" /></figure>
    <div class="txt">
      <p class="statement reveal">{t('A concept is only useful once someone believes in it.', 'لا قيمة للفكرة حتى يؤمن بها أحد.')}</p>
      {L.ar ? <p class="reveal">آية معمارية ومصممة داخلية تعمل في التصميم المبدئي. تعمل حاليًا معمارية تصميم في إنوفيشن ديزاين ستوديو على مشاريع سكنية لسوديك وأوراسكوم ومصر إيطاليا وترافكو. وقبل ذلك عملت معمارية تصميم ومصممة داخلية في زهير فايز ومشاركوه (ZFP)، حيث شاركت في تشكيل التصميم الداخلي لمقرّي سابك وstc في الرياض، وأمضت أربع سنوات في كوزموس ستوديو في العمارة والتصميم الداخلي وBIM، منها مباني الخدمات العامة في نيوم، ثم عادت إليه في 2025 لمشاريع تجارية وصناعية.</p> : <p class="reveal">Aya is an architect and interior designer working in concept design. She is a mid-senior design architect at Innovation Design Studio, on residential developments for SODIC, Orascom, Misr Italia and Travco. Before that she was a design architect and interior designer at ZFP (Zuhair Fayez Partnership), shaping the headquarters interiors of SABIC and STC in Riyadh, and spent 2020–2023 at Cosmos Studio as a design architect and interior designer, on architecture, interiors and BIM, including public service buildings at NEOM, returning in 2025 as a mid-senior design architect and interior designer for commercial and industrial work.</p>}
      <p class="reveal">{t('The projects on this site are a selection of that work, not the full record.', 'المشاريع المعروضة هنا مختارات من هذا العمل، لا سجله الكامل.')}</p>
      <p class="reveal">{t('Her work covers the full concept stage: the idea, the 3D model, the visuals and animation that win approval, and the drawing packages and material selections that make it buildable.', 'يغطي عملها مرحلة التصميم المبدئي كاملة: الفكرة، والنموذج ثلاثي الأبعاد، والإظهار والتحريك اللذين يكسبان الموافقة، وحزم الرسومات واختيارات المواد التي تجعله قابلًا للتنفيذ.')}</p>
      <div class="dl reveal" style="display:flex;flex-wrap:wrap;gap:12px"><a href="/Aya_Hassan_CV.pdf" class="btn" download>{t('Download CV', 'حمّل السيرة الذاتية')} <span class="arr">↓</span></a><a href="/Aya_Hassan_Portfolio.pdf" class="btn" download>{t('Download portfolio (PDF)', 'حمّل ملف الأعمال (PDF)')} <span class="arr">↓</span></a></div>
    </div>
  </section>

  <Reel rows={[['sabic-hq', 'neom-oxagon', 'hb-fuller', 'modern-residence-new-cairo', 'mazeej', 'conference-room', 'dry-port'].map((s) => cover(s)!)]} />

  <section class="dark tl sheet" data-sp><div class="wrap">
    <div class="sheet-head"><span class="label">{t('Experience & education', 'الخبرة والتعليم')}</span></div>
    {timeline.map((t) => (
      <div class="row reveal">
        <span class="label muted yr">{t.y}</span>
        <div><h2 class="display-m">{t.r}</h2><p class="label org">{t.o}</p></div>
        <p class="d">{t.d}</p>
      </div>
    ))}
  </div></section>

  <section class="wrap tools">
    <div class="sheet-head"><span class="label">{t('Tools', 'الأدوات')}</span></div>
    <dl>{tools.map(([k, v]) => <div class="reveal"><dt class="label muted">{k}</dt><dd>{v}</dd></div>)}</dl>
  </section>
</Base>

<style>
  .bio { display: grid; grid-template-columns: 5fr 7fr; gap: clamp(32px, 6vw, 110px); padding-top: clamp(80px, 10vw, 150px); padding-bottom: clamp(80px, 10vw, 150px); align-items: start; }
  .bio figure { margin: 0; aspect-ratio: 4 / 5; overflow: hidden; }
  .bio figure :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .txt { display: grid; gap: 24px; max-width: 60ch; }
  .txt p:not(.statement) { color: var(--ink-2); }
  .statement { font: italic 400 clamp(30px, 3.4vw, 50px)/1.15 var(--display); color: var(--ox); }
  .txt .btn { justify-self: start; margin-top: 12px; }
  @media (max-width: 860px) { .bio { grid-template-columns: 1fr; } .bio figure { aspect-ratio: 16 / 10; } }
  .tl { padding-block: clamp(64px, 8vw, 120px); }
  .tools { padding-block: clamp(64px, 8vw, 120px); }
  .row { transition: padding .5s var(--ease); } .row:hover { padding-left: 14px; }
  .dark .d { color: rgba(243,237,227,.72); } .dark .org { color: var(--sand); }
  .row { display: grid; grid-template-columns: 160px 1.2fr 1.3fr; gap: 24px clamp(24px, 4vw, 64px); padding-block: 32px; border-bottom: 1px solid var(--rule); }
  .org { color: var(--ox); margin-top: 10px; }
  .d { color: var(--ink-2); font-size: 16px; }
  @media (max-width: 900px) { .row { grid-template-columns: 1fr; gap: 10px; } }
  dl { margin: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 0 48px; }
  dl div { display: grid; grid-template-columns: 150px 1fr; gap: 16px; padding-block: 20px; border-bottom: 1px solid var(--rule); }
  dd { margin: 0; }
  @media (max-width: 800px) { dl { grid-template-columns: 1fr; } dl div { grid-template-columns: 1fr; gap: 4px; } }
</style>
