---
/* Shared A4-landscape print book for the Selected Works PDF and the full Portfolio PDF.
   Per project: cover (full-bleed render + title-block overlay) → full-screen render → how it was decided
   (featured only) → studies, one per page → plans, one per page → remaining renders as a grid.
   `full` = every project, index and higher image quality (Portfolio); otherwise the curated Selected Works. */
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/archivo/wdth-italic.css';
import { getImage } from 'astro:assets';
import { projects, imagesFor, fileFor, disciplinesFor, countries, contact, projectNo, clientLogo, sectorGroups, type Project } from '../data/projects';

interface Props { full: boolean }
const { full } = Astro.props;
const Q = full ? 80 : 60;
const W = { bleed: full ? 2200 : 1000, half: full ? 1400 : 640, sheet: full ? 2200 : 1100, step: full ? 1200 : 560 };
const jpg = async (src: any, w: number) => (src ? (await getImage({ src, width: Math.min(w, src.width), format: 'jpg', quality: Q })).src : '');
const practice = (p: Project) => p.practice === 'ZFP' ? 'ZFP · Zuhair Fayez Partnership' : p.practice ?? 'Independent practice';
const place = (p: Project) => p.location === p.country || p.location.includes(p.country) ? p.location : `${p.location}, ${p.country}`;
const P = (s: string) => projects.find((p) => p.slug === s)!;
const diag = import.meta.glob<{ default: any }>('../assets/diagrams/*.jpg', { eager: true });
const img = (slug: string, f: string) => f.startsWith('x:') ? diag[`../assets/diagrams/${f.slice(2)}.jpg`]?.default : fileFor(slug, f);

const think: Record<string, [string, string][]> = {
  'travco-west-island': [['Brief: a premier coastal destination with maximum sea views, hospitality-level living and respect for the landscape', '05'], ['Idea: orient for wind and water', 'd04'], ['Plan: from an empty plot to four units', 'd03'], ['Approved; under construction', '01']],
  'misr-italia-hilltop': [['Brief: luxury coastal living around the lagoon', '01'], ['Problem: the concept draft showed a building, not a lifestyle', '04'], ['My enhancements: materials, details, façade', '02'], ['Approved; under construction', '03']],
  'staff-housing': [['Tension: density vs quality of life vs budget', 'd03'], ['Courtyard clusters on a town-wide pedestrian network', 'd02'], ['Two repeatable prototypes for cost and speed', 'd05'], ['Nubian arches, shade, earth', 'd01']],
  'sodic-east-vale': [['Brief: private sanctuaries, daylight, ventilation, views', '03'], ['Decision I argued for: private quarters apart from reception (oxblood = private, sand = reception)', 'x:east-vale-zones'], ['High ceilings, fluid inside–outside', '02'], ['Under construction', '01']],
  'sabic-hq': [['Brief: turn an outdated HQ into a dynamic, collaborative, brand-led one', '04'], ['Constraint: an existing slab protrusion', '01'], ['Decision: make it the feature — the atrium planters', '02'], ['Under construction', '03']],
  'stc-hq': [['Brief: futuristic, recognisable, minimal', '01'], ['Site: the tower’s huge curves (oxblood = curve zones)', 'x:stc-curves'], ['Decision: curves become destinations', '02'], ['My concept became the team’s base', '05']],
};
const studyNos: Record<string, number[]> = { 'travco-west-island': [4], 'staff-housing': [1, 2, 3], 'sallan-creek': [1, 2], 'sodic-east-vale': [1], 'sodic-ogami': [1], 'fifth-square': [1], 'neom-oxagon': [1], 'chery-showroom': [1], 'linah-farms': [1], 'dry-port': [3] };
const trimmed = import.meta.glob<{ default: any }>('../assets/print/*/d*.jpg', { eager: true });
const sheetsFor = (slug: string) => Object.keys(trimmed).filter((k) => k.includes(`/print/${slug}/`)).sort().map((k) => ({ no: Number(k.match(/d(\d+)\.jpg$/)![1]), m: trimmed[k].default }));

// ---- what goes in
const selArch = ['travco-west-island', 'misr-italia-hilltop', 'staff-housing', 'sallan-creek', 'sodic-east-vale', 'sodic-ogami', 'orascom-o-west', 'chery-showroom', 'fifth-square', 'mazeej', 'neom-oxagon'];
const selInt = ['sabic-hq', 'stc-hq', 'suits-workspaces', 'modern-residence-new-cairo', 'hb-fuller', 'sphinx', 'jotun-office', 'tech-park', 'conference-room', 'bmw-showroom'];
const ord = (c: Project['category']) => sectorGroups(projects.filter((p) => p.category === c)).flatMap((g) => g.list).map((p) => p.slug);
const sections = [
  { n: '01', name: 'Architecture', slugs: full ? ord('architecture') : selArch },
  { n: '02', name: 'Interiors', slugs: full ? ord('interiors') : selInt },
];

const build = async (slug: string, k: number) => {
  const p = P(slug), imgs = imagesFor(slug), sh = sheetsFor(slug), st = studyNos[slug] ?? [];
  const steps = think[slug] ? await Promise.all(think[slug].map(async ([t, f]) => ({ t, d: f.startsWith('d') || f.startsWith('x:'), src: await jpg(img(slug, f), W.step) }))) : [];
  const sheet = async (x: { no: number; m: any }) => ({ no: x.no, w: x.m.width, h: x.m.height, src: await jpg(x.m, W.sheet) });
  const rest = await Promise.all(imgs.slice(2, 5).map((x) => jpg(x, W.half)));
  return {
    p, code: full ? projectNo(slug) : String(k + 1).padStart(2, '0'), logo: clientLogo(slug), disc: [...disciplinesFor(p)],
    cover: await jpg(imgs[0], W.bleed), hero: imgs[1] ? await jpg(imgs[1], W.bleed) : '', steps,
    studies: await Promise.all(sh.filter((x) => st.includes(x.no)).map(sheet)),
    plans: await Promise.all(sh.filter((x) => !st.includes(x.no)).map(sheet)),
    rest,
  };
};
const secs = await Promise.all(sections.map(async (s) => ({ ...s, items: await Promise.all(s.slugs.map(build)) })));

// ---- page numbers (front: cover, about, clients, [index], contents)
const front = full ? 5 : 4;
const pagesOf = (it: any) => 1 + (it.hero ? 1 : 0) + (it.steps.length ? 1 : 0) + it.studies.length + it.plans.length + (it.rest.length ? 1 : 0);
let pg = front; const startOf: Record<string, number> = {};
for (const s of secs) { pg += 1; for (const it of s.items) { startOf[it.p.slug] = pg + 1; pg += pagesOf(it); } }
pg += 2; // delivery divider + card
const total = pg + 1;
let pn = 0; const N = () => String(++pn).padStart(2, '0'); const T = String(total).padStart(2, '0');
let sheetNo = 0; const nextSheet = () => `A-${String(++sheetNo).padStart(3, '0')}`;

const coverImg = await jpg(imagesFor(full ? 'misr-italia-hilltop' : 'travco-west-island')[0], W.bleed);
const aboutImg = await jpg(imagesFor('sabic-hq')[1], W.half);
const backImg = await jpg(imagesFor(full ? 'travco-west-island' : 'misr-italia-hilltop')[0], W.bleed);
const clients = ['sodic', 'orascom', 'misr-italia', 'travco', 'neom', 'stc', 'sabic', 'jotun', 'bmw', 'chery', 'hb-fuller', 'al-marasem', 'guira', 'linah'];
const typed = ['NOATUM', 'Suits Workspaces'];
const now = new Date(); const year = now.getFullYear();
const month = now.toLocaleString('en-GB', { month: 'long' });
const shown = secs.reduce((a, s) => a + s.items.length, 0);
const label = full ? 'Portfolio' : 'Selected Works';
const fitBox = (w: number, h: number, bw: number, bh: number) => { const s = Math.min(bw / w, bh / h); return `width:${(w * s).toFixed(1)}mm;height:${(h * s).toFixed(1)}mm`; };
const restClass = (n: number) => `r${n}`;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="robots" content="noindex" />
<title>Aya Hassan — {label}</title>
<style is:global>
  @page { size: 297mm 210mm; margin: 0; }
  :root { --bone: #F3EDE3; --ink: #2B2826; --night: #201C1B; --ox: #5E1A24; --sand: #D6CBBE; --mut: #8C857D; --rule: rgba(43,40,38,.2); }
  * { box-sizing: border-box; }
  html, body { margin: 0; background: #777; }
  body { font-family: "Archivo Variable", sans-serif; color: var(--ink); -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  a { color: inherit; text-decoration: none; }
  h1, h2, h3, p, dl, dd, figure { margin: 0; }
  .pg { width: 297mm; height: 210mm; position: relative; overflow: hidden; background: var(--bone); page-break-after: always; break-after: page; }
  .dark { background: var(--night); color: var(--bone); }
  .lab { font-size: 6.8pt; font-weight: 500; letter-spacing: .2em; text-transform: uppercase; }
  .ox { color: var(--ox); } .mut { color: var(--mut); } .sand { color: var(--sand); }
  .wide { font-weight: 800; font-stretch: 125%; letter-spacing: -.025em; line-height: .95; }
  .wm { font-weight: 800; font-stretch: 125%; letter-spacing: .02em; display: inline-flex; align-items: center; gap: 2.2mm; }
  .wm i { width: .5pt; height: 1em; background: currentColor; display: inline-block; }
  .bleed { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .foot { position: absolute; left: 12mm; right: 12mm; bottom: 8mm; display: flex; justify-content: space-between; align-items: center; font-size: 6.6pt; }
  .foot .wm { font-size: 7pt; }
  .on { color: var(--bone); }
  .shade { position: absolute; inset: auto 0 0 0; height: 30mm; background: linear-gradient(transparent, rgba(32,28,27,.6)); }

  /* cover */
  .cover .veil { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(32,28,27,.55) 0%, rgba(32,28,27,.05) 30%, rgba(32,28,27,.15) 55%, rgba(32,28,27,.82) 100%); }
  .cover .top { position: absolute; top: 14mm; left: 16mm; right: 16mm; display: flex; justify-content: space-between; align-items: baseline; color: var(--bone); }
  .cover .top .wm { font-size: 20pt; }
  .cover .tag { position: absolute; left: 16mm; bottom: 34mm; color: var(--bone); font-size: 52pt; }
  .cover .tag em { display: block; font-style: italic; font-weight: 200; font-stretch: 100%; letter-spacing: -.02em; margin-top: 2mm; }
  .cover .bot { position: absolute; left: 16mm; right: 16mm; bottom: 13mm; padding-top: 4mm; border-top: .5pt solid rgba(243,237,227,.5); display: flex; justify-content: space-between; color: var(--bone); }
  .cover .bot nav { display: flex; gap: 8mm; }

  /* about */
  .about { display: grid; grid-template-columns: 112mm 1fr; }
  .about .ph { position: relative; }
  .about .tx { padding: 22mm 22mm 24mm 20mm; display: flex; flex-direction: column; }
  .about h2 { font-size: 24pt; margin: 6mm 0 9mm; max-width: 140mm; }
  .about .bio { font-size: 10.6pt; line-height: 1.62; max-width: 138mm; }
  .about .nums { margin-top: auto; display: grid; grid-template-columns: repeat(3, 1fr); border-top: .5pt solid var(--ink); }
  .about .nums div { padding: 4mm 4mm 0 0; }
  .about .nums b { display: block; font-size: 32pt; font-weight: 800; font-stretch: 125%; color: var(--ox); line-height: 1; margin-bottom: 2mm; }

  /* clients + index */
  .clients, .index { padding: 16mm 18mm 22mm; }
  .head { display: flex; justify-content: space-between; align-items: baseline; border-bottom: .5pt solid var(--ink); padding-bottom: 4mm; margin-bottom: 10mm; }
  .head h2 { font-size: 26pt; }
  .lg { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0; border-top: .5pt solid var(--rule); border-left: .5pt solid var(--rule); }
  .lg div { height: 30mm; display: flex; align-items: center; justify-content: center; border-right: .5pt solid var(--rule); border-bottom: .5pt solid var(--rule); }
  .lg img { max-width: 34mm; max-height: 13mm; object-fit: contain; }
  .lg span { font-weight: 700; font-stretch: 112%; font-size: 10pt; }
  .ix { display: grid; grid-template-columns: 1fr 1fr; gap: 0 14mm; }
  .ix h3 { font-size: 7pt; letter-spacing: .22em; text-transform: uppercase; color: var(--ox); margin-bottom: 3mm; }
  .ix ol { list-style: none; padding: 0; margin: 0; }
  .ix li { display: grid; grid-template-columns: 9mm 1fr auto 10mm; gap: 2mm; padding: 1.6mm 0; border-bottom: .5pt solid var(--rule); font-size: 8.4pt; align-items: baseline; }
  .ix li .c { color: var(--ox); font-weight: 700; } .ix li .m { color: var(--mut); font-size: 7pt; } .ix li .n { text-align: right; font-weight: 700; }

  /* contents + dividers */
  .contents { padding: 18mm 18mm; }
  .contents .rows { position: absolute; left: 18mm; right: 18mm; bottom: 26mm; }
  .contents .row { display: grid; grid-template-columns: 34mm 1fr auto; align-items: baseline; padding: 6mm 0; border-top: .5pt solid rgba(243,237,227,.35); }
  .contents .row b { font-size: 30pt; font-weight: 800; font-stretch: 125%; color: var(--sand); }
  .contents .row span.t { font-size: 34pt; }
  .divider .big { position: absolute; left: 16mm; bottom: 44mm; font-size: 120pt; color: var(--sand); }
  .divider h2 { position: absolute; left: 18mm; bottom: 24mm; font-size: 34pt; }

  /* project cover */
  .pc .veil { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(32,28,27,.05) 40%, rgba(32,28,27,.55) 100%), linear-gradient(180deg, rgba(32,28,27,.25), transparent 25%); }
  .pc .ghost { position: absolute; left: 12mm; top: 4mm; font-size: 150pt; color: transparent; -webkit-text-stroke: 1.2pt rgba(243,237,227,.95); filter: drop-shadow(0 0 6px rgba(32,28,27,.35)); }
  .pc .sec { position: absolute; left: 14mm; bottom: 12mm; color: var(--bone); }
  .tb { position: absolute; right: 12mm; top: 12mm; bottom: 12mm; width: 98mm; background: rgba(243,237,227,.94); display: flex; flex-direction: column; border: .5pt solid var(--ink); }
  .tb > div { padding: 4mm 5mm; border-bottom: .5pt solid var(--ink); }
  .tb .no { display: flex; justify-content: space-between; align-items: flex-start; }
  .tb .no b { font-size: 34pt; font-weight: 800; font-stretch: 125%; color: var(--ox); line-height: .9; }
  .tb .rt { border: .6pt solid var(--ox); color: var(--ox); padding: .8mm 2mm; font-size: 6.4pt; letter-spacing: .14em; font-weight: 700; }
  .tb h2 { font-size: 17pt; line-height: 1; }
  .tb .role { font-size: 9.4pt; line-height: 1.38; font-weight: 600; }
  .tb .sum { font-size: 8.2pt; line-height: 1.45; color: #4a4542; margin-top: 2.5mm; font-weight: 400; }
  .tb .cells { display: grid; grid-template-columns: 1fr 1fr; padding: 0; align-content: start; }
  .tb .cells > div { padding: 3mm 5mm; border-bottom: .5pt solid var(--rule); }
  .tb .cells > div:nth-child(odd) { border-right: .5pt solid var(--rule); }
  .tb .cells .w { grid-column: 1 / -1; border-right: 0 !important; }
  .tb dt { font-size: 5.8pt; letter-spacing: .2em; text-transform: uppercase; color: var(--mut); margin-bottom: 1mm; }
  .tb dd { font-size: 8.2pt; display: flex; align-items: center; gap: 2.5mm; }
  .tb dd img { max-height: 6mm; max-width: 22mm; object-fit: contain; }
  .tb .ft { margin-top: auto; border-bottom: 0; display: flex; justify-content: space-between; align-items: center; }

  /* how it was decided: 2 × 2 */
  .dec { display: grid; grid-template-columns: 1fr 1fr; grid-template-rows: 1fr 1fr; gap: 2mm; padding: 2mm; background: var(--night); }
  .dec .q { position: relative; overflow: hidden; background: var(--bone); }
  .dec .q img.r { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .dec .q img.d { position: absolute; left: 6mm; right: 6mm; top: 22mm; bottom: 5mm; width: calc(100% - 12mm); height: calc(100% - 27mm); object-fit: contain; }
  .dec .cap { position: absolute; left: 0; top: 0; max-width: 92%; background: var(--bone); padding: 3mm 5mm 3.2mm 4mm; display: flex; gap: 3.5mm; align-items: baseline; }
  .dec .cap b { font-size: 20pt; font-weight: 800; font-stretch: 125%; color: var(--ox); line-height: 1; }
  .dec .cap span { font-size: 9.6pt; line-height: 1.3; font-weight: 600; }
  .dec .ttl { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); background: var(--ox); color: var(--bone); padding: 3mm 6mm; font-size: 7pt; letter-spacing: .22em; text-transform: uppercase; font-weight: 600; white-space: nowrap; z-index: 2; }

  /* studies + plans: one sheet per page */
  .sht { padding: 0; }
  .sht .box { position: absolute; left: 10mm; right: 10mm; top: 10mm; bottom: 20mm; display: flex; align-items: center; justify-content: center; }
  .sht .box img { display: block; }
  .sht .cap { position: absolute; left: 12mm; right: 12mm; bottom: 8mm; display: grid; grid-template-columns: auto 1fr auto auto; gap: 5mm; align-items: baseline; padding-top: 2mm; border-top: .5pt solid var(--ox); font-size: 6.8pt; letter-spacing: .14em; text-transform: uppercase; }
  .sht .cap b { color: var(--ox); font-size: 9pt; font-weight: 800; font-stretch: 125%; letter-spacing: 0; }
  .sht .cap .k { color: var(--ox); font-weight: 700; }

  /* remaining renders */
  .rg { display: grid; gap: 2mm; padding: 2mm; background: var(--night); }
  .rg img { width: 100%; height: 100%; object-fit: cover; min-height: 0; display: block; }
  .rg.r1 { grid-template-columns: 1fr; }
  .rg.r2 { grid-template-columns: 1fr 1fr; }
  .rg.r3 { grid-template-columns: 1.6fr 1fr; grid-template-rows: 1fr 1fr; } .rg.r3 img:first-child { grid-row: 1 / -1; }

  /* delivery card + back */
  .card { padding: 26mm 24mm; display: grid; grid-template-columns: 1fr 1.2fr; gap: 18mm; align-content: center; }
  .card h2 { font-size: 30pt; margin-top: 4mm; }
  .card p { font-size: 12pt; line-height: 1.55; }
  .card .rt { display: inline-block; margin-top: 6mm; border: .6pt solid var(--ox); color: var(--ox); padding: 1mm 2.5mm; font-size: 7.4pt; letter-spacing: .14em; font-weight: 700; }
  .back .veil { position: absolute; inset: 0; background: rgba(32,28,27,.62); }
  .back .ct { position: absolute; left: 18mm; right: 18mm; bottom: 24mm; color: var(--bone); }
  .back h2 { font-size: 34pt; margin-bottom: 12mm; }
  .back h2 em { font-style: italic; font-weight: 200; font-stretch: 100%; }
  .back dl { display: grid; grid-template-columns: repeat(4, 1fr); gap: 6mm; border-top: .5pt solid rgba(243,237,227,.5); padding-top: 4mm; }
  .back dt { font-size: 6.4pt; letter-spacing: .2em; text-transform: uppercase; opacity: .7; margin-bottom: 1.5mm; }
  .back dd { font-size: 9pt; }
</style>
</head>
<body>

<!-- cover -->
<section class="pg cover dark">
  <img class="bleed grade" src={coverImg} alt="" />
  <div class="veil"></div>
  <div class="top"><a class="wm" href="https://ayahassan.com">AYA<i></i>HASSAN</a><span class="lab">{label}</span></div>
  <h1 class="tag wide">Bold on paper.<em>Solid on ground.</em></h1>
  <div class="bot lab">
    <span>{month} {year}</span>
    <nav><a href={`mailto:${contact.email}`}>{contact.email}</a><a href="https://ayahassan.com">ayahassan.com</a></nav>
  </div>
  {(() => { N(); return null; })()}
</section>

<!-- about -->
<section class="pg about">
  <div class="ph"><img class="bleed grade" src={aboutImg} alt="" /></div>
  <div class="tx">
    <span class="lab ox">About · Architect &amp; interior designer · Cairo</span>
    <h2 class="wide">An idea only counts once it stands on real ground.</h2>
    <p class="bio">I design architecture and interiors that begin as an original idea and end as a built place. Concepts that surprise, details that work on site: homes on Egypt’s coast, luxury residences inland, and corporate headquarters from Cairo to Riyadh. Since 2019 I have worked across three studios and my own selected commissions. I have led teams of up to five, and every project in these pages names my role.</p>
    <div class="nums">
      <div><b>{full ? projects.length : shown}</b><span class="lab mut">{full ? 'Selected projects' : 'Projects in this selection'}</span></div>
      <div><b>{countries.length}</b><span class="lab mut">Countries</span></div>
      <div><b>{year - 2019}</b><span class="lab mut">Years in practice</span></div>
    </div>
  </div>
  <div class="foot" style="left:124mm"><span class="lab mut">{label}</span><span class="lab mut">{N()} / {T}</span></div>
</section>

<!-- clients -->
<section class="pg clients">
  <div class="head"><h2 class="wide">Clients</h2><span class="lab ox">Trusted by · 2019 —</span></div>
  <div class="lg">
    {clients.map((c) => <div><img src={`/clients/${c}.png`} alt={c} /></div>)}
    {typed.map((c) => <div><span>{c}</span></div>)}
  </div>
  <div class="foot"><a class="wm" href="https://ayahassan.com">AYA<i></i>HASSAN</a><span class="lab mut">{N()} / {T}</span></div>
</section>

{full && (
  <section class="pg index">
    <div class="head"><h2 class="wide">Index</h2><span class="lab ox">{shown} projects · 2019 — {year}</span></div>
    <div class="ix">
      {secs.map((s) => (
        <div>
          <h3>{s.n} · {s.name}</h3>
          <ol>{s.items.map((it, k) => <>{(k === 0 || s.items[k - 1].p.sector !== it.p.sector) && <li style="border:0;padding:3mm 0 1mm" class="lab mut">{it.p.sector}</li>}<li><span class="c">{it.code}</span><a href={`#p-${it.p.slug}`}>{it.p.title}</a><span class="m">{it.p.location} · {it.p.year}</span><span class="n">{String(startOf[it.p.slug]).padStart(2, '0')}</span></li></>)}</ol>
        </div>
      ))}
    </div>
    <div class="foot"><a class="wm" href="https://ayahassan.com">AYA<i></i>HASSAN</a><span class="lab mut">{N()} / {T}</span></div>
  </section>
)}

<!-- contents -->
<section class="pg dark contents">
  <span class="lab sand">Contents</span>
  <div class="rows">
    {secs.map((s) => <div class="row"><b>{s.n}</b><span class="t wide">{s.name}</span><span class="lab sand">{s.items.length} projects</span></div>)}
    <div class="row"><b>03</b><span class="t wide">BIM delivery</span><span class="lab sand">Packages</span></div>
  </div>
  <div class="foot on"><a class="wm" href="https://ayahassan.com">AYA<i></i>HASSAN</a><span class="lab">{N()} / {T}</span></div>
</section>

{secs.map((s) => (
  <>
    <section class="pg dark divider">
      <span class="big wide">{s.n}</span>
      <h2 class="wide">{s.name}</h2>
      <div class="foot on"><a class="wm" href="https://ayahassan.com">AYA<i></i>HASSAN</a><span class="lab">{N()} / {T}</span></div>
    </section>
    {s.items.map((it: any) => {
      const p = it.p;
      return (
        <>
          <!-- project cover -->
          <section class="pg pc" id={`p-${p.slug}`}>
            <img class="bleed grade" src={it.cover} alt="" />
            <div class="veil"></div>
            <span class="ghost wide">{it.code}</span>
            <div class="sec lab">{s.name} · {p.sector}</div>
            <div class="tb">
              <div class="no"><b>{it.code}</b>{p.roleTag && <span class="rt">{p.roleTag}</span>}</div>
              <div><h2 class="wide"><a href={`https://ayahassan.com/work/${p.slug}/`}>{p.title}</a></h2></div>
              <div>{p.role && <p class="role">{p.role}</p>}{p.summary && <p class="sum">{p.summary}</p>}</div>
              <dl class="cells">
                <div class="w"><dt>Client</dt><dd>{it.logo && <img src={it.logo} alt="" />}<span>{p.client}</span></dd></div>
                <div><dt>Year</dt><dd>{p.year}</dd></div>
                <div><dt>Status</dt><dd>{p.status ?? '—'}</dd></div>
                <div class="w"><dt>Location</dt><dd>{place(p)}</dd></div>
                <div class="w"><dt>Practice</dt><dd>{practice(p)}</dd></div>
                <div class="w"><dt>Scope</dt><dd>{it.disc.join(' · ')}</dd></div>
              </dl>
              <div class="ft"><a class="wm" style="font-size:7pt" href="https://ayahassan.com">AYA<i></i>HASSAN</a><span class="lab mut">{N()} / {T}</span></div>
            </div>
          </section>

          {it.hero && (
            <section class="pg">
              <img class="bleed grade" src={it.hero} alt="" />
              <div class="shade"></div>
              <div class="foot on"><span class="lab"><b>{it.code}</b> · {p.title}</span><span class="lab">{N()} / {T}</span></div>
            </section>
          )}

          {it.steps.length > 0 && (
            <section class="pg dec">
              {it.steps.map((st: any, k: number) => (
                <div class="q">
                  <img class:list={[st.d ? 'd' : 'r grade']} src={st.src} alt="" />
                  <div class="cap"><b>{String(k + 1).padStart(2, '0')}</b><span>{st.t}</span></div>
                </div>
              ))}
              <div class="ttl">{it.code} · How it was decided · {N()} / {T}</div>
            </section>
          )}

          {[['Study', it.studies], ['Plan', it.plans]].flatMap(([kind, list]: any) => list.map((x: any) => (
            <section class="pg sht">
              <div class="box"><img src={x.src} alt="" style={fitBox(x.w, x.h, 277, 178)} /></div>
              <div class="cap"><b>{it.code}</b><span>{p.title} · <span class="k">{kind}</span>{p.captions?.[x.no - 1] ? ` · ${p.captions[x.no - 1]}` : ''}</span><span class="k">{nextSheet()}</span><span class="mut">{N()} / {T}</span></div>
            </section>
          )))}

          {it.rest.length > 0 && (
            <section class:list={['pg rg', restClass(it.rest.length)]}>
              {it.rest.map((r: string) => <img class="grade" src={r} alt="" />)}
              <div class="foot on" style="bottom:6mm"><span class="lab"><b>{it.code}</b> · {p.title}</span><span class="lab">{N()} / {T}</span></div>
            </section>
          )}
        </>
      );
    })}
  </>
))}

