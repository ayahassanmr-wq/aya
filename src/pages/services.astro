---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { imagesFor } from '../data/projects';
const services = [
  { t: 'Concept design', d: 'Architectural and interior concepts, from the first studies to a direction the client signs off. Massing, spatial strategy, colour and material language, set out in a clear presentation.', img: imagesFor('neom-oxagon')[7] ?? imagesFor('neom-oxagon')[0], items: ['Concept studies & diagrams', 'Spatial planning', 'Mood, colour & material direction', 'Concept presentations'] },
  { t: 'Visualization & animation', d: 'Renders, walkthroughs and promotional films built to win approval, for clients, juries and marketing teams.', img: imagesFor('fifth-square')[0], items: ['Photoreal stills', 'Walkthrough animation', 'Promotional content', 'Post-production'] },
  { t: 'BIM & design packages', d: 'Revit models and coordinated drawing sets, from schematic design to issued-for-construction packages.', img: imagesFor('noatum-terminal')[5] ?? imagesFor('noatum-terminal')[0], items: ['Revit modelling', 'Schematic & IFC drawing sets', 'Interdisciplinary coordination', 'Design review to code'] },
  { t: 'Materials & FF&E', d: 'Material boards, finishes and furniture selection, sourced from suppliers worldwide and checked on site.', img: imagesFor('stc-hq')[4], items: ['Material boards & samples', 'Furniture, fixtures & equipment', 'Vendor collaboration', 'Site visits'] },
];
const steps = [
  ['Brief', 'Understand the client, the site and what the space has to do.'],
  ['Concept', 'One clear idea, tested through studies, diagrams and mood.'],
  ['Visualise', 'Model and render the concept until it can be believed.'],
  ['Package', 'Turn the approved concept into drawings, specs and selections.'],
];
---
<Base title="Services" description="Concept design, visualization and animation, BIM and design packages, and materials and FF&E selection.">
  <section class="wrap head">
    <p class="label muted">Services</p>
    <h1 class="display-xl">From concept<br />to drawing set.</h1>
  </section>

  <section class="wrap list">
    {services.map((s, i) => (
      <article class="svc reveal">
        <div class="n label">0{i + 1}</div>
        <div class="c">
          <h2 class="display-m">{s.t}</h2>
          <p>{s.d}</p>
          <ul>{s.items.map((x) => <li>{x}</li>)}</ul>
        </div>
        {s.img && <figure><Image src={s.img} alt="" widths={[600, 1000]} sizes="(min-width: 900px) 34vw, 100vw" /></figure>}
      </article>
    ))}
  </section>

  <section class="process">
    <div class="wrap">
      <div class="sheet-head"><span class="label">Process</span></div>
      <ol>{steps.map(([t, d], i) => <li class="reveal"><span class="label">Stage 0{i + 1}</span><h3 class="display-m">{t}</h3><p>{d}</p></li>)}</ol>
    </div>
  </section>
</Base>

<style>
  .head { padding-top: clamp(48px, 7vw, 100px); padding-bottom: clamp(48px, 6vw, 88px); }
  .head h1 { margin-top: 10px; }
  .list { padding-bottom: clamp(64px, 9vw, 130px); }
  .svc { display: grid; grid-template-columns: 70px 1.1fr 1fr; gap: clamp(24px, 4vw, 64px); padding-block: clamp(32px, 4vw, 56px); border-top: 1px solid var(--rule); align-items: start; }
  .n { color: var(--ox); padding-top: 12px; }
  .c { display: grid; gap: 18px; }
  .c p { color: var(--ink-2); max-width: 52ch; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 8px 24px; font-size: 15px; }
  li::before { content: "— "; color: var(--ox); }
  figure { margin: 0; aspect-ratio: 4 / 3; overflow: hidden; background: var(--ow-2); }
  figure :global(img) { width: 100%; height: 100%; object-fit: cover; }
  @media (max-width: 900px) { .svc { grid-template-columns: 1fr; } ul { grid-template-columns: 1fr; } }
  .process { background: var(--ox); color: var(--ow); padding-block: clamp(64px, 9vw, 130px); }
  .process .sheet-head { border-color: var(--rule-light); }
  .process ol { list-style: none; margin: 32px 0 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 32px; }
  .process li { display: grid; gap: 12px; padding-top: 20px; border-top: 1px solid var(--rule-light); }
  .process .label { opacity: .6; }
  .process p { opacity: .85; font-size: 15px; }
  @media (max-width: 900px) { .process ol { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 520px) { .process ol { grid-template-columns: 1fr; } }
</style>
