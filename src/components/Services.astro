---
const services = [
  ['Concept design', 'Architectural and interior concepts, from first studies to a direction the client signs off.'],
  ['Visualization & animation', 'Renders, walkthroughs and presentation content made to win approval.'],
  ['BIM & design packages', 'Revit models, schematic and IFC drawing sets, coordinated across disciplines.'],
  ['Materials & FF&E', 'Material boards, finishes and furniture selection, sourced from suppliers worldwide.'],
];
---
<section id="services">
  <div class="wrap">
    <div class="head"><div><span class="label">Services</span><h2>What I bring to a project</h2></div></div>
    <ol>
      {services.map(([t, d], i) => (
        <li><span class="n">{String(i + 1).padStart(2, '0')}</span><h3>{t}</h3><p>{d}</p></li>
      ))}
    </ol>
  </div>
</section>

<style>
  ol { list-style: none; margin: 0; padding: 0; }
  li { display: grid; grid-template-columns: 1fr; gap: 10px; padding-block: 28px; border-top: 1px solid var(--line); }
  li:last-child { border-bottom: 1px solid var(--line); }
  @media (min-width: 760px) { li { grid-template-columns: 72px 1fr 1.4fr; gap: 32px; align-items: baseline; } }
  .n { font: 500 14px var(--sans); color: var(--grey); letter-spacing: .1em; font-variant-numeric: tabular-nums; }
  h3 { font-size: 30px; color: var(--charcoal); }
  p { color: #5a544f; max-width: 56ch; }
</style>
