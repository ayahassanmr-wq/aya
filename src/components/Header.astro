---
interface Props { overHero?: boolean }
const { overHero = false } = Astro.props;
const path = Astro.url.pathname;
const links = [
  { href: '/work/', label: 'Work' },
  { href: '/about/', label: 'About' },
  { href: '/services/', label: 'Services' },
  { href: '/contact/', label: 'Contact' },
];
---
<header class:list={['site', { over: overHero }]} data-header>
  <div class="wrap bar">
    <a href="/" class="logo" aria-label="Aya Hassan, home">
      <img class="lg-light" src="/brand/AYA_Horizontal_Inverse_OffWhite.svg" alt="" width="230" height="46" loading={overHero ? undefined : 'lazy'} />
      <img class="lg-dark" src="/brand/AYA_Horizontal_Oxblood.svg" alt="" width="230" height="46" loading={overHero ? 'lazy' : undefined} />
    </a>
    <nav aria-label="Main">
      <ul>
        {links.map((l) => <li><a href={l.href} class="link" aria-current={path.startsWith(l.href) ? 'page' : undefined}>{l.label}</a></li>)}
      </ul>
    </nav>
    <button class="menu" aria-expanded="false" aria-controls="mnav" aria-label="Menu" data-menu><span></span><span></span></button>
  </div>
</header>
<div class="mnav" id="mnav" hidden>
  <nav aria-label="Mobile" class="wrap"><ul>{links.map((l, i) => <li><a href={l.href} aria-current={path.startsWith(l.href) ? 'page' : undefined}><span class="label muted">0{i + 1}</span>{l.label}<span class="arr" aria-hidden="true">→</span></a></li>)}</ul></nav>
  <div class="wrap foot label"><span>Get in touch</span><a href="mailto:ayahassanm@outlook.com">ayahassanm@outlook.com</a><a href="https://www.linkedin.com/in/ayahassanm" target="_blank" rel="noopener">LinkedIn ↗</a></div>
</div>

<script>
  const h = document.querySelector<HTMLElement>('[data-header]')!;
  const onScroll = () => h.classList.toggle('solid', window.scrollY > 40);
  onScroll(); addEventListener('scroll', onScroll, { passive: true });
  const btn = document.querySelector<HTMLButtonElement>('[data-menu]')!;
  const m = document.getElementById('mnav')!;
  const set = (open: boolean) => {
    btn.setAttribute('aria-expanded', String(open)); m.hidden = !open; h.classList.toggle('open', open); m.classList.toggle('on', open);
    h.classList.remove('tuck');
    document.body.style.overflow = open ? 'hidden' : '';
    const l = (window as any).__lenis; open ? l?.stop() : l?.start();
    if (open) m.querySelector('a')?.focus();
  };
  btn.addEventListener('click', () => set(btn.getAttribute('aria-expanded') !== 'true'));
  addEventListener('keydown', (e) => { if (e.key === 'Escape' && !m.hidden) { set(false); btn.focus(); } });
  m.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => set(false)));
  matchMedia('(min-width: 761px)').addEventListener('change', (e) => e.matches && set(false));
  // hide the bar while scrolling down, show it when scrolling up
  let last = scrollY; const noTuck = !!document.querySelector('[data-sticky-bar]');
  addEventListener('scroll', () => { const y = scrollY; h.classList.toggle('tuck', !noTuck && y > 300 && y > last && !h.classList.contains('open')); last = y; }, { passive: true });
</script>

<style>
  .site { position: sticky; top: 0; z-index: 20; color: var(--ink); padding-top: env(safe-area-inset-top, 0px); transition: background .5s, color .5s, border-color .5s, transform .6s var(--ease-io);
    background: var(--glass); -webkit-backdrop-filter: blur(18px) saturate(1.4); backdrop-filter: blur(18px) saturate(1.4); border-bottom: 1px solid var(--rule); }
  .site.over { position: fixed; inset: 0 0 auto; background: transparent; -webkit-backdrop-filter: none; backdrop-filter: none; color: var(--ow); border-color: transparent; }
  .site.over.solid, .site.open { background: var(--glass-dark); -webkit-backdrop-filter: blur(20px) saturate(1.3); backdrop-filter: blur(20px) saturate(1.3); color: var(--ow); border-color: rgba(255,255,255,.1); }
  .site.tuck { transform: translateY(-100%); }
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) { .site { background: rgba(243,237,227,.96); } .site.over.solid, .site.open { background: rgba(32,28,27,.95); } }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 24px; height: 76px; }
  .logo { display: block; padding-block: 8px; }
  .logo img { height: 40px; width: auto; }
  .lg-light { display: none; }
  .over .lg-light, .open .lg-light { display: block; } .over .lg-dark, .open .lg-dark { display: none; }
  ul { list-style: none; margin: 0; padding: 0; }
  .bar nav ul { display: flex; gap: clamp(20px, 3vw, 44px); }
  .bar nav a { display: inline-block; font: 400 12.5px var(--sans); letter-spacing: .2em; text-transform: uppercase; padding-block: 12px 6px; }
  .menu { display: none; background: none; border: 0; color: inherit; cursor: pointer; width: 48px; height: 48px; position: relative; margin-right: -10px; }
  .menu span { position: absolute; left: 12px; right: 12px; height: 1.5px; background: currentColor; transition: transform .45s var(--ease), top .45s var(--ease); }
  .menu span:nth-child(1) { top: 19px; } .menu span:nth-child(2) { top: 28px; }
  .menu[aria-expanded="true"] span:nth-child(1) { top: 23px; transform: rotate(45deg); }
  .menu[aria-expanded="true"] span:nth-child(2) { top: 23px; transform: rotate(-45deg); }
  .mnav { position: fixed; inset: 0; z-index: 19; background: rgba(32, 28, 27, .94); -webkit-backdrop-filter: blur(24px); backdrop-filter: blur(24px); color: var(--ow); padding-top: calc(96px + env(safe-area-inset-top, 0px)); padding-bottom: calc(32px + env(safe-area-inset-bottom, 0px)); overflow-y: auto; overscroll-behavior: contain; display: flex; flex-direction: column; justify-content: space-between; }
  .mnav nav { display: block; }
  .mnav nav ul { display: block; }
  .mnav .foot { display: grid; gap: 6px; color: var(--muted-dark); opacity: 0; animation: in .7s .3s var(--ease) forwards; }
  .mnav .foot a { color: var(--ow); font-size: 16px; }
  .mnav li { border-bottom: 1px solid var(--rule-light); opacity: 0; transform: translateY(16px); animation: in .7s var(--ease) forwards; }
  .mnav li:nth-child(2) { animation-delay: .06s; } .mnav li:nth-child(3) { animation-delay: .12s; } .mnav li:nth-child(4) { animation-delay: .18s; }
  @keyframes in { to { opacity: 1; transform: none; } }
  .mnav ul a { display: flex; align-items: baseline; gap: 18px; padding-block: 18px; font: 400 clamp(36px, 10vw, 52px)/1 var(--display); }
  .mnav .label { color: var(--muted-dark); }
  @media (min-width: 761px) { .mnav { display: none !important; } }
  @media (max-width: 760px) { .bar nav { display: none; } .menu { display: block; } .logo img { height: 32px; } .bar { height: 68px; } .mnav { padding-top: calc(88px + env(safe-area-inset-top, 0px)); } }
</style>
<style>
  .mnav ul a .arr { margin-left: auto; font: 300 22px var(--sans); color: var(--muted-dark); transition: transform .4s var(--ease), color .3s; }
  .mnav ul a[aria-current] { color: #D8C7A6; font-style: italic; }
  .mnav ul a:active .arr { transform: translateX(6px); color: var(--ow); }
</style>
