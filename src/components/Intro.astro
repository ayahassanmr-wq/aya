---
/* Intro (~3 s, first visit of a session and on refresh), in the One Hand brand.
   A drawing sheet: a dimension line is drawn edge to edge, AYA HASSAN rises onto it in wide Archivo,
   the title block's cells rule in underneath, the oxblood "concept approved" stamp lands, then the sheet
   parts top and bottom onto the hero. Skippable; never with reduced motion or without JS. */
const ar = Astro.url.pathname.startsWith('/ar');
---
<script is:inline>
  try {
    var nav = performance.getEntriesByType && performance.getEntriesByType('navigation')[0];
    var reload = nav ? nav.type === 'reload' : (performance.navigation && performance.navigation.type === 1);
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches && (reload || !sessionStorage.getItem('aya-intro'))) {
      document.documentElement.classList.add('has-intro');
      sessionStorage.setItem('aya-intro', '1');
    }
  } catch (e) {}
</script>
<div class="intro" aria-hidden="true" data-intro>
  <span class="half up"></span><span class="half dn"></span>
  <div class="sheet" dir="ltr">
    <div class="dim"><i></i><span>{ar ? 'معمارية · مصممة داخلية' : 'Architect · Interior designer'}</span><i></i></div>
    <p class="nm"><span>AYA&nbsp;HASSAN</span></p>
    <div class="cells">
      <span class="c">{ar ? 'من الفكرة إلى الإقناع' : 'From concept to conviction'}</span>
      <span class="c">Cairo, EG</span>
      <span class="c">A-000</span>
      <svg class="stamp" viewBox="0 0 160 160">
        <defs><path id="intro-ring" d="M80 80 m -58 0 a 58 58 0 1 1 116 0 a 58 58 0 1 1 -116 0"></path></defs>
        <circle cx="80" cy="80" r="76" fill="none" stroke="currentColor" stroke-width="2"></circle>
        <circle cx="80" cy="80" r="44" fill="none" stroke="currentColor" stroke-width="1.2"></circle>
        <text font-weight="600" font-size="11.5" letter-spacing="3.2" fill="currentColor" style="direction:ltr;unicode-bidi:bidi-override"><textPath href="#intro-ring">CONCEPT APPROVED · CAIRO · MMXXVI ·</textPath></text>
        <path d="M62 82 L 75 95 L 100 64" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </div>
  </div>
  <button type="button" class="label skip-intro" data-skip tabindex="-1">{ar ? 'تخطَّ' : 'Skip'}</button>
</div>

<script>
  const root = document.documentElement;
  const el = document.querySelector<HTMLElement>('[data-intro]');
  if (el && root.classList.contains('has-intro')) {
    let done = false;
    const end = () => {
      if (done) return; done = true;
      root.classList.add('intro-out');
      setTimeout(() => { root.classList.remove('has-intro', 'intro-out'); el.remove(); }, 1100);
    };
    setTimeout(end, 2900);
    el.querySelector('[data-skip]')!.addEventListener('click', end);
    addEventListener('keydown', end, { once: true });
    addEventListener('pointerdown', end, { once: true });
  } else el?.remove();
</script>

<style>
  .intro { display: none; }
  :global(.has-intro) .intro { display: grid; place-items: center; position: fixed; inset: 0; z-index: 500; color: var(--ow); overflow: hidden; }
  .half { position: absolute; left: 0; right: 0; height: 50.5%; background: var(--night); transition: transform 1.05s var(--ease-io); }
  .up { top: 0; } .dn { bottom: 0; }
  :global(.intro-out) .up { transform: translateY(-100%); }
  :global(.intro-out) .dn { transform: translateY(100%); }

  .sheet { position: relative; z-index: 2; width: min(88vw, 1400px); transition: opacity .45s, transform 1s var(--ease-io); }
  :global(.intro-out) .sheet { opacity: 0; transform: scale(.96); }

  /* 1. the dimension line draws out from the centre to both ends */
  .dim { display: flex; align-items: center; gap: 14px; color: var(--sand); margin-bottom: clamp(10px, 1.4vw, 20px); }
  .dim i { flex: 1; height: 1px; background: currentColor; position: relative; transform: scaleX(0); animation: draw .9s .1s var(--ease-io) forwards; }
  .dim i:first-child { transform-origin: right; } .dim i:last-child { transform-origin: left; }
  .dim i::before { content: ""; position: absolute; top: -7px; width: 1px; height: 15px; background: currentColor; }
  .dim i:first-child::before { left: 0; } .dim i:last-child::before { right: 0; }
  .dim span { font: 400 11px/1 var(--sans); letter-spacing: .26em; text-transform: uppercase; white-space: nowrap; opacity: 0; animation: fade .6s .5s forwards; }
  @keyframes draw { to { transform: scaleX(1); } }
  @keyframes fade { to { opacity: 1; } }

  /* 2. the name rises onto the line */
  .nm { margin: 0; overflow: hidden; font-family: "Archivo Variable", sans-serif; font-weight: 800; font-stretch: 125%; font-size: clamp(40px, 10.4vw, 190px); line-height: .9; letter-spacing: -.02em; white-space: nowrap; text-align: center; }
  .nm span { display: inline-block; transform: translateY(105%); animation: rise 1s .55s var(--ease-out) forwards; }
  @keyframes rise { to { transform: none; } }

  /* 3. the title block rules in, then the stamp lands */
  .cells { display: grid; grid-template-columns: 2fr 1fr 1fr auto; align-items: center; margin-top: clamp(14px, 1.8vw, 26px); border-top: 1px solid rgba(243, 237, 227, .35); border-bottom: 1px solid rgba(243, 237, 227, .35); clip-path: inset(0 100% 0 0); animation: wipe .8s 1.25s var(--ease-io) forwards; }
  .c { padding: 14px 18px; border-inline-start: 1px solid rgba(243, 237, 227, .35); font: 400 12px/1.2 var(--sans); letter-spacing: .18em; text-transform: uppercase; color: rgba(243, 237, 227, .8); }
  .c:first-child { border-inline-start: 0; padding-inline-start: 0; }
  @keyframes wipe { to { clip-path: inset(0 0 0 0); } }
  .stamp { width: clamp(56px, 6vw, 84px); height: auto; margin: 6px 0 6px 18px; color: #D7A0A6; opacity: 0; transform: rotate(-26deg) scale(1.8); animation: stamp .5s 1.95s cubic-bezier(.3, 1.6, .5, 1) forwards; }
  .stamp text { font-family: "Archivo Variable", sans-serif; }
  @keyframes stamp { to { opacity: 1; transform: rotate(-9deg) scale(1); } }
  @media (max-width: 640px) { .cells { grid-template-columns: 1fr auto; } .c:nth-child(2), .c:nth-child(3) { display: none; } .c { font-size: 10px; letter-spacing: .12em; } }

  .skip-intro { position: absolute; z-index: 3; right: max(var(--gut), env(safe-area-inset-right, 0px)); bottom: calc(18px + env(safe-area-inset-bottom, 0px)); background: none; border: 0; color: var(--muted-dark); padding: 12px; cursor: pointer; transition: opacity .3s; }
  :global(.intro-out) .skip-intro { opacity: 0; }
</style>
