---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
---
<Base title="Page not found" description="This page doesn’t exist. Browse Aya Hassan’s work instead.">
  <PageHero eyebrow="Error 404" code="Sheet missing">
    <h1 class="display-xl lines"><span class="ln"><span>This sheet isn’t</span></span><span class="ln"><span>in the <em>set.</em></span></span></h1>
    <p class="lede">The page you’re looking for has moved or never existed.</p>
    <div class="go"><a href="/work/" class="btn">See all work <span class="arr">→</span></a><a href="/" class="label link">Back to home</a></div>
  </PageHero>
</Base>
<style>
  .go { display: flex; flex-wrap: wrap; align-items: center; gap: 28px; }
</style>
