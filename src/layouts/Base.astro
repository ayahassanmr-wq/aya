---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Intro from '../components/Intro.astro';
interface Props { title?: string; description?: string; image?: string; overHero?: boolean; intro?: boolean }
const {
  title,
  description = 'Aya Hassan is an architect and interior designer in concept design, with Gulf-scale experience on NEOM, SABIC HQ and STC HQ.',
  image = '/og.jpg',
  overHero = false,
  intro = false,
} = Astro.props;
const fullTitle = title ? `${title} · Aya Hassan` : 'Aya Hassan · Architect & Interior Designer';
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#5E1A24" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Jost:wght@300;400;500&display=swap" />
  </head>
  <body>
    {intro && <Intro />}
    <a href="#main" class="skip">Skip to content</a>
    <Header overHero={overHero} />
    <main id="main" tabindex="-1"><slot /></main>
    <Footer />
    <script>import '../scripts/fx.ts';</script>
  </body>
</html>
