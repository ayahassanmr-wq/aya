---
/* Reel: one or two rows of project images that slide sideways as the page scrolls (rows move in opposite directions).
   Purely visual (aria-hidden); each picture links nowhere and carries no text. Static without JS or with reduced motion. */
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { rows: ImageMetadata[][]; dark?: boolean }
const { rows, dark = false } = Astro.props;
const data = await Promise.all(rows.map((r) => Promise.all(r.map(async (img) => {
  const a = await getImage({ src: img, width: 520, height: 390, fit: 'cover', format: 'webp', quality: 64 });
  const b = await getImage({ src: img, width: 900, height: 675, fit: 'cover', format: 'webp', quality: 62 });
  return { srcset: `${a.src} 520w, ${b.src} 900w` , src: a.src };
}))));
---
<section class:list={['reel', { dark }]} data-sp aria-hidden="true">
  {data.map((row, i) => (
    <div class:list={['row', i % 2 ? 'rev' : 'fwd']}>
      {row.map((p) => <figure><img srcset={p.srcset} src={p.src} sizes="(min-width: 900px) 30vw, 70vw" width="520" height="390" alt="" loading="lazy" decoding="async" /></figure>)}
    </div>
  ))}
</section>

<style>
  .reel { overflow: hidden; padding-block: clamp(48px, 7vw, 110px); display: grid; gap: clamp(12px, 1.4vw, 22px); --sp: .5; }
  .row { display: flex; gap: clamp(12px, 1.4vw, 22px); width: max-content; will-change: transform; }
  .fwd { transform: translate3d(calc(var(--sp) * -22% + 4%), 0, 0); }
  .rev { transform: translate3d(calc(var(--sp) * 22% - 30%), 0, 0); }
  figure { margin: 0; width: clamp(240px, 28vw, 520px); aspect-ratio: 4 / 3; border-radius: var(--r-3); overflow: hidden; isolation: isolate; flex: none; }
  img { width: 100%; height: 100%; object-fit: cover; transform: scale(1.06); transition: transform 1.2s var(--ease-out), filter .6s; filter: saturate(.92); }
  figure:hover img { transform: scale(1.12); filter: none; }
</style>
