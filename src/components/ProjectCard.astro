---
import { Image } from 'astro:assets';
import { cover, type Project } from '../data/projects';
import Scope from './Scope.astro';
interface Props { p: Project; size?: 'l' | 'm'; eager?: boolean }
const { p, size = 'm', eager = false } = Astro.props;
import { i18n, localize, place } from '../i18n';
const L = i18n(Astro.url);
const q = localize(p, L.ar);
const img = cover(p.slug);
---
<a href={L.u(`/work/${p.slug}/`)} class:list={['card', size, 'reveal']} data-cat={p.category} data-sector={p.sector} data-cursor={L.t('View', 'عرض')}>
  <div class="frame" data-tilt>
    <div class="para zoom">
      {img && <Image src={img} alt={`${q.title}، ${q.location}`.replace('، ', L.ar ? '، ' : ', ')} widths={size === 'l' ? [800, 1400, 1800] : [600, 900, 1200]} sizes={size === 'l' ? '(min-width: 900px) 66vw, 100vw' : '(min-width: 900px) 33vw, (min-width: 600px) 50vw, 100vw'} loading={eager ? 'eager' : 'lazy'} data-parallax="0.06" data-scale="1.1" />}
    </div>
    <span class="sheen" aria-hidden="true"></span>
    {p.concept && <span class="tag flag glass">{L.t('Concept exploration', 'استكشاف مبدئي')}</span>}
    <span class="corner tl" aria-hidden="true"></span><span class="corner br" aria-hidden="true"></span>
  </div>
  <div class="meta">
    <div class="t">
      <h3><span class="u">{q.title}</span></h3>
      <p class="label muted">{place(q)}</p>
      <Scope p={p} />
    </div>
    <span class="label muted sector">{q.sector}</span>
  </div>
</a>

<style>
  .card { display: flex; flex-direction: column; gap: 18px; min-width: 0; }
  .frame { position: relative; }
  .para { aspect-ratio: 4 / 3; }
  .l .para { aspect-ratio: 16 / 10; }
  .para :global(img) { width: 100%; height: 100%; object-fit: cover; transform: scale(1.1); }
  .card:hover .para :global(img) { filter: saturate(1.08) contrast(1.03); }
  .sheen { position: absolute; inset: 0; pointer-events: none; opacity: 0; transition: opacity .5s; background: radial-gradient(circle at var(--gx, 50%) var(--gy, 50%), rgba(243, 237, 227, .22), transparent 45%); }
  .card:hover .sheen { opacity: 1; }
  .code-chip { position: absolute; right: 12px; bottom: 12px; padding: 7px 10px; font-size: 11.5px; transform: translateY(8px); opacity: 0; transition: .5s var(--ease); }
  .card:hover .code-chip { transform: none; opacity: 1; }
  .flag { position: absolute; left: 12px; top: 12px; }
  /* drafting corner marks draw in on hover */
  .corner { position: absolute; width: 18px; height: 18px; border-color: var(--ox); border-style: solid; border-width: 0; opacity: 0; transition: .5s var(--ease); }
  .tl { left: -8px; top: -8px; border-left-width: 1px; border-top-width: 1px; transform: translate(6px, 6px); }
  .br { right: -8px; bottom: -8px; border-right-width: 1px; border-bottom-width: 1px; transform: translate(-6px, -6px); }
  .card:hover .corner { opacity: 1; transform: none; }
  .meta { display: grid; grid-template-columns: 1fr auto; gap: 12px; align-items: baseline; border-top: 1px solid var(--rule); padding-top: 14px; }
  h3 { font-size: clamp(28px, 2.5vw, 38px); line-height: 1; }
  .l h3 { font-size: clamp(26px, 2.6vw, 40px); }
  .u { background: linear-gradient(var(--ox), var(--ox)) right 100% / 0 1px no-repeat; transition: background-size .5s var(--ease-io), color .3s; }
  .card:hover .u { background-position: left 100%; background-size: 100% 1px; color: var(--ox); }
  :global(.dark) .card:hover .u { color: var(--ow); background-image: linear-gradient(var(--ow), var(--ow)); }
  .t .label { margin-top: 7px; font-size: 11.5px; }
  .t :global(.scope) { margin-top: 10px; }
  .sector { font-size: 11.5px; }
  @media (max-width: 520px) { .sector { display: none; } }
</style>
