---
import { Image } from 'astro:assets';
import { projects, TBC } from '../data/projects';
const v = (s?: string) => (!s || s === TBC ? null : s);
---
<section id="work">
  <div class="wrap">
    <div class="head">
      <div><span class="label">Selected work · {projects.length} projects</span><h2>Concepts at every scale</h2></div>
      <div class="filters" role="group" aria-label="Filter projects">
        <button type="button" aria-pressed="true" data-f="all">All</button>
        <button type="button" aria-pressed="false" data-f="architecture">Architecture</button>
        <button type="button" aria-pressed="false" data-f="interiors">Interiors</button>
      </div>
    </div>

    <div class="grid">
      {projects.map((p) => (
        <article class:list={['card', { wide: p.wide }]} data-c={p.category} id={p.slug}>
          <div class="img">
            <Image src={p.image} alt={p.alt} widths={[600, 1100]} sizes={p.wide ? '100vw' : '(min-width: 760px) 50vw, 100vw'} />
            <span class="tag label">{p.tag}</span>
            {p.nda && <span class="nda label">Published images only</span>}
          </div>
          <div><h3>{p.title}</h3><p class="where label">{p.location}</p></div>
          <dl class="facts">
            <dt>Role</dt><dd>{p.role}{p.confirm && <> · <em class="ph">confirm {p.confirm}</em></>}</dd>
            <dt>Year</dt><dd>{v(p.year) ?? <em class="ph">TBC</em>}</dd>
            {p.scale !== undefined && <><dt>Scale</dt><dd>{v(p.scale) ?? <em class="ph">area TBC</em>}</dd></>}
            {p.practice && <><dt>Practice</dt><dd>{p.practice}</dd></>}
          </dl>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filters button');
  buttons.forEach((b) => b.addEventListener('click', () => {
    const f = b.dataset.f;
    buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    document.querySelectorAll<HTMLElement>('.grid .card').forEach((c) => { c.hidden = !(f === 'all' || c.dataset.c === f); });
  }));
</script>

<style>
  .filters { display: flex; gap: 6px; flex-wrap: wrap; }
  .filters button { font: 500 12px var(--sans); letter-spacing: .18em; text-transform: uppercase; background: none; border: 1px solid var(--line); color: var(--charcoal); padding: 10px 16px; cursor: pointer; }
  .filters button[aria-pressed="true"] { background: var(--oxblood); border-color: var(--oxblood); color: var(--offwhite); }
  .filters button:hover { border-color: var(--oxblood); }
  .grid { display: grid; grid-template-columns: 1fr; gap: 56px 40px; }
  @media (min-width: 760px) { .grid { grid-template-columns: 1fr 1fr; } .wide { grid-column: 1 / -1; } }
  .card { display: flex; flex-direction: column; gap: 16px; min-width: 0; scroll-margin-top: 90px; }
  .img { position: relative; overflow: hidden; background: var(--white); }
  .img :global(img) { display: block; width: 100%; aspect-ratio: 3 / 2; object-fit: cover; transition: transform .8s ease; }
  .wide .img :global(img) { aspect-ratio: 21 / 9; }
  .card:hover .img :global(img) { transform: scale(1.025); }
  .tag { position: absolute; left: 12px; top: 12px; background: var(--offwhite); color: var(--oxblood); padding: 6px 10px; }
  .nda { position: absolute; right: 12px; top: 12px; background: var(--charcoal); color: var(--offwhite); padding: 6px 10px; }
  h3 { font-size: clamp(26px, 3vw, 32px); line-height: 1.1; color: var(--charcoal); }
  .where { color: var(--grey); margin-top: 4px; }
  .facts { display: grid; grid-template-columns: auto 1fr; gap: 4px 18px; font-size: 14px; padding-top: 14px; border-top: 1px solid var(--line); margin: 0; }
  dt { color: var(--grey); font: 500 11px/1.9 var(--sans); letter-spacing: .18em; text-transform: uppercase; }
  dd { margin: 0; }
</style>
