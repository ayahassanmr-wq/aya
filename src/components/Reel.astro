---
/* Reel: one or two rows of project images that slide sideways as the page scrolls (rows move in opposite directions).
   Purely visual (aria-hidden); each picture links nowhere and carries no text. Static without JS or with reduced motion. */
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { rows: ImageMetadata[][]; dark?: boolean; links?: { href: string; title: string }[][] }
const { rows, dark = false, links } = Astro.props;
const data = await Promise.all(rows.map((r) => Promise.all(r.map(async (img) => {
  const a = await getImage({ src: img, width: 520, height: 390, fit: 'cover', format: 'webp', quality: 64 });
  const b = await getImage({ src: img, width: 900, height: 675, fit: 'cover', format: 'webp', quality: 62 });
  return { srcset: `${a.src} 520w, ${b.src} 900w` , src: a.src };
}))));
---
{links ? (
<section class:list={['reel', 'live', { dark }]}>
  {data.map((row, i) => (
    <div class="scroller" data-drag>
      <div class="row">
        {row.map((p, k) => <a class="tile" href={links[i][k].href} draggable="false"><figure><img srcset={p.srcset} src={p.src} sizes="(min-width: 900px) 30vw, 70vw" width="520" height="390" alt={links[i][k].title} loading="lazy" decoding="async" draggable="false" /></figure><span class="label tl">{links[i][k].title}</span></a>)}
      </div>
    </div>
  ))}
</section>
) : (
<section class:list={['reel', { dark }]} data-sp aria-hidden="true">
  {data.map((row, i) => (
    <div class:list={['row', i % 2 ? 'rev' : 'fwd']}>
      {row.map((p) => <figure><img srcset={p.srcset} src={p.src} sizes="(min-width: 900px) 30vw, 70vw" width="520" height="390" alt="" loading="lazy" decoding="async" /></figure>)}
    </div>
  ))}
</section>
)}

<script>
  document.querySelectorAll<HTMLElement>('[data-drag]').forEach((el) => {
    let down = false, sx = 0, sl = 0, moved = false;
    el.addEventListener('pointerdown', (e) => { if (e.pointerType !== 'mouse') return; down = true; moved = false; sx = e.clientX; sl = el.scrollLeft; el.classList.add('drag'); });
    addEventListener('pointermove', (e) => { if (!down) return; const dx = e.clientX - sx; if (Math.abs(dx) > 4) moved = true; el.scrollLeft = sl - dx; });
    addEventListener('pointerup', () => { down = false; el.classList.remove('drag'); });
    el.addEventListener('click', (e) => { if (moved) { e.preventDefault(); moved = false; } }, true);
  });
</script>

<style>
  .reel { overflow: hidden; padding-block: clamp(48px, 7vw, 110px); display: grid; gap: clamp(12px, 1.4vw, 22px); --sp: .5; }
  .row { display: flex; gap: clamp(12px, 1.4vw, 22px); width: max-content; will-change: transform; }
  .fwd { transform: translate3d(calc(var(--sp) * -22% + 4%), 0, 0); }
  .rev { transform: translate3d(calc(var(--sp) * 22% - 30%), 0, 0); }
  figure { margin: 0; width: clamp(240px, 28vw, 520px); aspect-ratio: 4 / 3; border-radius: var(--r-3); overflow: hidden; isolation: isolate; flex: none; }
  img { width: 100%; height: 100%; object-fit: cover; transform: scale(1.06); transition: transform 1.2s var(--ease-out), filter .6s; filter: saturate(.92); }
  figure:hover img { transform: scale(1.12); filter: none; }
  .live .scroller { overflow-x: auto; scrollbar-width: none; cursor: grab; padding-inline: max(var(--gut, 20px), env(safe-area-inset-left, 0px)); }
  .live .scroller::-webkit-scrollbar { display: none; }
  .live .scroller.drag { cursor: grabbing; }
  .live .row { transform: none; }
  .tile { display: grid; gap: 10px; text-decoration: none; color: inherit; flex: none; user-select: none; }
  .tile .tl { opacity: .75; transition: opacity .3s, color .3s; }
  .tile:hover .tl { opacity: 1; color: var(--sand); }
</style>
