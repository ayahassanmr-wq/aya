---
/* Print-only CV, A4 portrait, two pages → /Aya_Hassan_CV.pdf. Copy and layout = cv-reference.html (10 Nov). */
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/archivo/wdth-italic.css';
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="robots" content="noindex" />
<title>Aya Hassan CV</title>
<style is:global>


@page{size:A4;margin:0}
:root{--bone:#F3EDE3;--ink:#2B2826;--ox:#5E1A24;--sand:#D6CBBE;--mute:#6f6862}
*{box-sizing:border-box;margin:0;padding:0}
html,body{background:var(--bone)}
body{font-family:"Archivo Variable",sans-serif;color:var(--ink);font-size:8.4pt;line-height:1.4;font-stretch:100%}
.page{width:210mm;height:297mm;padding:15mm 16mm 13mm;position:relative;page-break-after:always;overflow:hidden}
.eyebrow,.lab,h2{font-weight:500;text-transform:uppercase;letter-spacing:.06em;font-size:7pt;color:var(--ox)}
h1{font-weight:850;font-stretch:125%;font-size:34pt;letter-spacing:-.03em;line-height:1;margin:2mm 0 1.5mm}
.motto{font-weight:250;font-style:italic;font-size:12pt;color:var(--ox)}
.block{display:grid;grid-template-columns:repeat(4,1fr);gap:3mm 5mm;margin-top:6mm;padding:4mm 0;border-top:.5pt solid var(--ink);border-bottom:.5pt solid var(--ink)}
.block div span{display:block;margin-top:.6mm}
.wide{grid-column:span 2}
h2{margin:7mm 0 2.5mm;padding-bottom:1.6mm;border-bottom:.5pt solid var(--ox)}
.profile{font-size:10pt;line-height:1.5;font-weight:350}
.str{display:grid;grid-template-columns:repeat(4,1fr);gap:4mm}
.str div{border-left:1.6pt solid var(--ox);padding-left:3mm}
.str b{display:block;font-weight:700;font-stretch:112%;font-size:8.6pt;margin-bottom:1mm}
.job{display:grid;grid-template-columns:52mm 1fr;gap:5mm;margin-bottom:4.5mm}
.yr{font-weight:800;font-stretch:112%;color:var(--ox)}
.role{font-weight:700}.firm{color:var(--mute)}
ul{list-style:none}li{position:relative;padding-left:3.5mm;margin-bottom:1.3mm}
li:before{content:"";position:absolute;left:0;top:2.1mm;width:1.6mm;height:.5pt;background:var(--ox)}
li b{font-weight:700}
.two{display:grid;grid-template-columns:1fr 1fr;gap:8mm}
.two p{margin-bottom:2mm}
.clients{font-weight:600;font-stretch:112%;line-height:1.7}
.port{display:flex;justify-content:space-between;background:var(--ox);color:var(--bone);padding:3.5mm 4mm;font-weight:500}
.foot{position:absolute;left:16mm;right:16mm;bottom:9mm;display:flex;justify-content:space-between;border-top:.5pt solid var(--sand);padding-top:2mm;font-size:6.8pt;letter-spacing:.06em;text-transform:uppercase;color:var(--ox);font-weight:600}
a{color:inherit;text-decoration:none}body{-webkit-print-color-adjust:exact;print-color-adjust:exact}</style>
</head>
<body>
