---
/* Unlisted portfolio page (linked only from Aya's CV): view the PDF here or download it. Not in nav or sitemap. */
import Base from '../layouts/Base.astro';
import { i18n } from '../i18n';
const L = i18n(Astro.url);
const { t } = L;
const file = '/portfolio.pdf';
---
<Base title={t('Portfolio', 'ملف الأعمال')} description={t('Aya Hassan · Selected Works portfolio (PDF).', 'آية حسن · ملف الأعمال المختارة (PDF).')} noindex>
  <section class="wrap pf">
    <div class="ph">
      <div>
        <span class="label muted">{t('Selected Works · 18 projects · PDF', 'أعمال مختارة · 18 مشروعًا · PDF')}</span>
        <h1 class="display-l">{t('Portfolio', 'ملف الأعمال')}</h1>
      </div>
      <div class="da">
        <a href={file} class="btn solid" download="Aya_Hassan_Portfolio.pdf">{t('Download PDF', 'تحميل PDF')} <span class="arr">↓</span></a>
        <a href={file} class="btn ghost" target="_blank" rel="noopener">{t('Open full screen', 'افتح بملء الشاشة')} <span class="arr">↗</span></a>
      </div>
    </div>
    <div class="viewer"><iframe title={t('Aya Hassan portfolio', 'ملف أعمال آية حسن')} src={`${file}#view=FitH`}></iframe></div>
    <p class="label muted note">{t('If the preview does not show on your device, use Open full screen or Download.', 'إذا لم تظهر المعاينة على جهازك، استخدم «افتح بملء الشاشة» أو «تحميل».')}</p>
  </section>
</Base>

<style>
  .pf { padding-block: clamp(120px, 12vw, 170px) clamp(64px, 8vw, 120px); }
  .ph { display: flex; flex-wrap: wrap; gap: 20px 40px; align-items: flex-end; justify-content: space-between; padding-bottom: clamp(20px, 2.4vw, 32px); border-bottom: 1px solid var(--rule); margin-bottom: clamp(20px, 2.4vw, 32px); }
  .ph h1 { margin-top: 10px; }
  .da { display: flex; flex-wrap: wrap; gap: 12px; }
  .viewer iframe { display: block; width: 100%; height: 82vh; border: 1px solid var(--rule); border-radius: var(--r-2, 10px); background: var(--ow, #fff); }
  .note { margin-top: 14px; text-transform: none; letter-spacing: .02em; }
</style>
