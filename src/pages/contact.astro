---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { contact, imagesFor } from '../data/projects';
---
<Base title="Contact" description="Contact Aya Hassan for concept design roles, collaborations with design firms and selected private commissions.">
  <PageHero eyebrow="Contact" code="Sheet G-04 · Enquiries" compact images={[imagesFor('stc-hq')[2], imagesFor('commercial-mall')[1]]} alt="Interior of the stc headquarters" meta={[['Based in', 'Riyadh, Saudi Arabia'], ['Open to', 'Roles · Collaborations · Commissions'], ['Languages', 'Arabic · English']]}>
    <h1 class="display-xl lines"><span class="ln"><span>Let’s talk</span></span><span class="ln"><span>about your <em>project.</em></span></span></h1>
    <p class="lede">For concept design roles, collaborations with design firms, and selected private commissions in Saudi Arabia, the Gulf and Egypt.</p>
  </PageHero>

  <section class="wrap rows">
    <div class="row"><span class="label muted">Email</span><a href={`mailto:${contact.email}`} class="v link" id="em">{contact.email}</a><button type="button" class="btn copy" data-copy="em">Copy</button></div>
    <div class="row"><span class="label muted">LinkedIn</span><a href={contact.linkedin} target="_blank" rel="noopener" class="v link">{contact.linkedinLabel}</a><span class="arr">↗</span></div>
    <div class="row"><span class="label muted">CV</span><a href="/Aya_Hassan_CV.pdf" class="v link">Download PDF</a><span class="arr">↓</span></div>
  </section>
</Base>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) => b.addEventListener('click', async () => {
    const el = document.getElementById(b.dataset.copy!)!;
    try { await navigator.clipboard.writeText(el.textContent ?? ''); b.textContent = 'Copied'; setTimeout(() => (b.textContent = 'Copy'), 1600); }
    catch { const r = document.createRange(); r.selectNodeContents(el); const s = getSelection(); s?.removeAllRanges(); s?.addRange(r); }
  }));
</script>

<style>
  .rows { padding-top: clamp(64px, 8vw, 120px); padding-bottom: clamp(80px, 10vw, 150px); }
  .row { display: grid; grid-template-columns: 160px 1fr auto; gap: 16px; align-items: center; padding-block: clamp(20px, 2.6vw, 34px); border-top: 1px solid var(--rule); }
  .row:last-child { border-bottom: 1px solid var(--rule); }
  .v { font: 400 clamp(24px, 3.2vw, 46px)/1.1 var(--display); overflow-wrap: anywhere; }
  .v:hover { color: var(--ox); }
  .copy { padding: 12px 16px; background: none; cursor: pointer; color: var(--ink); }
  .arr { font-size: 22px; color: var(--ox); }
  @media (max-width: 640px) { .row { grid-template-columns: 1fr auto; } .row > .label { grid-column: 1 / -1; } }
</style>
