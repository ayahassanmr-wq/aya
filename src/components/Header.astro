---
const links = [
  { href: '#work', label: 'Work' },
  { href: '#about', label: 'About' },
  { href: '#services', label: 'Services' },
  { href: '#contact', label: 'Contact' },
];
---
<header>
  <div class="wrap nav">
    <a class="logo" href="#top">
      <img src="/brand/AYA_Horizontal_Inverse_OffWhite.svg" alt="AYA Hassan, Architect & Interior Design" width="230" height="46" />
    </a>
    <nav aria-label="Main">
      <ul>{links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
    </nav>
  </div>
</header>

<style>
  header { position: sticky; top: 0; z-index: 5; background: var(--oxblood); color: var(--offwhite); }
  .nav { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding-block: 14px; }
  .logo { display: block; line-height: 0; }
  .logo img { height: 46px; width: auto; max-width: 55vw; }
  ul { display: flex; gap: 28px; list-style: none; margin: 0; padding: 0; }
  ul a { text-decoration: none; font: 400 13px var(--sans); letter-spacing: .14em; text-transform: uppercase; opacity: .85; }
  ul a:hover { opacity: 1; }
  @media (max-width: 640px) { ul { gap: 16px; } li:nth-child(3) { display: none; } }
  @media (max-width: 440px) { li:nth-child(2) { display: none; } }
</style>
