---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Social from '../components/Social.astro';
import Reel from '../components/Reel.astro';
import HireNotes from '../components/HireNotes.astro';
import { contact, imagesFor, cover } from '../data/projects';
import { i18n } from '../i18n';
const L = i18n(Astro.url);
const { t } = L;
---
<Base title={t('Contact', 'تواصل')} description={t('Contact Aya Hassan for concept design roles, collaborations with design firms and selected private commissions.', 'تواصل مع آية حسن لوظائف التصميم المبدئي، والتعاون مع مكاتب التصميم، ومشاريع خاصة مختارة.')}>
  <PageHero images={[imagesFor('stc-hq')[2], imagesFor('misr-italia-hilltop')[1]]} alt={t('Interior of the stc headquarters', 'التصميم الداخلي لمقر stc')} meta={L.ar ? [['المقر', 'القاهرة، مصر'], ['اللغات', 'العربية · الإنجليزية']] : [['Based in', 'Cairo, Egypt'], ['Languages', 'Arabic · English']]}>
    <h1 class="display-xl lines"><span class="ln"><span>{t('Let’s talk', 'لنتحدث')}</span></span><span class="ln"><span>{L.ar ? <>عن <em>مشروعك.</em></> : <>about your <em>project.</em></>}</span></span></h1>
    <p class="lede">{t('For concept design roles, collaborations with design firms, and selected private commissions in Saudi Arabia, the Gulf and Egypt.', 'لوظائف التصميم المبدئي، والتعاون مع مكاتب التصميم، ومشاريع خاصة مختارة في السعودية والخليج ومصر.')}</p>
  </PageHero>

  <HireNotes />

  <section class="wrap rows">
    <div class="row"><label class="label muted" for="topic">{t('What is it about?', 'موضوع رسالتك')}<span class="hint">{t('Pick one — it becomes the subject of your email.', 'اختر واحدًا، وسيصبح عنوان رسالتك.')}</span></label>
      <select id="topic" class="v sel" data-topic>
        <option value="job">{t('Job opportunity', 'فرصة عمل')}</option>
        <option value="project" selected>{t('Project', 'مشروع')}</option>
        <option value="studio">{t('Studio support', 'دعم للاستوديوهات')}</option>
      </select><span class="arr" aria-hidden="true">↓</span></div>
    <div class="row"><span class="label muted">{t('Email', 'البريد')}</span><a href={`mailto:${contact.email}`} class="v link" id="em" dir="ltr">{contact.email.split("@")[0]}<wbr />@{contact.email.split("@")[1]}</a><span class="reply label muted">{t('I typically reply within 24 hours.', 'أردّ عادةً خلال 24 ساعة.')}</span><button type="button" class="btn copy" data-copy="em" data-done={t('Copied', 'تم النسخ')}>{t('Copy', 'انسخ')}</button></div>
    <div class="row"><span class="label muted">{t('Social', 'التواصل')}</span><Social size="l" /><span></span></div>
    <div class="row"><span class="label muted">CV</span><a href={L.u('/cv/#cv')} class="v link">{t('View or download', 'اعرض أو حمّل')}</a><span class="arr">{L.next}</span></div>
    <div class="row"><span class="label muted">{t('Portfolio', 'ملف الأعمال')}</span><a href={L.u('/cv/#portfolio')} class="v link">{t('View or download', 'اعرض أو حمّل')}</a><span class="arr">{L.next}</span></div>
  </section>

  <Reel rows={[['misr-italia-hilltop', 'sabic-hq', 'neom-oxagon', 'arches-restaurant', 'bmw-showroom', 'tech-park', 'linah-farms'].map((s) => cover(s)!)]} />
</Base>

<script>
  // topic dropdown: pre-select from ?type=, and put the topic in the email subject
  {
    const sel = document.querySelector<HTMLSelectElement>('[data-topic]');
    const em = document.getElementById('em') as HTMLAnchorElement | null;
    if (sel && em) {
      const type = new URLSearchParams(location.search).get('type');
      if (type && [...sel.options].some((o) => o.value === type)) sel.value = type;
      const base = em.getAttribute('href')!.split('?')[0];
      const set = () => { em.href = `${base}?subject=${encodeURIComponent(sel.selectedOptions[0].text + ' · ayahassan.com')}`; };
      sel.addEventListener('change', set); set();
    }
  }
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) => b.addEventListener('click', async () => {
    const el = document.getElementById(b.dataset.copy!)!;
    try { await navigator.clipboard.writeText(el.textContent ?? ''); const was = b.textContent; b.textContent = b.dataset.done ?? 'Copied'; setTimeout(() => (b.textContent = was), 1600); }
    catch { const r = document.createRange(); r.selectNodeContents(el); const s = getSelection(); s?.removeAllRanges(); s?.addRange(r); }
  }));
</script>

<style>
  .rows { padding-top: clamp(64px, 8vw, 120px); padding-bottom: clamp(80px, 10vw, 150px); }
  .row { display: grid; grid-template-columns: 160px 1fr auto; gap: 16px; align-items: center; padding-block: clamp(20px, 2.6vw, 34px); border-top: 1px solid var(--rule); }
  .row:last-child { border-bottom: 1px solid var(--rule); }
  .v { font: 800 clamp(24px, 3.2vw, 46px)/1.1 var(--display); overflow-wrap: break-word; }
  #em { font-family: "Archivo Variable", sans-serif; }
  .v:hover { color: var(--ox); }
  .hint { display: block; margin-top: 6px; text-transform: none; letter-spacing: 0; font-size: 12.5px; opacity: .85; }
  .reply { grid-column: 2; grid-row: 2; margin-top: -6px; text-transform: none; letter-spacing: .02em; font-size: 13px; }
  .sel { appearance: none; -webkit-appearance: none; background: none; border: 0; padding: 0; color: var(--ink); cursor: pointer; width: 100%; }
  .sel:focus-visible { outline: 2px solid var(--ox); outline-offset: 6px; }
  .copy { padding: 12px 16px; background: none; cursor: pointer; color: var(--ink); }
  .arr { font-size: 22px; color: var(--ox); }
  @media (max-width: 640px) { .row { grid-template-columns: 1fr auto; } .row > .label { grid-column: 1 / -1; } }
</style>
