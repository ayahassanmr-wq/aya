---
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { projects, imagesFor, drawingsFor, fileFor, disciplinesFor, projectNo, sectionTotal, clientLogo, ordered, type Project } from '../../data/projects';
import Scope from '../../components/Scope.astro';
import { i18n, localize, place as placeOf } from '../../i18n';

export function getStaticPaths() {
  return projects.map((p, i) => ({ params: { slug: p.slug }, props: { p, prev: projects[(i - 1 + projects.length) % projects.length], next: projects[(i + 1) % projects.length], i } }));
}
interface Props { p: Project; prev: Project; next: Project; i: number }
const L = i18n(Astro.url);
const { t, u } = L;
const p = localize(Astro.props.p, L.ar), prev = localize(Astro.props.prev, L.ar), next = localize(Astro.props.next, L.ar);
const disc = p.category === 'architecture' ? t('Architecture', 'العمارة') : t('Interiors', 'التصميم الداخلي');
const [hero, ...rest] = imagesFor(p.slug);
const allDrawings = drawingsFor(p.slug);
const studyIdx = new Set((p.studies ?? []).map((n) => n - 1));
const studies = allDrawings.map((d, k) => ({ d, k })).filter((x) => studyIdx.has(x.k));
const drawings = allDrawings.filter((_, k) => !studyIdx.has(k));
const drawK = allDrawings.map((_, k) => k).filter((k) => !studyIdx.has(k));
const bim = disciplinesFor(p).has('BIM');
const process = (p.process ?? []).map(([label, name]) => ({ label, img: fileFor(p.slug, name) })).filter((x) => x.img);
const nextCover = imagesFor(next.slug)[0];
const place = placeOf(p);
const no = projectNo(p.slug);
const logo = clientLogo(p.slug);
// full-size sources for the lightbox
const all = [hero, ...rest, ...allDrawings].filter(Boolean);
const big = await Promise.all(all.map(async (m) => (await getImage({ src: m, width: 2000, format: 'webp' })).src));
// gallery rhythm: full · pair · offset · pair …
const layout = (k: number, n: number) => { const m = k % 4; if (m === 0) return 'full'; if (m === 3) return 'offset'; return (k === n - 1 && m === 1) ? 'full' : 'half'; };
---
<Base title={p.title} description={p.summary ?? (L.ar ? `${p.title}، ${place}. مشروع ${p.sector} من أعمال آية حسن.` : `${p.title}, ${place}. ${p.sector} project by Aya Hassan.`)} image={hero?.src} overHero>
  <div class="progress" aria-hidden="true"></div>
  <article data-lb-src={JSON.stringify(big)}>
    <!-- 01 hero -->
    <header class="hero">
      {hero && <div class="para bgwrap"><Image src={hero} alt={`${p.title}, ${place}`} widths={[900, 1600, 2000]} sizes="100vw" loading="eager" fetchpriority="high" data-parallax="0.2" data-scale="1.18" /></div>}
      <div class="veil"></div>
      <div class="wrap hi">
        <nav class="crumbs label" aria-label={t('Breadcrumb', 'مسار التصفح')}><a href={u('/work/')} class="link">{L.back} {t('All work', 'كل الأعمال')}</a></nav>
        <div class="pno" aria-label={`${t('Project', 'مشروع')} ${no}`}><span class="label">{t('Project', 'مشروع')}</span><span class="big" dir="ltr">{no}<small>/{sectionTotal(p.slug)}</small></span></div>
        <h1 class="display-xl lines"><span class="ln"><span>{p.title}</span></span></h1>
        <div class="hmeta label"><span>{place}</span><span>{disc} · {p.sector}</span>{p.concept && <span class="tag">{t('Concept exploration', 'استكشاف مبدئي')}</span>}</div>
      </div>
    </header>

    <!-- 02 title block -->
    <section class="wrap tb">
      {(p.role || p.team) && (
        <dl class="block rt">
          {p.role && <div><dt class="label">{t('My role', 'دوري')}</dt><dd>{L.ar ? (p.roleAr ?? p.role) : p.role}</dd></div>}
          {p.team && <div><dt class="label">{t('Team size', 'حجم الفريق')}</dt><dd>{p.team}</dd></div>}
        </dl>
      )}
      <dl class="block">
        <div><dt class="label">{t('Location', 'الموقع')}</dt><dd>{place}</dd></div>
        <div><dt class="label">{t('Discipline', 'التخصص')}</dt><dd>{disc} · {p.sector}</dd></div>
        <div><dt class="label">{t('Practice', 'المكتب')}</dt><dd>{L.ar ? ({ 'ZFP': 'زهير فايز ومشاركوه · ZFP', 'Cosmos Studio': 'كوزموس ستوديو', 'Innovation Design Studio': 'إنوفيشن ديزاين ستوديو' } as Record<string, string>)[p.practice ?? ''] ?? 'عمل مستقل' : p.practice === 'ZFP' ? 'ZFP · Zuhair Fayez Partnership' : p.practice ?? 'Independent / portfolio'}</dd></div>
        <div class="cli"><dt class="label">{t('Client', 'العميل')}</dt><dd>{logo && <img src={logo} alt="" class="clogo" />}<span>{p.client ?? '—'}</span></dd></div>
        <div><dt class="label">{t('Year', 'السنة')}</dt><dd>{p.year ?? '—'}</dd></div>
        <div class="wide"><dt class="label">{t('Scope', 'النطاق')}</dt><dd class="sc"><Scope p={p} variant="full" />{!L.ar && <span class="det">{p.scope.join(' · ')}</span>}{p.scopeNote && <span class="det note">{L.ar ? (p.scopeNoteAr ?? p.scopeNote) : p.scopeNote}</span>}</dd></div>
      </dl>
    </section>

    <!-- 03 brief -->
    <section class="wrap brief">
      <h2 class="label muted reveal">{t('Brief', 'نبذة')}</h2>
      <div class="bt">
        {p.summary && <p class="statement reveal">{p.summary}</p>}
        {p.overview && <div class="ov reveal">{p.overview.map((x) => <p>{x}</p>)}</div>}
        {(p.deliverables || p.links) && (
          <div class="aside reveal">
            {p.deliverables && <div><h2 class="label muted">{t('Deliverables', 'المخرجات')}</h2><ul>{p.deliverables.map((d) => <li>{d}</li>)}</ul></div>}
            {p.links && <div><h2 class="label muted">{t('Client', 'العميل')}</h2><ul class="lk">{p.links.map((l) => <li><a href={l.url} target="_blank" rel="noopener" class="link">{l.label} <span class="arr">↗</span></a></li>)}</ul></div>}
          </div>
        )}
        {p.concept && <p class="note reveal">{t('AI-assisted concept explorations, used to study mood, light and material. Not presented as final renders.', 'استكشافات مبدئية بمساعدة الذكاء الاصطناعي لدراسة الأجواء والضوء والمواد، ولا تُعرض بوصفها صورًا نهائية.')}</p>}
      </div>
    </section>

    <!-- 04 visuals -->
    {rest.length > 0 && (
      <section class="wrap gal">
        <div class="sheet-head"><h2 class="label">{t('Visuals', 'الصور')}</h2></div>
        {hero && <button type="button" class="cover lb" data-lb={0} data-cursor={t('Open', 'افتح')} aria-label={t('Open cover image', 'افتح صورة الغلاف')}><Image src={hero} alt={`${p.title}, ${t('cover view', 'المنظور الرئيسي')}`} widths={[900, 1600, 2400]} sizes="100vw" /></button>}
        {studies.length > 0 && (
          <div class="studies dgrid">
            {studies.map(({ d, k }) => (
              <figure class:list={['reveal', { wide: d.width / d.height > 1.45 || p.fullSheets?.includes(k + 1), full: p.fullSheets?.includes(k + 1) }]}>
                <button type="button" class="paper lb" data-lb={rest.length + 1 + k} data-cursor={t('Open', 'افتح')} aria-label={`${t('Open drawing', 'افتح الرسم')} ${k + 1}`}><Image src={d} alt={`${p.title}, ${p.captions?.[k] ?? ''}`} widths={[900, 1600, 2400]} sizes="100vw" /></button>
                {p.captions?.[k] && <figcaption class="label muted">{p.captions[k]}</figcaption>}
              </figure>
            ))}
          </div>
        )}
        <div class="grid">
          {rest.map((img, k) => (
            <figure class:list={[layout(k, rest.length)]}>
              <button type="button" class="para zoom lb wipe" data-lb={k + 1} data-cursor={t('Open', 'افتح')} aria-label={`${t('Open image', 'افتح الصورة')} ${k + 2}`}>
                <Image src={img} alt={`${p.title}, ${t('view', 'منظور')} ${k + 2}`} widths={[700, 1200, 1800]} sizes={layout(k, rest.length) === 'full' ? '100vw' : '(min-width: 760px) 50vw, 100vw'} data-parallax="0.07" data-scale="1.1" />
              </button>
            </figure>
          ))}
        </div>
      </section>
    )}

    <!-- 05 drawings -->
    {drawings.length > 0 && (
      <section class="dark draw sheet" data-sp>
        <div class="wrap">
          <div class="sheet-head"><h2 class="label">{bim ? t('BIM package', 'حزمة BIM') : t('Drawings & diagrams', 'الرسومات والمخططات')}</h2>{bim && <span class="label muted">{t('Revit · coordinated model & drawing set', 'Revit · نموذج منسق ومجموعة رسومات')}</span>}</div>
          {process.length > 1 && (
            <ol class="proc reveal" aria-label={t('From concept to model', 'من الفكرة إلى النموذج')}>
              {process.map((s, k) => (
                <li>
                  <div class="pimg"><Image src={s.img!} alt={`${p.title}: ${s.label}`} widths={[500, 900]} sizes="(min-width: 760px) 30vw, 100vw" /></div>
                  <span class="label"><span class="pn2">{String(k + 1).padStart(2, '0')}</span>{s.label}</span>
                </li>
              ))}
            </ol>
          )}
          <div class="dgrid">
            {drawings.map((d, j) => { const k = drawK[j]; return (
              <figure class:list={['reveal', { wide: d.width / d.height > 1.45 || p.fullSheets?.includes(k + 1), full: p.fullSheets?.includes(k + 1) }]}>
                <button type="button" class="paper lb" data-sheet={`A-${String(k + 1).padStart(3, "0")}`} data-lb={rest.length + 1 + k} data-cursor={t('Open', 'افتح')} aria-label={`${t('Open drawing', 'افتح الرسم')} ${k + 1}`}><Image src={d} alt={`${p.title}, ${p.captions?.[k] ?? `${t('drawing', 'رسم')} ${k + 1}`}`} widths={[600, 1100]} sizes="(min-width: 760px) 50vw, 100vw" /></button>
                {p.captions?.[k] && <figcaption class="label muted">{String(k + 1).padStart(2, '0')} · {p.captions[k]}</figcaption>}
              </figure>
            ); })}
          </div>
        </div>
      </section>
    )}

    <!-- 06 film -->
    {p.video && (
      <section class="dark film sheet" data-sp>
        <div class="wrap">
          <div class="sheet-head"><h2 class="label">{t('Film', 'فيلم')}</h2><span class="label muted">{p.video.title ?? t('Animation', 'تحريك')}</span></div>
          <div class="screen reveal">
            {p.video.file && <video src={p.video.file} poster={p.video.poster ?? hero?.src} controls playsinline preload="none"></video>}
            {p.video.youtube && <iframe src={`https://www.youtube-nocookie.com/embed/${p.video.youtube}?rel=0`} title={p.video.title ?? p.title} loading="lazy" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe>}
            {p.video.vimeo && <iframe src={`https://player.vimeo.com/video/${p.video.vimeo}?dnt=1`} title={p.video.title ?? p.title} loading="lazy" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe>}
          </div>
        </div>
      </section>
    )}

    <!-- 07 prev / next -->
    <nav class="pn wrap" aria-label={t('More projects', 'مشاريع أخرى')}>
      <a href={u(`/work/${prev.slug}/`)} class="label link">{L.back} {prev.title}</a>
      <a href={u('/work/')} class="label link">{t('Index', 'الفهرس')}</a>
    </nav>
    <a href={u(`/work/${next.slug}/`)} class="next" data-cursor={t('Next', 'التالي')}>
      {nextCover && <div class="para nb"><Image src={nextCover} alt="" widths={[900, 1600]} sizes="100vw" data-parallax="0.12" data-scale="1.15" /></div>}
      <div class="veil"></div>
      <div class="wrap ni"><span class="label">{t('Next project', 'المشروع التالي')}</span><span class="display-l">{next.title}</span><span class="label go">{t('Open project', 'افتح المشروع')} <span class="arr">{L.next}</span></span></div>
    </a>
  </article>

  <!-- lightbox -->
  <div class="lbx" hidden role="dialog" aria-modal="true" aria-label={t('Image viewer', 'عارض الصور')}>
    <img alt="" />
    <button type="button" class="x label glass-dark" data-x>{t('Close', 'إغلاق')} <span aria-hidden="true">✕</span></button>
    <button type="button" class="nav pv glass-dark" data-d="-1" aria-label={t('Previous image', 'الصورة السابقة')}>{L.back}</button>
    <button type="button" class="nav nx glass-dark" data-d="1" aria-label={t('Next image', 'الصورة التالية')}>{L.next}</button>
    <span class="cnt label glass-dark" aria-live="polite"></span>
  </div>
</Base>

<script>
  const art = document.querySelector<HTMLElement>('[data-lb-src]');
  const box = document.querySelector<HTMLElement>('.lbx');
  if (art && box) {
    const src: string[] = JSON.parse(art.dataset.lbSrc!);
    const img = box.querySelector('img')!; const cnt = box.querySelector('.cnt')!;
    let i = 0;
    const show = (k: number) => { i = (k + src.length) % src.length; img.src = src[i]; img.alt = `${document.title.split(' · ')[0]}, image ${i + 1} of ${src.length}`; cnt.textContent = `${String(i + 1).padStart(2, '0')} / ${String(src.length).padStart(2, '0')}`; };
    let opener: HTMLElement | null = null;
    const lenis = () => (window as any).__lenis;
    const open = (k: number, from: HTMLElement) => { opener = from; show(k); box.hidden = false; requestAnimationFrame(() => box.classList.add('on')); document.body.style.overflow = 'hidden'; lenis()?.stop(); box.querySelector<HTMLElement>('[data-x]')!.focus(); };
    const close = () => { box.classList.remove('on'); setTimeout(() => (box.hidden = true), 400); document.body.style.overflow = ''; lenis()?.start(); opener?.focus(); };
    document.querySelectorAll<HTMLElement>('[data-lb]').forEach((b) => b.addEventListener('click', () => open(+b.dataset.lb!, b)));
    // keep focus inside the viewer
    box.addEventListener('keydown', (e) => { if (e.key !== 'Tab') return; const f = [...box.querySelectorAll<HTMLElement>('button')]; const a = f[0], z = f[f.length - 1];
      if (e.shiftKey && document.activeElement === a) { e.preventDefault(); z.focus(); } else if (!e.shiftKey && document.activeElement === z) { e.preventDefault(); a.focus(); } });
    box.querySelector('[data-x]')!.addEventListener('click', close);
    box.querySelectorAll<HTMLElement>('[data-d]').forEach((b) => b.addEventListener('click', () => show(i + +b.dataset.d!)));
    box.addEventListener('click', (e) => { if (e.target === box) close(); });
    addEventListener('keydown', (e) => { if (box.hidden) return; if (e.key === 'Escape') close(); if (e.key === 'ArrowRight') show(i + 1); if (e.key === 'ArrowLeft') show(i - 1); });
  }
</script>

<style>
  .hero { border-radius: 0 0 var(--r-xl) var(--r-xl); position: relative; height: var(--hero-h); display: flex; align-items: flex-end; color: var(--ow); overflow: hidden; background: var(--night); }
  .bgwrap { position: absolute; inset: 0; }
  .bgwrap :global(img) { width: 100%; height: 100%; object-fit: cover; transform: scale(1.18); }
  .veil { position: absolute; inset: 0; background: rgba(32, 28, 27, .5); }
  .hi { position: relative; z-index: 5; padding-top: 140px; padding-bottom: clamp(28px, 4vw, 52px); display: grid; gap: 22px; }
  .crumbs { display: flex; flex-wrap: wrap; gap: 6px 12px; color: rgba(243,237,227,.82); }
  h1 { max-width: 14ch; }
  .hmeta { font-size: 12px; display: flex; flex-wrap: wrap; gap: 10px 28px; align-items: center; padding-top: 18px; border-top: 1px solid var(--rule-light); opacity: .9; }
  [dir="rtl"] .hmeta { margin-top: 22px; }

  .pno { display: flex; flex-direction: column; gap: 6px; color: var(--sand); }
  .pno .big { font-family: "Archivo Variable", sans-serif; font-weight: 800; font-stretch: 125%; font-size: clamp(72px, 11vw, 190px); line-height: .8; letter-spacing: -.03em; color: var(--ow); }
  .pno small { font-size: .22em; font-weight: 500; letter-spacing: .1em; color: var(--sand); margin-inline-start: .4em; vertical-align: top; }
  .cli dd { display: grid; gap: 10px; justify-items: start; }
  .clogo { height: 38px; width: auto; max-width: 150px; object-fit: contain; }
  .tb { padding-block: 0; }
  .block { margin: 0; display: grid; grid-template-columns: 1.3fr 1.3fr 1.1fr 1.3fr .7fr; border-bottom: 1px solid var(--rule); }
  .block div { padding: 20px 18px 20px 0; border-right: 1px solid var(--rule); display: grid; gap: 6px; align-content: start; }
  .block div + div { padding-left: 18px; }
  .block.rt { grid-template-columns: 4fr 1fr; }
  .block.rt div:last-child { border-right: 0; }
  .block.rt div:only-child { grid-column: 1 / -1; }
  .block.rt dd { font-size: 17px; }
  .block .wide { grid-column: 1 / -1; border-top: 1px solid var(--rule); border-right: 0; padding-left: 0 !important; }
  .block div:nth-child(5) { border-right: 0; }
  dt { color: var(--muted); font-size: 11.5px; }
  .sc { display: grid; gap: 12px; }
  .det { font-size: 13px; color: var(--muted); }
  .proc { list-style: none; margin: 28px 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(12px, 2vw, 28px); counter-reset: s; }
  .proc li { display: grid; gap: 12px; position: relative; }
  .proc li + li::before { content: "→"; position: absolute; left: calc(-1 * clamp(12px, 2vw, 28px) / 2); top: 42%; transform: translate(-50%, -50%); color: var(--sand); font-size: 18px; }
  .pimg { aspect-ratio: 4 / 3; background: var(--ow); overflow: hidden; border-radius: var(--r-1); }
  .pimg :global(img) { width: 100%; height: 100%; object-fit: contain; }
  .proc li:last-child .pimg :global(img) { object-fit: cover; }
  .pn2 { color: var(--sand); margin-right: 10px; }
  .draw figcaption { color: var(--muted-dark); }
  @media (max-width: 760px) { .proc { grid-template-columns: 1fr; } .proc li + li::before { content: "↓"; left: 50%; top: -14px; } }
  dd { margin: 0; font-size: 15px; }
  @media (max-width: 860px) { .block { grid-template-columns: 1fr 1fr; } .block div { border-right: 0 !important; padding-left: 0 !important; border-top: 1px solid var(--rule); } }

  .brief { display: grid; grid-template-columns: 1fr 3fr; gap: 32px; padding-block: clamp(64px, 9vw, 140px); }
  .bt { display: grid; gap: 32px; }
  .statement { font: 800 clamp(26px, 3vw, 46px)/1.2 var(--display); text-wrap: pretty; }
  .ov { columns: 2 320px; column-gap: 48px; color: var(--ink-2); }
  .ov p + p { margin-top: 1em; }
  .aside { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; padding-top: 24px; border-top: 1px solid var(--rule); }
  .aside h2 { margin-bottom: 12px; }
  ul { margin: 0; padding: 0; list-style: none; display: grid; gap: 6px; }
  .aside li::before { content: "— "; color: var(--ox); }
  .aside .lk li::before { content: none; }
  .lk a { font: 400 18px var(--sans); }
  .note { font-size: 13px; color: var(--muted); border-left: 2px solid var(--ox); padding-left: 14px; }
  @media (max-width: 860px) { .brief { grid-template-columns: 1fr; } .aside { grid-template-columns: 1fr; } }

  .gal { padding-bottom: clamp(80px, 10vw, 140px); }
  .grid { display: grid; grid-template-columns: repeat(12, 1fr); gap: clamp(16px, 2vw, 28px); margin-top: 28px; }
  figure { margin: 0; display: grid; gap: 10px; min-width: 0; }
  .grid > *, .dgrid > * { min-width: 0; }
  figcaption { font-size: 11.5px; }
  .full { grid-column: 1 / -1; } .full .para { aspect-ratio: 16 / 8; }
  .half { grid-column: span 6; } .half .para { aspect-ratio: 4 / 3; }
  .offset { grid-column: 4 / span 9; } .offset .para { aspect-ratio: 16 / 10; }
  .lb { all: unset; box-sizing: border-box; display: block; cursor: zoom-in; width: 100%; max-width: 100%; overflow: hidden; }
  .lb:focus-visible { outline: 2px solid var(--ox); outline-offset: 4px; }
  .para :global(img) { width: 100%; height: 100%; object-fit: cover; transform: scale(1.1); }
  @media (max-width: 760px) { .half, .offset { grid-column: 1 / -1; } .full .para { aspect-ratio: 4 / 3; } }


  /* cover, shown whole */
  .cover { margin-top: 28px; }
  .studies { margin-top: clamp(16px, 2vw, 28px); }
  .studies .paper { background: #F3EDE3; }
  .studies figcaption { margin-top: 8px; }
  .cover :global(img) { width: 100%; height: auto; display: block; }
  .gal .grid { margin-top: clamp(16px, 2vw, 28px); }


  .draw { padding-block: clamp(64px, 9vw, 130px); }
  .dgrid > .wide { grid-column: 1 / -1; }
  .dgrid > .full .paper :global(img) { max-height: none; }
  .dgrid { grid-auto-flow: row dense; }
  .dgrid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(16px, 2vw, 28px); margin-top: 28px; }
  /* THE DRAWING SHEET — plans, elevations, BIM captures and diagrams sit on a clean bone sheet
     against the night section: full colour kept (only a light warm unify), natural proportions,
     a hairline oxblood rule and a sheet-number strip underneath. */
  .paper { position: relative; display: flex; flex-direction: column; width: 100%; border: 0; cursor: zoom-in; background: #F3EDE3; padding: clamp(14px, 2vw, 32px) clamp(14px, 2vw, 32px) 0; box-shadow: 0 30px 60px -30px rgba(0, 0, 0, .55); transition: transform .6s var(--ease), box-shadow .6s var(--ease); }
  .paper:hover { transform: translateY(-6px); box-shadow: 0 40px 70px -30px rgba(0, 0, 0, .7); }
  .paper :global(img) { width: 100%; height: auto; max-height: 78vh; object-fit: contain; filter: none !important; }
  .paper::after { content: attr(data-sheet); display: block; margin-top: clamp(12px, 1.6vw, 22px); padding: 12px 0 14px; border-top: 1px solid var(--ox); text-align: end; font-family: var(--sans); font-weight: 600; font-size: 10.5px; line-height: 1; letter-spacing: .22em; color: var(--ox); }
  .dgrid { align-items: start; }
  @media (max-width: 760px) { .dgrid { grid-template-columns: 1fr; } }

