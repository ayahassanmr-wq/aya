---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getImage } from 'astro:assets';
import { projects, cover, countries, type Project } from '../../data/projects';
import { i18n, localize, place } from '../../i18n';
const L = i18n(Astro.url);
const { t, u } = L;
const isBim = (p: Project) => p.scope.some((x) => /BIM|IFC/i.test(x));
const groupBy = (list: Project[]) => {
  const m = new Map<string, Project[]>();
  list.forEach((p) => m.set(p.sector, [...(m.get(p.sector) ?? []), p]));
  return [...m.entries()].sort((a, b) => b[1].length - a[1].length).map(([k, v]) => ({ key: k, name: localize(v[0], L.ar).sector, list: v }));
};
const prev = Object.fromEntries(await Promise.all(projects.map(async (p) => [p.slug, (await getImage({ src: cover(p.slug)!, width: 700, format: 'webp' })).src])));
const disciplines = await Promise.all([
  { id: 'architecture', n: '01', name: t('Architectural design', 'التصميم المعماري'), line: t('Buildings, from the first massing to the last render.', 'مبانٍ، من الكتلة الأولى حتى آخر صورة.'), img: 'neom-oxagon', list: projects.filter((p) => p.category === 'architecture') },
  { id: 'interiors', n: '02', name: t('Interior design', 'التصميم الداخلي'), line: t('Workplaces, homes and showrooms, down to the finish.', 'بيئات عمل ومساكن ومعارض، حتى آخر تشطيب.'), img: 'sabic-hq', list: projects.filter((p) => p.category === 'interiors') },
  { id: 'bim', n: '03', name: t('BIM & technical', 'BIM والتقني'), line: t('Full Revit packages: modelled, coordinated, issued.', 'حزم Revit كاملة: نمذجة وتنسيق وإصدار.'), img: 'linah-farms', list: projects.filter(isBim) },
].map(async (d) => ({ ...d, groups: groupBy(d.list), src: (await getImage({ src: cover(d.img)!, width: 1600, format: 'webp' })).src })));
---
<Base title={t('Selected work', 'أعمال مختارة')} description={L.ar ? `أعمال مختارة لآية حسن: ${projects.length} مشروعًا في العمارة والتصميم الداخلي وBIM، في الخليج ومصر وخارجهما.` : `Selected work by Aya Hassan: ${projects.length} projects across architecture, interior design and BIM, in the Gulf, Egypt and beyond.`}>
  <PageHero images={['misr-italia-hilltop', 'sabic-hq', 'neom-oxagon', 'zayed-residence'].map((x) => cover(x)!)} alt={t('Selected projects by Aya Hassan', 'مشاريع مختارة لآية حسن')} meta={[[t('Selected', 'مختارة'), String(projects.length)], ...disciplines.map((d) => [d.name, String(d.list.length)] as [string, string]), [t('Countries', 'دول'), String(countries.length)]]}>
    <h1 class="display-xl lines"><span class="ln"><span>{t('Selected', 'أعمال')}</span></span><span class="ln"><span><em>{t('work.', 'مختارة.')}</em></span></span></h1>
  </PageHero>

  <!-- 1 · disciplines, a section of its own -->
  <section class="disc" aria-labelledby="disc-h">
    <div class="wrap">
      <div class="dtop">
        <p class="label muted">{t('The work, in three parts', 'الأعمال في ثلاثة أجزاء')}</p>
        <h2 id="disc-h" class="dtitle reveal">{t('Three disciplines.', 'ثلاثة تخصصات.')}<br /><em>{t('One hand.', 'يدٌ واحدة.')}</em></h2>
      </div>
      <div class="dl">
        {disciplines.map((d) => (
          <a class="d" href={`#${d.id}`} data-jump={d.id}>
            <span class="img" style={`background-image:url(${d.src})`} aria-hidden="true"></span>
            <span class="n label">{d.n}</span>
            <span class="nm">{d.name}</span>
            <span class="ln2">{d.line}</span>
            <span class="ct label">{d.list.length} {t('projects', 'مشروعًا')} <span class="arr">↓</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <div class="works">
  <!-- 2 · sticky chapter bar -->
  <div class="wrap head">
    <nav class="bar glass" aria-label={t('Disciplines', 'التخصصات')}>
      <ol class="chap">
        {disciplines.map((d) => <li><a href={`#${d.id}`} data-chap={d.id}><span class="cn">{d.n}</span>{d.name}<sup>{d.list.length}</sup></a></li>)}
      </ol>
      <div class="views" role="group" aria-label={t('View', 'طريقة العرض')}>
        <button type="button" data-v="grid" aria-pressed="true">{t('Grid', 'شبكة')}</button>
        <button type="button" data-v="list" aria-pressed="false">{t('List', 'قائمة')}</button>
      </div>
    </nav>
  </div>

  <!-- 3 · the work, one chapter per discipline -->
  {disciplines.map((d) => (
    <section class="chapter" id={d.id} aria-labelledby={`${d.id}-h`} data-chapter={d.id}>
      <header class="wrap ch">
        <span class="big" aria-hidden="true">{d.n}</span>
        <div class="cht">
          <p class="label muted">{t('Discipline', 'التخصص')} {d.n} / 03</p>
          <h2 id={`${d.id}-h`} class="chn">{d.name}</h2>
          <p class="chl">{d.line}</p>
        </div>
        <p class="label muted chc">{d.list.length} {t('projects', 'مشروعًا')}</p>
      </header>
      <div class="wrap band reveal" aria-hidden="true"><span style={`background-image:url(${d.src})`}></span></div>
      <div class="wrap">
        <div data-view="grid">
          {d.groups.map((g, gi) => (
            <section class="grp" aria-label={g.name}>
              <header class="gh"><span class="label gn">{d.n}.{String(gi + 1).padStart(2, '0')}</span><h3 class="gt">{g.name}</h3><span class="label muted">{g.list.length}</span></header>
              <div class="grid stagger">{g.list.map((p) => <div class="it"><ProjectCard p={p} /></div>)}</div>
            </section>
          ))}
        </div>
        <ol class="list" data-view="list" hidden>
          {d.list.map((p0) => { const p = localize(p0, L.ar); return (
            <li class="it">
              <a href={u(`/work/${p.slug}/`)} data-preview={prev[p.slug]}>
                <span class="t">{p.title}{p.concept && <span class="tag">{t('Concept', 'مبدئي')}</span>}</span>
                <span class="muted">{place(p)}</span>
                <span class="label muted">{p.sector}</span>
                <span class="label muted">{p.practice ?? t('Independent', 'مستقل')}</span>
              </a>
            </li>
          ); })}
        </ol>
      </div>
      <p class="wrap next label"><a href="#disc-h" class="link back" data-back>↑ {t('All disciplines', 'كل التخصصات')}</a></p>
      {false && <p class="wrap next label"><a href={`#${disciplines[disciplines.indexOf(d) + 1].id}`} class="link">{t('Next', 'التالي')}: {disciplines[disciplines.indexOf(d) + 1].name} ↓</a></p>}
    </section>
  ))}
  </div>
</Base>

<script>
  // The work opens on the three disciplines; choosing one shows only its projects, grouped by type.
  const root = document.documentElement; root.classList.add('wk-tabs');
  const chapters = [...document.querySelectorAll<HTMLElement>('[data-chapter]')];
  const show = (id: string | null) => {
    const ok = chapters.some((c) => c.id === id);
    chapters.forEach((c) => (c.hidden = !ok || c.id !== id));
    root.classList.toggle('wk-open', ok);
    document.querySelectorAll<HTMLAnchorElement>('[data-chap]').forEach((l) => l.toggleAttribute('aria-current', l.dataset.chap === id));
    document.querySelectorAll('.reveal, .stagger').forEach((el) => el.classList.remove('pre')); (window as any).__lenis?.resize?.();
    return ok;
  };
  show(location.hash.slice(1));
  const go = (id: string) => { const t = document.getElementById(id)!; const l = (window as any).__lenis;
    if (id === 'disc-h') { show(null); history.replaceState(null, '', location.pathname); }
    else show(id);
    l?.scrollTo ? l.scrollTo(t, { offset: -150 }) : t.scrollIntoView({ behavior: 'smooth' }); history.replaceState(null, '', `#${id}`); };
  document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((a) => a.addEventListener('click', (e) => { e.preventDefault(); go(a.hash.slice(1)); }));
  const vb = document.querySelectorAll<HTMLButtonElement>('[data-v]');
  vb.forEach((b) => b.addEventListener('click', () => {
    vb.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    document.querySelectorAll<HTMLElement>('[data-view]').forEach((v) => (v.hidden = v.dataset.view !== b.dataset.v));
    document.querySelectorAll('.reveal').forEach((el) => el.classList.remove('pre')); (window as any).__lenis?.resize?.();
  }));
</script>

<style>
  :global(.wk-tabs:not(.wk-open)) .works { display: none; }
  .grp { padding-top: clamp(40px, 5vw, 72px); }
  .gh { display: flex; align-items: baseline; gap: 18px; border-bottom: 1px solid var(--rule); padding-bottom: 14px; }
  .gn { color: var(--ox); }
  .gt { flex: 1; margin: 0; font-size: clamp(26px, 2.6vw, 40px); line-height: 1; }
  .grp .grid { padding-block: clamp(28px, 3vw, 44px) 0; }
  .back { color: var(--ox); }
  /* disciplines: three panels; the hovered one widens and its render fades in */
  .disc { padding-block: clamp(96px, 12vw, 180px) clamp(72px, 9vw, 140px); }
  .dtop { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; flex-wrap: wrap; margin-bottom: clamp(32px, 4vw, 56px); }
  .dtitle { margin: 0; font: 800 clamp(44px, 6vw, 104px)/.95 var(--display); letter-spacing: -.02em; text-align: end; }
  .d { cursor: pointer; text-decoration: none; }
  /* chapter bar */
  .chap { display: flex; flex-wrap: wrap; gap: 4px 28px; list-style: none; margin: 0; padding: 0; }
  .chap a { display: inline-flex; align-items: baseline; gap: 8px; min-height: 44px; align-items: center; font: 400 12px var(--sans); letter-spacing: .18em; text-transform: uppercase; color: var(--ink-2); transition: color .25s; }
  .chap .cn { color: var(--grey); font-size: 10px; }
  .chap a:hover, .chap a[aria-current] { color: var(--ox); }
  .chap a[aria-current] .cn { color: var(--ox); }
  /* chapters */
  .chapter { padding-top: clamp(80px, 10vw, 160px); scroll-margin-top: 150px; }
  .ch { display: grid; grid-template-columns: auto 1fr auto; gap: clamp(20px, 3vw, 56px); align-items: end; border-bottom: 1px solid var(--rule); padding-bottom: clamp(24px, 3vw, 40px); }
  .big { font: 800 clamp(110px, 17vw, 300px)/.78 var(--display); color: transparent; -webkit-text-stroke: 1px var(--ox); letter-spacing: -.04em; }
  .cht .label { margin: 0 0 10px; }
  .chn { margin: 0; font: 800 clamp(48px, 7vw, 124px)/.92 var(--display); letter-spacing: -.02em; }
  .chl { margin: 14px 0 0; max-width: 40ch; color: var(--ink-2); }
  .chc { margin: 0; white-space: nowrap; }
  .band { margin-top: clamp(28px, 3vw, 44px); }
  .band span { display: block; height: clamp(180px, 26vw, 400px); background: center/cover no-repeat; border-radius: var(--r-l); }
  .next { padding-bottom: 20px; text-align: end; }
  @media (max-width: 760px) { .ch { grid-template-columns: 1fr; } .big { font-size: 96px; } .dtitle { text-align: start; } .chc { order: 3; } }
  .dl { display: flex; gap: 0; border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); min-height: clamp(360px, 38vw, 560px); }
  .d { position: relative; flex: 1 1 0; display: flex; flex-direction: column; align-items: flex-start; justify-content: flex-end; gap: 14px; text-align: start; padding: clamp(20px, 2.4vw, 36px); border: 0; border-inline-start: 1px solid var(--rule); overflow: hidden; color: var(--ink); text-transform: none; letter-spacing: 0; transition: flex-grow .9s var(--ease-io), color .5s var(--ease); isolation: isolate; }
  .d:first-child { border-inline-start: 0; }
  .d .img { position: absolute; inset: 0; z-index: -1; background: center/cover no-repeat; opacity: 0; transform: scale(1.08); transition: opacity .8s var(--ease), transform 1.4s var(--ease-out); }
  .d .img::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to top, rgba(32,28,27,.82), rgba(32,28,27,.15) 60%); }
  .d .n { position: absolute; top: clamp(20px, 2.4vw, 36px); inset-inline-start: clamp(20px, 2.4vw, 36px); color: var(--ox); }
  .d .nm { font-family: var(--display); font-weight: 800; font-size: clamp(28px, 3.2vw, 60px); line-height: .98; letter-spacing: -.02em; max-width: 9ch; transition: font-style .3s; }
  .d .ln2 { font: 300 15px/1.5 var(--sans); max-width: 30ch; color: var(--ink-2); opacity: 0; transform: translateY(12px); transition: opacity .6s var(--ease), transform .8s var(--ease-out), color .5s; }
  .d .ct { color: var(--ink-2); transition: color .5s; }
  .d .arr { display: inline-block; transition: transform .5s var(--ease); }
  .dl:hover .d { flex-grow: 1; }
  .dl .d:is(:hover, :focus-visible) { flex-grow: 1.6; color: var(--ow); }
  .d:is(:hover, :focus-visible) .img { opacity: 1; transform: scale(1); }
  .d:is(:hover, :focus-visible) .nm { font-style: italic; }
  .d:is(:hover, :focus-visible) :is(.ln2, .ct) { color: var(--muted-ox); opacity: 1; transform: none; }
  .d:is(:hover, :focus-visible) .n { color: var(--sand); }
  .d:is(:hover, :focus-visible) .arr { transform: translateY(4px); }
  .d:focus-visible { outline: 2px solid var(--ox); outline-offset: -2px; }
  @media (hover: none), (max-width: 860px) {
    .dl { flex-direction: column; min-height: 0; }
    .d { border-inline-start: 0; border-top: 1px solid var(--rule); min-height: 220px; color: var(--ow); }
    .d:first-child { border-top: 0; }
    .d .img { opacity: 1; transform: none; }
    .d .img::after { background: linear-gradient(to top, rgba(32,28,27,.88), rgba(32,28,27,.45)); }
    .d .n { color: var(--sand); }
    .d :is(.ln2, .ct) { opacity: 1; transform: none; color: var(--muted-ox); }
    .d .nm { white-space: normal; }
  }
  .head { padding-top: clamp(28px, 3vw, 44px); }
  .bar { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 16px; padding-block: 10px; border: 1px solid var(--rule); border-radius: var(--r-l); background: rgba(243, 237, 227, .86); padding-inline: 22px; }
  .head { position: sticky; top: 80px; z-index: 5; }
  @media (max-width: 760px) { .head { top: 68px; } .bar { padding-block: 0; padding-inline: 16px; } .bar .views { display: none; } .chap { flex-wrap: nowrap; overflow-x: auto; gap: 0 18px; scrollbar-width: none; } .chap a { white-space: nowrap; font-size: 10px; letter-spacing: .12em; } }
  .filters, .views { display: flex; flex-wrap: wrap; gap: 4px 22px; }
  button { background: none; border: 0; padding: 10px 0; min-height: 44px; cursor: pointer; font: 400 12px var(--sans); letter-spacing: .18em; text-transform: uppercase; color: var(--ink-2); transition: color .25s; }
  button[aria-pressed="true"], button:hover { color: var(--ox); }
  sup { font-size: 9px; margin-inline-start: 4px; letter-spacing: 0; }
  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(40px, 4vw, 64px) clamp(24px, 2.4vw, 40px); padding-block: clamp(40px, 5vw, 72px) clamp(40px, 5vw, 72px); }
  @media (max-width: 1000px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .grid { grid-template-columns: 1fr; } }
  .list { list-style: none; margin: 0; padding: 32px 0 72px; }
  .list li { border-bottom: 1px solid var(--rule); }
  .list a { display: grid; grid-template-columns: 2fr 1.4fr 1fr 1fr; gap: 16px; align-items: baseline; padding-block: 20px; transition: color .25s, padding .35s; }
  .list a:hover { color: var(--ox); padding-inline-start: 16px; }
  .list a:hover .t { font-style: italic; }
  .code { color: var(--ox); }
  .list a { transition: color .3s, padding .5s var(--ease); }
  .list .t { font: 800 clamp(22px, 2.2vw, 32px)/1.15 var(--display); display: flex; gap: 12px; align-items: center; flex-wrap: wrap; }
  .list .tag { font-size: 9px; }
  @media (max-width: 760px) { .list a { grid-template-columns: 1fr; gap: 4px; } }
</style>
