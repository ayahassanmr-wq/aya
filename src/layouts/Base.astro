---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/archivo/wdth-italic.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Intro from '../components/Intro.astro';
import { i18n } from '../i18n';
interface Props { title?: string; description?: string; image?: string; overHero?: boolean; intro?: boolean; preloadImage?: { srcset: string; sizes: string } }
const {
  title,
  description = 'Aya Hassan is an architect and interior designer in concept design, based in Cairo: workplaces, public buildings, residences and interiors across six countries.',
  image = '/og.jpg',
  overHero = false,
  intro = false,
  preloadImage,
} = Astro.props;
const L = i18n(Astro.url);
const desc = L.ar && description.startsWith('Aya Hassan is an architect') ? 'آية حسن معمارية ومصممة داخلية في مرحلة التصميم المبدئي، مقيمة في القاهرة: مبانٍ إدارية وعامة ومساكن وتصميم داخلي في ست دول.' : description;
const fullTitle = title ? `${title} · ${L.t('Aya Hassan', 'آية حسن')}` : L.t('Aya Hassan · Architect & Interior Designer', 'آية حسن · معمارية ومصممة داخلية');
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---
<!doctype html>
<html lang={L.lang} dir={L.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="alternate" hreflang="en" href={new URL(L.enPath, Astro.site)} />
    <link rel="alternate" hreflang="ar" href={new URL(L.arPath, Astro.site)} />
    <meta name="theme-color" content="#5E1A24" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:locale" content={L.ar ? 'ar_EG' : 'en_US'} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      // a refresh always starts at the top of the page (the browser would otherwise jump back to the last section)
      // (back/forward navigation still returns to where you were)
      (function () {
        var n = performance.getEntriesByType && performance.getEntriesByType('navigation')[0];
        var reload = n ? n.type === 'reload' : (performance.navigation && performance.navigation.type === 1);
        try { history.scrollRestoration = reload ? 'manual' : 'auto'; } catch (e) {}
        if (reload && !location.hash) {
          window.__top = true; window.scrollTo(0, 0);
          addEventListener('load', function () { window.scrollTo(0, 0); });
        }
      })();
    </script>
    <link rel="preload" href={L.ar ? '/fonts/alexandria-arabic-wght-normal.woff2' : '/fonts/syne-latin-800-normal.woff2'} as="font" type="font/woff2" crossorigin />
    {preloadImage && <link rel="preload" as="image" imagesrcset={preloadImage.srcset} imagesizes={preloadImage.sizes} fetchpriority="high" />}
  </head>
  <body>
    {intro && <Intro />}
    <a href="#main" class="skip">{L.t('Skip to content', 'انتقل إلى المحتوى')}</a>
    <Header overHero={overHero} />
    <main id="main" tabindex="-1"><slot /></main>
    <Footer />
    <script>import '../scripts/fx.ts';</script>
  </body>
</html>
