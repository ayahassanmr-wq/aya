---
/* Logo intro: the AYA wordmark is drawn in champagne line, fills, HASSAN opens, the descriptor rises, the curtain lifts.
   Performance: the logo SVG is fetched only when the intro actually plays (first visit of a session), the page underneath
   renders immediately (nothing waits for the intro), and it lasts ~1.9 s including the exit. Never with reduced motion, never without JS. */
---
<script is:inline>
  try {
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches && !sessionStorage.getItem('aya-intro')) {
      document.documentElement.classList.add('has-intro');
      sessionStorage.setItem('aya-intro', '1');
    }
  } catch (e) {}
</script>
<div class="intro" aria-hidden="true" data-intro>
  <div class="mark" data-mark><span class="rule"></span></div>
  <button type="button" class="label skip-intro" data-skip tabindex="-1">Skip</button>
</div>

<script>
  const root = document.documentElement;
  const el = document.querySelector<HTMLElement>('[data-intro]');
  if (el && root.classList.contains('has-intro')) {
    let done = false;
    const end = () => { if (done) return; done = true; root.classList.add('intro-out'); setTimeout(() => { root.classList.remove('has-intro', 'intro-out'); el.remove(); }, 600); };
    fetch('/brand/intro-logo.svg').then((r) => r.text()).then((svg) => {
      if (done) return;
      const box = el.querySelector<HTMLElement>('[data-mark]')!;
      box.insertAdjacentHTML('afterbegin', svg);
      const paths = box.querySelectorAll('path');
      paths[0]?.setAttribute('pathLength', '1'); paths[0]?.classList.add('p-aya');
      paths[1]?.classList.add('p-name'); paths[2]?.classList.add('p-desc');
      box.querySelector('svg')?.removeAttribute('width'); box.querySelector('svg')?.removeAttribute('height');
      el.classList.add('go');
      setTimeout(end, 1300);
    }).catch(end);
    setTimeout(end, 2000); // hard cap, even on a slow network
    el.querySelector('[data-skip]')!.addEventListener('click', end);
    addEventListener('keydown', end, { once: true });
    addEventListener('pointerdown', end, { once: true });
  } else el?.remove();
</script>

<style>
  .intro { display: none; }
  :global(.has-intro) .intro { display: grid; place-items: center; position: fixed; inset: 0; z-index: 500; background: var(--night); color: var(--ow); clip-path: inset(0 0 0 0); transition: clip-path .6s var(--ease-io); }
  :global(.intro-out) .intro { clip-path: inset(0 0 100% 0); }
  .mark { position: relative; width: min(62vw, 420px); aspect-ratio: 941 / 625; transition: transform .75s var(--ease-io), opacity .5s; }
  :global(.intro-out) .mark { transform: translateY(-30px); opacity: 0; }
  .mark :global(svg) { width: 100%; height: auto; display: block; overflow: visible; }
  .mark :global(path) { opacity: 0; }
  .go .mark :global(.p-aya) { opacity: 1; fill: transparent; stroke: #D8C7A6; stroke-width: 1.4; stroke-dasharray: 1; stroke-dashoffset: 1; vector-effect: non-scaling-stroke;
    animation: draw .8s var(--ease-io) forwards, fill .4s .6s var(--ease) forwards; }
  @keyframes draw { to { stroke-dashoffset: 0; } }
  @keyframes fill { to { fill: #F3EDE3; stroke: transparent; } }
  .go .mark :global(.p-name) { fill: #F3EDE3; transform-box: fill-box; transform-origin: center; transform: scaleX(.82); animation: open .6s .62s var(--ease) forwards; }
  @keyframes open { to { opacity: 1; transform: none; } }
  .go .mark :global(.p-desc) { fill: #A9A39B; transform-box: fill-box; transform-origin: center; transform: translateY(8px); animation: rise .5s .78s var(--ease) forwards; }
  @keyframes rise { to { opacity: 1; transform: none; } }
  .rule { position: absolute; left: 0; right: 0; bottom: -22px; height: 1px; background: rgba(216, 199, 166, .35); transform: scaleX(0); }
  .go .rule, :global(.go) .rule { animation: grow 1.2s var(--ease-io) forwards; }
  @keyframes grow { to { transform: scaleX(1); } }
  .skip-intro { position: absolute; right: max(var(--gut), env(safe-area-inset-right, 0px)); bottom: calc(18px + env(safe-area-inset-bottom, 0px)); background: none; border: 0; color: var(--muted-dark); padding: 12px; cursor: pointer; }
</style>
