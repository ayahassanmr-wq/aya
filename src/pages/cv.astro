---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { imagesFor, contact } from '../data/projects';
import Social from '../components/Social.astro';
import HireNotes from '../components/HireNotes.astro';
import { i18n } from '../i18n';
const L = i18n(Astro.url);
const { t } = L;
const docs = [
  { id: 'cv', file: '/Aya_Hassan_CV.pdf', t: t('CV', 'السيرة الذاتية'), d: t('Two pages: my roles, studios and the projects I carried at each.', 'صفحتان: أدواري والاستوديوهات التي عملت بها والمشاريع التي حملتها في كلٍّ منها.'), meta: 'PDF · 2 pp' },
  { id: 'selected', file: '/Aya_Hassan_Selected_Works.pdf', t: t('Selected Works', 'أعمال مختارة'), d: t('Eighteen projects with studies, plans and renders, sized for email.', 'ثمانية عشر مشروعًا بالدراسات والمساقط والصور، بحجم مناسب للبريد.'), meta: 'PDF · ~7 MB' },
  { id: 'portfolio', file: '/Aya_Hassan_Portfolio.pdf', t: t('Portfolio, print quality', 'ملف الأعمال بجودة الطباعة'), d: t('The same eighteen projects with full-resolution images, for print.', 'المشاريع الثمانية عشر نفسها بصور كاملة الدقة للطباعة.'), meta: 'PDF · ~29 MB' },
];
---
<Base title={t('CV & portfolio', 'السيرة الذاتية وملف الأعمال')} description={t('Aya Hassan’s CV and portfolio: view them here or download the PDFs.', 'السيرة الذاتية وملف أعمال آية حسن: اعرضهما هنا أو حمّل ملفات PDF.')}>
  <PageHero images={[imagesFor('sabic-hq')[1], imagesFor('misr-italia-hilltop')[0]]} alt="" meta={L.ar ? [['المقر', 'القاهرة، مصر'], ['منذ', '2019 —']] : [['Based', 'Cairo, Egypt'], ['Practice', '2019 —']]}>
    <h1 class="display-xl lines"><span class="ln"><span>{t('CV &', 'السيرة')}</span></span><span class="ln"><span><em>{t('portfolio.', 'وملف الأعمال.')}</em></span></span></h1>
    <p class="lede">{t('My CV and portfolio. View them here or download the PDFs.', 'سيرتي الذاتية وملف أعمالي. اعرضهما هنا أو حمّل ملفات PDF.')}</p>
  </PageHero>

  <HireNotes />

  <section class="wrap docs">
    {docs.map((d, i) => (
      <article class="doc" id={d.id}>
        <div class="dh">
          <span class="dno" dir="ltr">{String(i + 1).padStart(2, '0')}</span>
          <div class="dt"><h2 class="display-m">{d.t}</h2><p>{d.d}</p><span class="label muted">{d.meta}</span></div>
          <div class="da">
            <button type="button" class="btn solid" data-view={d.id} aria-expanded="false">{t('View here', 'اعرض هنا')} <span class="arr">↓</span></button>
            <a href={d.file} class="btn ghost" download>{t('Download', 'تحميل')} <span class="arr">↓</span></a>
            <a href={d.file} class="label link" target="_blank" rel="noopener">{t('Open in new tab ↗', 'افتح في تبويب جديد ↗')}</a>
          </div>
        </div>
        <div class="viewer" data-viewer={d.id} hidden><iframe title={d.t} data-src={`${d.file}#view=FitH`} loading="lazy"></iframe></div>
      </article>
    ))}
  </section>

  <section class="wrap reach">
    <div class="sheet-head"><h2 class="label">{t('Get in touch', 'تواصل معي')}</h2></div>
    <div class="row"><span class="label muted">{t('Email', 'البريد')}</span><a href={`mailto:${contact.email}?subject=${encodeURIComponent(t('Job opportunity', 'فرصة عمل') + ' · ayahassan.com')}`} class="v link">{contact.email.split("@")[0]}<wbr />@{contact.email.split("@")[1]}</a></div>
    <div class="row"><span class="label muted">{t('WhatsApp · LinkedIn · Instagram', 'واتساب · لينكدإن · إنستغرام')}</span><Social size="l" /></div>
  </section>
</Base>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-view]').forEach((b) => b.addEventListener('click', () => {
    const v = document.querySelector<HTMLElement>(`[data-viewer="${b.dataset.view}"]`)!;
    const f = v.querySelector('iframe')!;
    if (!f.src) f.src = f.dataset.src!;
    const open = v.hidden; v.hidden = !open; b.setAttribute('aria-expanded', String(open));
    if (open) v.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }));
</script>

<style>
  .docs { padding-block: clamp(64px, 8vw, 120px); }
  .doc { border-top: 1px solid var(--rule); }
  .doc:last-child { border-bottom: 1px solid var(--rule); }
  .dh { display: grid; grid-template-columns: auto 1fr auto; gap: clamp(20px, 3vw, 48px); align-items: center; padding-block: clamp(28px, 3.4vw, 48px); }
  .dno { font-family: "Archivo Variable", sans-serif; font-weight: 800; font-stretch: 125%; font-size: clamp(44px, 5vw, 80px); line-height: .85; letter-spacing: -.03em; color: var(--ox); }
  .dt p { margin: 8px 0 6px; color: var(--ink-2); }
  .da { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; justify-content: flex-end; }
  .viewer { padding-bottom: clamp(28px, 3vw, 44px); }
  .viewer iframe { width: 100%; height: 85vh; border: 1px solid var(--rule); border-radius: var(--r-2, 10px); background: var(--ow); }
  @media (max-width: 800px) { .dh { grid-template-columns: 1fr; } .da { justify-content: flex-start; } }
  .reach { padding-bottom: clamp(80px, 10vw, 150px); }
  .reach .row { display: grid; grid-template-columns: 220px 1fr; gap: 16px; align-items: center; padding-block: clamp(18px, 2.4vw, 30px); border-top: 1px solid var(--rule); }
  .reach .row:last-child { border-bottom: 1px solid var(--rule); }
  .reach .reply { grid-column: 2; text-transform: none; letter-spacing: .02em; font-size: 13px; margin-top: -8px; }
  .reach .v { font-family: "Archivo Variable", sans-serif; font-weight: 800; font-size: clamp(22px, 3vw, 42px); line-height: 1.1; overflow-wrap: break-word; }
  @media (max-width: 640px) { .reach .row { grid-template-columns: 1fr; } }
</style>
